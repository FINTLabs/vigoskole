fint:administrasjon/personal/fastlonn rdf:type owl:Class ;
    rdfs:label "Fastlønn" ;
    rdfs:comment "Informasjon om fast lønnsbeskjeftigelse.\n\nInneholder beskjeftigelse av den ansattes lønnsprosent.\n\nSummen av prosentene på beskjeftigelsene skal være lønnsprosent for en fullt dekket stilling.\n\nDersom beskjeftigelsene ikke fyller lønnsprosenten har arbeidsforholdet teknisk undertid. \n\nI motsatt fall har arbeidsforholdet overtid.\n\n# Lovlige endringer\n\n## Opprettelse av ny fastlønn\n\n- `periode` angir periode som beskjeftigelsen skal gjelde for.  \n- Periode uten `slutt` betyr at beskjeftigelsen gjelder inntil videre.\n\n## Endring av eksisterende fastlønn\n\n- Kun endring av `slutt` på `periode` er lovlig.\n\n## Sletting av eksisterende fastlønn\n\n- Ikke tillatt." ;
    rdfs:subClassOf fint:administrasjon/personal/lonn ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/fastlonn/prosent ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/fastlonn/prosent ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/fastlonn/lonnsart ;
        owl:allValuesFrom fint:administrasjon/kodeverk/lonnsart
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/fastlonn/lonnsart ;
        owl:onClass fint:administrasjon/kodeverk/lonnsart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/fastlonn/arbeidsforhold ;
        owl:allValuesFrom fint:administrasjon/personal/arbeidsforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/fastlonn/arbeidsforhold ;
        owl:onClass fint:administrasjon/personal/arbeidsforhold ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:administrasjon/personal/fasttillegg rdf:type owl:Class ;
    rdfs:label "Fasttillegg" ;
    rdfs:comment "Faste tillegg til utbetaling.\n\n# Lovlige endringer\n\n## Opprettelse av nytt fasttillegg\n\n- `periode` angir periode som tillegget skal gjelde for.  \n- Periode uten `slutt` betyr at tillegget gjelder inntil videre.\n\n## Endring av eksisterende fasttillegg\n\n- Kun endring av `slutt` på `periode` er lovlig.\n- Setting av `slutt` indikerer når tillegget ikke lenger skal utbetales\n\n## Sletting av eksisterende fasttillegg\n\n- Ikke tillatt." ;
    rdfs:subClassOf fint:administrasjon/personal/lonn ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/fasttillegg/belop ;
        owl:allValuesFrom xsd:long
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/fasttillegg/belop ;
        owl:onDataRange xsd:long ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/fasttillegg/arbeidsforhold ;
        owl:allValuesFrom fint:administrasjon/personal/arbeidsforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/fasttillegg/arbeidsforhold ;
        owl:onClass fint:administrasjon/personal/arbeidsforhold ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/fasttillegg/lonnsart ;
        owl:allValuesFrom fint:administrasjon/kodeverk/lonnsart
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/fasttillegg/lonnsart ;
        owl:onClass fint:administrasjon/kodeverk/lonnsart ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:administrasjon/personal/fravar rdf:type owl:Class ;
    rdfs:label "Fravær" ;
    rdfs:comment "Fravær fra et arbeidsforhold.\n\n# Beskrivelse\n\nRepresenterer fravær fra et gitt arbeidsforhold. Fraværet har en type og en varighet, og kan være helt eller delvis." ;
