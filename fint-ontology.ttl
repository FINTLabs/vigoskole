        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/utdanningsprogram/arstrinn rdf:type owl:Class ;
    rdfs:label "Årstrinn" ;
    rdfs:comment "Hvert år i grunnopplæringen (grunnskole og videregående skole) kalles et årstrinn.\n\n# Eksempler\n\n* Vg1\n* Vg2\n* Vg3\n* Vg4\n\n# Synonym\n\n* Nivå (Rogaland)\n* Klassetrinn\n* Trinn\n\n# Referanser\n\n* http://grepwiki.udir.no/index.php?title=Årstrinn\n* http://psi.udir.no/ontologi/kl06/aarstrinn" ;
    rdfs:subClassOf fint:utdanning/basisklasser/gruppe ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/arstrinn/programomrade ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/programomrade
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/arstrinn/basisgruppe ;
        owl:allValuesFrom fint:utdanning/elev/basisgruppe
    ] .

fint:utdanning/utdanningsprogram/programomrade rdf:type owl:Class ;
    rdfs:label "Programområde" ;
    rdfs:comment "Programområde er et kurs i den videregående skolen. Et programområde strekker seg vanligvis over ett eller flere år og er gjerne en spesialisert retning eller område for fordypning innen utdanningsprogrammet.\n\n# Beskrivelse\n\nInnenfor utdanningsprogrammet studiespesialisering, er eksempler på programområder realfag, språk, samfunnsfag og økonomi og formgivingsfag.\n\nInnenfor utdanningsprogrammet naturbruk, finnes det for eksempel i andre klasse (Vg2) programområdene akvakultur, anleggsgartner og driftsoperatør idrettsanlegg, fiske og fangst, heste- og hovslagerfag, landbruk og gartneri, reindrift og skogbruk.\n\nProgramområdekoder som slutter på  `----` angir at det er standardversjon av programområdet, og ikke en fylkeskommunal variant.\n\n# Eksempler\n\n* Anleggsmaskinførerf,PB\n* Asfaltfaget,PB\n* Banemontørfaget,PB\n* Betongfaget,PB\n* Bioenergi (D)\n* Byggdrifterfaget,PB\n* FDV-utdanning, 1 år (D)\n* Feierfaget,PB\n* Matrosfaget,PB\n* Modellbyggerfaget,PB\n* Motormannfaget,PB\n* Motormekanikerfaget,PB\n* Motorsykkelfaget,PB\n\n# Referanser\n\n* UDir Registreringshåndbok: [regbok.udir.no/35004/3344/35042-1014307.html](http://regbok.udir.no/35004/3344/35042-1014307.html)\n* Wikipedia: https://no.wikipedia.org/wiki/Programområde\n* Grepwiki: http://grepwiki.udir.no/index.php?title=Programområde" ;
    rdfs:subClassOf fint:utdanning/basisklasser/gruppe ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/programomrade/utdanningsprogram ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/utdanningsprogram
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/programomrade/utdanningsprogram ;
        owl:onClass fint:utdanning/utdanningsprogram/utdanningsprogram ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/programomrade/elevforhold ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/programomrade/fag ;
        owl:allValuesFrom fint:utdanning/timeplan/fag
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/programomrade/gruppemedlemskap ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/programomrademedlemskap
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/programomrade/trinn ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/arstrinn
    ] .

fint:utdanning/utdanningsprogram/programomrademedlemskap rdf:type owl:Class ;
    rdfs:label "Programområdemedlemskap" ;
    rdfs:comment "Medlemskap i programområder.\n\n# Beskrivelse\n\nGruppemedlemskap som knytter sammen elevforhold og programområder." ;
    rdfs:subClassOf fint:utdanning/basisklasser/gruppemedlemskap ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/programomrademedlemskap/programomrade ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/programomrade
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/programomrademedlemskap/programomrade ;
        owl:onClass fint:utdanning/utdanningsprogram/programomrade ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/programomrademedlemskap/elevforhold ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/programomrademedlemskap/elevforhold ;
        owl:onClass fint:utdanning/elev/elevforhold ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/utdanningsprogram/skole rdf:type owl:Class ;
    rdfs:label "Skole" ;
    rdfs:comment "Organisasjonsenhet som gjennomfører utdanning.\n\n# Beskrivelse\n\nTypisk er dette en videregående skole, men det kan også være eksamenskontor eller andre skolerelevante enheter.\n\nInneholder utdanningsspesifikk informasjon om en organisasjonsenhet.\n\n# Eksempel\n\n- Videregående skole\n- SMI-skole\n- Fagskole\n- IB-skole\n- Eksamenskontor\n- Opplæringskontor\n- Ressurssenter\n- Fengselsundervisning" ;
    rdfs:subClassOf fint:felles/basisklasser/enhet ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/skole/domenenavn ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/skole/domenenavn ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/skole/juridisknavn ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/skole/juridisknavn ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/skole/navn ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/skole/navn ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/skole/skolenummer ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/skole/skolenummer ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
