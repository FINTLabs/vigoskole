fint:arkiv/noark/dokumentfil rdf:type owl:Class ;
    rdfs:label "Dokumentfil" ;
    rdfs:comment "Dokumentfila inneholder selve dokumentet. Dersom dokumentet er arkivert i flere versjoner, må vi ha et dokumentobjekt og en dokumentfil for hver versjon.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 2.7 \n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentfil/data ;
        owl:allValuesFrom xsd:string
    ] ;
