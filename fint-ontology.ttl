    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/karakterhistorie/opprinneligkarakterverdi ;
        owl:allValuesFrom fint:utdanning/vurdering/karakterverdi
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/karakterhistorie/opprinneligkarakterverdi ;
        owl:onClass fint:utdanning/vurdering/karakterverdi ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/karakterhistorie/opprinneligkarakterstatus ;
        owl:allValuesFrom fint:utdanning/kodeverk/karakterstatus
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/karakterhistorie/opprinneligkarakterstatus ;
        owl:onClass fint:utdanning/kodeverk/karakterstatus ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/karakterhistorie/karakterverdi ;
        owl:allValuesFrom fint:utdanning/vurdering/karakterverdi
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/karakterhistorie/karakterverdi ;
        owl:onClass fint:utdanning/vurdering/karakterverdi ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/karakterhistorie/karakterstatus ;
        owl:allValuesFrom fint:utdanning/kodeverk/karakterstatus
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/karakterhistorie/karakterstatus ;
        owl:onClass fint:utdanning/kodeverk/karakterstatus ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/vurdering/karakterverdi rdf:type owl:Class ;
    rdfs:label "Karakterverdi" ;
    rdfs:comment "Karakterer, målestokk for vurdering av elevers faglige standpunkt, prøve- eller eksamensprestasjoner\n\n# Beskrivelse\n\nDe enkelte karakterer, som til sammen danner en karakterskala, blir betegnet med tall eller andre symboler.\n\nDen relaterte skalaen må refereres fra selve verdi.\n\n# Eksempel\n\n* 6 - Seks\n* IM - Ikke møtt\n* GK - Godkjent\n* R - Realkompetanse\n\n# Referanse\n\n* Vigo Kodeverkdatabase. Karakter: [vigo.no/vigokv/karakter.action](https://www.vigo.no/vigokv/karakter.action)\n* SNL. karakterer: [snl.no/karakterer](https://snl.no/karakterer)" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/karakterverdi/skala ;
        owl:allValuesFrom fint:utdanning/kodeverk/karakterskala
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/karakterverdi/skala ;
        owl:onClass fint:utdanning/kodeverk/karakterskala ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/vurdering/ordensvurdering rdf:type owl:Class ;
    rdfs:label "Ordensvurdering" ;
    rdfs:comment "Vurdering av orden og atferd..\n\n# Beskrivelse\n\nVurderinger av orden og atferd gjøres uten relasjon til noen gruppe, kun til et elevforhold.\n\n# Referanser\n\n* UDir. Registreringshåndbok, Karakterer og andre vurderingsuttrykk: [regbok.udir.no/35004/3344/35042-1021153.html](http://regbok.udir.no/35004/3344/35042-1021153.html)\n* Føring av vitnemål og kompetansebevis for videregående opplæring i Kunnskapsløftet 2017. Karakterer og andre vurderingsuttrykk: [https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/](https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/)\n* Forskrift til opplæringslova &#167; 3-4: [https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4](https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4)" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/ordensvurdering/kommentar ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/ordensvurdering/kommentar ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/ordensvurdering/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/ordensvurdering/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
