        owl:onClass fint:felles/komplekse-datatyper/periode ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/samtykke/opprettet ;
        owl:allValuesFrom xsd:dateTime
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/samtykke/opprettet ;
        owl:onDataRange xsd:dateTime ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/samtykke/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/samtykke/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/samtykke/person ;
        owl:allValuesFrom fint:felles/person
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/samtykke/person ;
        owl:onClass fint:felles/person ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/samtykke/organisasjonselement ;
        owl:allValuesFrom fint:administrasjon/organisasjon/organisasjonselement
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/samtykke/organisasjonselement ;
        owl:onClass fint:administrasjon/organisasjon/organisasjonselement ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/samtykke/behandling ;
        owl:allValuesFrom fint:personvern/samtykke/behandling
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/samtykke/behandling ;
        owl:onClass fint:personvern/samtykke/behandling ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

