    rdfs:domain fint:arkiv/noark/dokumentobjekt ;
    rdfs:range fint:arkiv/noark/arkivressurs .

fint:arkiv/noark/dokumentobjekt/referansedokumentfil rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "referanseDokumentfil" ;
    rdfs:comment "Referanse til filen som inneholder det elektroniske dokumentet som dokumentobjektet beskriver.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M218\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
