        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/skole/fag ;
        owl:allValuesFrom fint:utdanning/timeplan/fag
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/skole/eksamensgruppe ;
        owl:allValuesFrom fint:utdanning/vurdering/eksamensgruppe
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
