fint:utdanning/vurdering/fravar rdf:type owl:Class ;
    rdfs:label "Fravær" ;
    rdfs:comment "Manglende tilstedeværelse i opplæringen.\n\n# Beskrivelse\n\nFravær føres med relasjon til den undervisningen eleven har vært fraværende fra.  Det må derfor være en relasjon til en Undervisningsgruppe.\n\n# Fraværsgrense \n\n* Elever i videregående skole skal møte opp og delta aktivt i opplæringen. \n* Fravær skal registreres, og det foreligger grenser på hvor mye fravær som tillates før rett til å få halvårsvurdering med karakter eller standpunktkarakter i et fag bortfaller. \n* Eleven må legge fram relevant dokumentasjon for å få fravær unntatt fra fraværsgrensen.\n* Fraværsgrensen gjelder timefravær i enkeltfag, ikke elevenes totale fravær.\n* Eleven skal få et varsel om han eller hun står i fare for å ikke få karakter på grunn av fravær.\n\n# Fravær eksamen\nDet føres ikke lenger fravær på eksamen. Dette vil bli satt som karakter. Pga dette utgår relasjonen til eksamensgruppe. Ved en senere hovedoppdatering av Informasjonsmodellen vil multiplisitet for relasjonen  undervisningsgruppe bli satt til 1.\n\n# Referanser\n\n* UDir Registreringshåndbok: http://regbok.udir.no/35004/3344/35042-1018643.html\n* Forskrift til opplæringslova &#167; 3-3, siste ledd: https://lovdata.no/forskrift/2006-06-23-724/&#167;3-3\n* Forskrift til opplæringslova &#167; 3-47: https://lovdata.no/forskrift/2006-06-23-724/&#167;3-47\n* UDir. Føring av vitnemål og kompetansebevis for videregående opplæring i Kunnskapsløftet, pkt 8: https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/8-fravar/\n* SNL. Fravær: https://snl.no/fravær\n* Rundskriv Udir-3-2016: https://www.udir.no/regelverk-og-tilsyn/finn-regelverk/etter-tema/Vitnemal/fravarsgrense---udir-3-2016/\n* UDir. Fravær i videregående skole: https://www.udir.no/regelverk-og-tilsyn/finn-regelverk/etter-tema/Vitnemal/fravar-i-videregaende-skole/" ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fravar/dokumentert ;
        owl:allValuesFrom xsd:boolean
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fravar/dokumentert ;
        owl:onDataRange xsd:boolean ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fravar/forespavitnemal ;
        owl:allValuesFrom xsd:boolean
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fravar/forespavitnemal ;
        owl:onDataRange xsd:boolean ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fravar/gjelderperiode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/periode
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fravar/gjelderperiode ;
        owl:onClass fint:felles/komplekse-datatyper/periode ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fravar/kommentar ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fravar/kommentar ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fravar/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fravar/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fravar/undervisningsgruppe ;
        owl:allValuesFrom fint:utdanning/timeplan/undervisningsgruppe
    ] ;
