    ] .

fint:utdanning/utdanningsprogram/utdanningsprogram rdf:type owl:Class ;
    rdfs:label "Utdanningsprogram" ;
    rdfs:comment "Utdanningsløpene i videregående skole som fører fram til studie- og/eller yrkeskompetanse/fagbrev\n\nSynonym: Utdanningsgruppe\n\n# Eksempler\n\n* Bygg- og anleggsteknikk\n* Design og håndverk\n* Elektrofag\n* Helse- og oppvekstfag\n* Idrettsfag\n* Kunst, design og arkitektur\n* Medier og kommunikasjon\n* Musikk, dans og drama\n* Naturbruk\n* Restaurant- og matfag\n* Service og samferdsel\n* Studiespesialisering\n* Teknikk og ind. produksjon\n\n# Referanser\n\n*  Fag- og timefordeling og tilbudsstruktur for Kunnskapsløftet Udir-1-2017 : https://www.udir.no/regelverk-og-tilsyn/finn-regelverk/etter-tema/Innhold-i-opplaringen/udir-01-2017/\n* UDir Registreringshåndbok: http://regbok.udir.no/35004/3344/35042-1018606.html\n* Grepwiki: http://grepwiki.udir.no/index.php?title=Utdanningsprogram" ;
    rdfs:subClassOf fint:utdanning/basisklasser/gruppe ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/utdanningsprogram/skole ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/skole
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/utdanningsprogram/programomrade ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/programomrade
    ] .

fint:utdanning/vurdering/anmerkninger rdf:type owl:Class ;
    rdfs:label "Anmerkninger" ;
    rdfs:comment "Aanmerkninger for en elev for et elevforhold." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/anmerkninger/atferd ;
        owl:allValuesFrom xsd:int
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/anmerkninger/atferd ;
        owl:onDataRange xsd:int ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/anmerkninger/orden ;
        owl:allValuesFrom xsd:int
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/anmerkninger/orden ;
        owl:onDataRange xsd:int ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
