        owl:allValuesFrom fint:utdanning/timeplan/fag
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/undervisningsgruppe/fag ;
        owl:onClass fint:utdanning/timeplan/fag ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/undervisningsgruppe/elevforhold ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/undervisningsgruppe/undervisningsforhold ;
        owl:allValuesFrom fint:utdanning/elev/undervisningsforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/undervisningsgruppe/time ;
        owl:allValuesFrom fint:utdanning/timeplan/time
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/undervisningsgruppe/gruppemedlemskap ;
        owl:allValuesFrom fint:utdanning/timeplan/undervisningsgruppemedlemskap
    ] .

fint:utdanning/timeplan/undervisningsgruppemedlemskap rdf:type owl:Class ;
    rdfs:label "Undervisningsgruppemedlemskap" ;
    rdfs:comment "Medlemskap i undervisningsgrupper.\n\n# Beskrivelse\n\nGruppemedlemskap som knytter sammen elevforhold og undervisningsgrupper." ;
