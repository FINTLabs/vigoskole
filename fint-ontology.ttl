fint:personvern/kodeverk/behandlingsgrunnlag rdf:type owl:Class ;
    rdfs:label "Behandlingsgrunnlag" ;
    rdfs:comment "Rettslig grunnlag for behandling av personopplysninger.\n\n# Beskrivelse\n\nAll behandling av personopplysninger må ha et rettslig grunnlag for å være lov. Det må finnes et behandlingsgrunnlag for behandling av hver enkelt personopplysning til hvert enkelt formål.\n\nVirksomheten har også plikt til å informere den enkelte om hvilket grunnlag  personopplysningene deres behandles på. \n\n# Eksempler\n\n* Samtykke\n* Nødvendig for å oppfylle en avtale\n* Nødvendig for å oppfylle en rettslig plikt\n* Nødvendig for å beskytte vitale interesser\n* Nødvendig for å utføre en oppgave i offentlig interesse eller utøve offentlig myndighet\n* Nødvendig for å ivareta legitime interesser - interesseavveiing" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:personvern/kodeverk/personopplysning rdf:type owl:Class ;
    rdfs:label "Personopplysning" ;
    rdfs:comment "Opplysninger og vurderinger som kan knyttes til enkeltpersoner.\n\n# Beskrivelse\n\nTypiske personopplysninger er navn, adresse, telefonnummer, e-post og fødselsnummer. Et bilde regnes som en personopplysning dersom personer kan gjenkjennes. \n\n# Referanser\n\nPersonvernforordningen artikkel 4" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:personvern/samtykke/behandling rdf:type owl:Class ;
    rdfs:label "Behandling" ;
    rdfs:comment "All bruk av personopplysninger\n\n# Beskrivelse\n\nAll bruk av personopplysninger, slik som innsamling, registrering, sammenstilling, lagring og utlevering, eller en kombinasjon av slike bruksmåter.\n\nPersonopplysninger skal bare brukes for spesifikke, uttrykkelige, angitte og legitime formål. Virksomheten har plikt til å gi den enkelte informasjon om formålet med behandling av personopplysning samt behandlingsgrunnlaget." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/behandling/aktiv ;
        owl:allValuesFrom xsd:boolean
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/behandling/aktiv ;
        owl:onDataRange xsd:boolean ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/behandling/formal ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/behandling/formal ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/behandling/slettet ;
        owl:allValuesFrom xsd:dateTime
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/behandling/slettet ;
        owl:onDataRange xsd:dateTime ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/behandling/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/behandling/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/behandling/behandlingsgrunnlag ;
        owl:allValuesFrom fint:personvern/kodeverk/behandlingsgrunnlag
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/behandling/behandlingsgrunnlag ;
        owl:onClass fint:personvern/kodeverk/behandlingsgrunnlag ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/behandling/personopplysning ;
        owl:allValuesFrom fint:personvern/kodeverk/personopplysning
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/behandling/personopplysning ;
        owl:onClass fint:personvern/kodeverk/personopplysning ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/behandling/samtykke ;
        owl:allValuesFrom fint:personvern/samtykke/samtykke
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/behandling/tjeneste ;
        owl:allValuesFrom fint:personvern/samtykke/tjeneste
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/behandling/tjeneste ;
        owl:onClass fint:personvern/samtykke/tjeneste ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:personvern/samtykke/samtykke rdf:type owl:Class ;
    rdfs:label "Samtykke" ;
    rdfs:comment "Tillatelse til behandling av personopplysning.\n\n# Beskrivelse\n\nEn virksomhet kan behandle personopplysninger dersom den har innhentet gyldig samtykke fra personen eller personene det gjelder." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:personvern/samtykke/samtykke/gyldighetsperiode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/periode
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
