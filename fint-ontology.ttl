    rdfs:comment "Anmerkningene i elevforholdet." ;
    rdfs:domain fint:utdanning/elev/elevforhold ;
    rdfs:range fint:utdanning/vurdering/anmerkninger .

fint:utdanning/elev/elevforhold/avbruddsarsak rdf:type owl:ObjectProperty ;
    rdfs:label "avbruddsårsak" ;
