        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/skole/skoleeiertype ;
        owl:allValuesFrom fint:utdanning/kodeverk/skoleeiertype
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/skole/skoleeiertype ;
        owl:onClass fint:utdanning/kodeverk/skoleeiertype ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/skole/organisasjon ;
        owl:allValuesFrom fint:administrasjon/organisasjon/organisasjonselement
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/utdanningsprogram/skole/organisasjon ;
        owl:onClass fint:administrasjon/organisasjon/organisasjonselement ;
