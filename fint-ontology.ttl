fint:administrasjon/personal/lonn rdf:type owl:Class ;
    rdfs:label "Lønn" ;
    rdfs:comment "Informasjon om lønn for et arbeidsforhold.\n\n# Beskrivelse\n\nLønn inneholder informasjon om lønn som skal utbetales for et arbeidsforhold.  Lønn er enten Fastlønn, Fasttillegg  eller Variabellønn.\n\nLønn blir kontert, attestert og anvist av personalressurser som har fullmakter til dette.\n\nLønn utbetales til et arbeidsforhold, for en gitt periode." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/lonn/anvist ;
        owl:allValuesFrom xsd:dateTime
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/lonn/anvist ;
        owl:onDataRange xsd:dateTime ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/lonn/attestert ;
        owl:allValuesFrom xsd:dateTime
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/lonn/attestert ;
        owl:onDataRange xsd:dateTime ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/lonn/beskrivelse ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/lonn/beskrivelse ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/lonn/kildesystemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/lonn/kildesystemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
