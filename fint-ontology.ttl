    ] .

fint:okonomi/faktura/fakturautsteder rdf:type owl:Class ;
    rdfs:label "Fakturautsteder" ;
    rdfs:comment "Enhet som utformer og oversender faktura og mottar betaling.\n\n# Beskrivelse\n\nEnhet som etter Regnskapsloven er pliktig å arkivere dokumentasjon for faktura." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:okonomi/faktura/fakturautsteder/navn ;
