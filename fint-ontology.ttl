    rdfs:domain fint:arkiv/noark/klasse ;
    rdfs:range fint:arkiv/noark/klassifikasjonssystem .

fint:arkiv/noark/klasse/rekkefolge rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "rekkefølge" ;
    rdfs:comment "Rekkefølge for klassifiseringer\n\n# Beskrivelse\n\nAngir i hvilken rekkefølge klassifiseringene skal brukes til å sortere / ordne lister m.m." ;
    rdfs:domain fint:arkiv/noark/klasse ;
    rdfs:range xsd:int .

fint:arkiv/noark/klasse/skjerming rdf:type owl:ObjectProperty ;
