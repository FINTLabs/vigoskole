    rdfs:domain fint:arkiv/noark/dokumentbeskrivelse ;
    rdfs:range xsd:string .

fint:arkiv/noark/dokumentbeskrivelse/skjerming rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "skjerming" ;
    rdfs:comment "Skjerming av dokument.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 2.8.1\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
