fint:okonomi/kodeverk/vare rdf:type owl:Class ;
    rdfs:label "Vare" ;
    rdfs:comment "Vare eller tjeneste som kan leveres og faktureres.\n\n# Beskrivelse\n\nVarer leveres i en mengde beskrevet i en enhet, til en nettopris per enhet.  Til hver vare er det tilknyttet en kode som angir sats for merverdiavgift.\n\nKonteringen som varen har i økonomisystemet kan også angis." ;
    rdfs:subClassOf fint:felles/basisklasser/begrep ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:okonomi/kodeverk/vare/enhet ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:okonomi/kodeverk/vare/enhet ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:okonomi/kodeverk/vare/kontering ;
        owl:allValuesFrom fint:administrasjon/komplekse-datatyper/kontostreng
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:okonomi/kodeverk/vare/kontering ;
        owl:onClass fint:administrasjon/komplekse-datatyper/kontostreng ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:okonomi/kodeverk/vare/pris ;
        owl:allValuesFrom xsd:long
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:okonomi/kodeverk/vare/pris ;
        owl:onDataRange xsd:long ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:okonomi/kodeverk/vare/fakturautsteder ;
        owl:allValuesFrom fint:okonomi/faktura/fakturautsteder
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:okonomi/kodeverk/vare/fakturautsteder ;
        owl:onClass fint:okonomi/faktura/fakturautsteder ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
