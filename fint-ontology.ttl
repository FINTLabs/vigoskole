    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/time/undervisningsgruppe ;
        owl:allValuesFrom fint:utdanning/timeplan/undervisningsgruppe
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/time/undervisningsgruppe ;
        owl:onClass fint:utdanning/timeplan/undervisningsgruppe ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
