fint:arkiv/noark/journalpost rdf:type owl:Class ;
    rdfs:label "Journalpost" ;
    rdfs:comment "En journalpost representer en \"innføring i journalen\". Journalen er en kronologisk fortegnelse over inn- og utgående dokumenter (dvs. korrespondansedokumenter) brukt i saksbehandlingen, og eventuelt også interne dokumenter.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 2.6 \n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf fint:arkiv/noark/registrering ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/journalpost/antallvedlegg ;
        owl:allValuesFrom xsd:long
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/journalpost/antallvedlegg ;
        owl:onDataRange xsd:long ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/journalpost/avskrivning ;
        owl:allValuesFrom fint:arkiv/noark/avskrivning
    ] ;
