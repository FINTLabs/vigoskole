    rdfs:comment "Personalressurs som er arbeidstakers leder." ;
    rdfs:domain fint:arkiv/personal/personalmappe ;
    rdfs:range fint:administrasjon/personal/personalressurs .

fint:arkiv/personal/personalmappe/navn rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "navn" ;
    rdfs:comment "Navn på arbeidstaker personalmappe gjelder for." ;
    rdfs:domain fint:arkiv/personal/personalmappe ;
    rdfs:range fint:felles/komplekse-datatyper/personnavn .

fint:arkiv/personal/personalmappe/person rdf:type owl:ObjectProperty ;
