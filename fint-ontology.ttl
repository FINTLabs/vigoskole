    rdfs:label "filstorrelse" ;
    rdfs:comment "Størrelsen på fila i antall bytes oppgitt med desimaltall.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M707\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/dokumentobjekt ;
    rdfs:range xsd:string .

fint:arkiv/noark/dokumentobjekt/format rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "format" ;
    rdfs:comment "Dokumentets format.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M701\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/dokumentobjekt ;
    rdfs:range xsd:string .

fint:arkiv/noark/dokumentobjekt/formatdetaljer rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "formatDetaljer" ;
    rdfs:comment "Nærmere spesifikasjon av dokuments format, f.eks. informasjon om komprimering.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M702\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
