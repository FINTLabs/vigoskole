    rdfs:range fint:utdanning/elev/skoleressurs ;
    owl:inverseOf fint:utdanning/elev/skoleressurs/skole .

fint:utdanning/utdanningsprogram/skole/systemid rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "systemId" ;
    rdfs:comment "Unik intern system-id for utdanningsorganisasjonen\n\n# Beskrivelse\n\nSystemspesifikk id, som normalt ikke er synlig i fagsystemet." ;
    rdfs:domain fint:utdanning/utdanningsprogram/skole ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

