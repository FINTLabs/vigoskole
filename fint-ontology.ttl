fint:felles/basisklasser/aktor rdf:type owl:Class ;
    rdfs:label "Aktør" ;
    rdfs:comment "Person eller enhet vi samhandler med.\n\n# Beskrivelse\n\nAbstrakt klasse som inneholder relasjon til kontaktinformasjon og identifikator. Må enten brukes som Person, Enhet, eller annen underliggende klasse, som feks organisasjonselement." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/aktor/kontaktinformasjon ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/kontaktinformasjon
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/aktor/kontaktinformasjon ;
        owl:onClass fint:felles/komplekse-datatyper/kontaktinformasjon ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/aktor/postadresse ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/adresse
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/aktor/postadresse ;
        owl:onClass fint:felles/komplekse-datatyper/adresse ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:felles/basisklasser/begrep rdf:type owl:Class ;
    rdfs:label "Begrep" ;
    rdfs:comment "Overordnet beskrivelse av et element i et kodeverk\n\n# Beskrivelse\n\n* Overordnet element har ingen forelder\nSjekker ved innhenting av data:\n* Det skal være bare 1 overordnet element i hver kodeverk\n* Det er ingen sykluser definert med forelder forholdet\n\n# Eksempel" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/begrep/gyldighetsperiode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/periode
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/begrep/gyldighetsperiode ;
        owl:onClass fint:felles/komplekse-datatyper/periode ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/begrep/kode ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/begrep/kode ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/begrep/navn ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/begrep/navn ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/begrep/passiv ;
        owl:allValuesFrom xsd:boolean
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/begrep/passiv ;
        owl:onDataRange xsd:boolean ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/begrep/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/begrep/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:felles/basisklasser/enhet rdf:type owl:Class ;
    rdfs:label "Enhet" ;
    rdfs:comment "Alle hovedenheter, underenheter og organisasjonsledd som er identifisert med et organisasjonsnummer\n\n# Beskrivelse\n\nLøs relasjon til BRREG." ;
    rdfs:subClassOf fint:felles/basisklasser/aktor ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/enhet/forretningsadresse ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/adresse
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/enhet/forretningsadresse ;
        owl:onClass fint:felles/komplekse-datatyper/adresse ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/enhet/organisasjonsnavn ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/enhet/organisasjonsnavn ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/enhet/organisasjonsnummer ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/basisklasser/enhet/organisasjonsnummer ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:felles/kodeverk/fylke rdf:type owl:Class ;
    rdfs:label "Fylke" ;
    rdfs:comment "Liste over Norges fylker\n\n# Referanser\n\n* \"SSB: Standard for fylkesinndeling\":http://www.ssb.no/klass/#!/klassifikasjoner/104\n* \"data.norge.no\":\nhttp://data.norge.no/data/statistisk-sentralbyr%C3%A5/fylkesinndeling" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kodeverk/fylke/kommune ;
        owl:allValuesFrom fint:felles/kodeverk/kommune
    ] .

fint:felles/kodeverk/iso/kjonn rdf:type owl:Class ;
    rdfs:label "Kjønn" ;
    rdfs:comment "Liste over verdier for kjønn basert på ISO/IEC 5218.\n\n# Beskrivelse\n\nListe over verdier for kjønn basert på ISO/IEC 5218.\n\nNår vi i daglig tale prater om kjønn presiserer vi sjelden hva vi mener. Avhengig av sammenheng kan vi mene enten biologisk, sosialt, mentalt eller juridisk kjønn. Kjønn kan med andre ord betraktes som et samlebegrep.\nKilde: llh.no  \n\n# Referanser\n\n* [FINT API for ISO/IEC 5218](https://api.felleskomponent.no/felles/kodeverk/kjonn)\n* [ISO/IEC 5218:2004](https://iso.org/standard/36266.html)\n* [Wikipedia artikkel](https://en.wikipedia.org/wiki/ISO/IEC_5218)\n\n# Eksempler\n\n    0 = uvisst (not known)\n    1 = mann (male)\n    2 = kvinne (female)\n    9 = gjelder ikke (not applicable)" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:felles/kodeverk/iso/landkode rdf:type owl:Class ;
    rdfs:label "Landkode" ;
    rdfs:comment "Landskode i ISO 3166-1 alpha-2 format.\n\n# Beskrivelse\n\nLandskode i ISO 3166-1 alpha-2 format.\n\n# Referanser\n\n* [FINT api for ISO 3166-1 alpha-2](https://api.felleskomponent.no/felles/kodeverk/iso/31661alpha2/)\n* \"ISO standards page\":http://www.iso.org/iso/country_codes.htm\n* Søk i kodeliste: \"https://www.iso.org/obp/ui/#search\":https://www.iso.org/obp/ui/#search\n* \"XML data\":http://www.iso.org/iso/home/standards/country_codes/country_names_and_code_elements_xml-temp.htm\n* \"Wiki side\":https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2\n* \"SSB datasett\":http://data.norge.no/data/statistisk-sentralbyr%C3%A5/land-og-landkoder" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:felles/kodeverk/iso/sprak rdf:type owl:Class ;
    rdfs:label "Språk" ;
    rdfs:comment "Liste over verdier for språk  (2 bokstav)\n\n# Beskrivelse\n\nListe over alle språk etter ISO 639-1 standard (2 bokstav)\n\n# Eksempler\n\nNO, NB, NN, DA, etc.\n\n# Referanse \n\n[FINT api for ISO 639-1 Alpha2](https://api.felleskomponent.no/felles/kodeverk/iso/6391alpha2)" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:felles/kodeverk/kommune rdf:type owl:Class ;
    rdfs:label "Kommune" ;
    rdfs:comment "Liste over Norges kommuner\n\nKilde:\n\n* \"SSB. Kommuneinndeling 2017\":http://www.ssb.no/klass/#!/klassifikasjoner/131\n* \"data.norge.no om kommuneinndeling\":http://data.norge.no/data/statistisk-sentralbyr%C3%A5/kommuneinndeling" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kodeverk/kommune/fylke ;
        owl:allValuesFrom fint:felles/kodeverk/fylke
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kodeverk/kommune/fylke ;
        owl:onClass fint:felles/kodeverk/fylke ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:felles/kodeverk/valuta rdf:type owl:Class ;
    rdfs:label "Valuta" ;
    rdfs:comment "Valutakodene for offisielle valutaer.\n\n# Referanse\nI henhold til [ISO 4217](https://no.wikipedia.org/wiki/ISO_4217)" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kodeverk/valuta/bokstavkode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kodeverk/valuta/bokstavkode ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kodeverk/valuta/navn ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kodeverk/valuta/navn ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kodeverk/valuta/nummerkode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kodeverk/valuta/nummerkode ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:felles/komplekse-datatyper/adresse rdf:type owl:Class ;
    rdfs:label "Adresse" ;
    rdfs:comment "Fysisk adresse eller postadresse.\n\n# Beskrivelse\n\nDette kan enten være en postadresse eller en fysisk adresse som det er mulig å besøke.\n\n# Eksempel\n\n|               adresse               |    poststed    | postnummer | land |\n|-------------------------------------|----------------|------------|------|\n| Nydalen allé 11                     | Oslo           |       0484 | NO   |\n| Fakturamottak&lt;br&gt;Postboks 501 Lund  | Kristiansand   |       4605 | -    |\n| Postboks 517 Lundsiden              | KRISTIANSAND S |       4605 | -    |\n\n\n# Referanser\n\n- http://www.bring.no/radgivning/sende-noe/klargjoring/klargjoring-adressert/adressering-til-postmottakere-i-norge\n- http://www.bring.no/radgivning/sende-noe/klargjoring/klargjoring-adressert/adressering-til-mottakere-i-utlandet" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/adresse/adresselinje ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/adresse/postnummer ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/adresse/postnummer ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/adresse/poststed ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/adresse/poststed ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/adresse/land ;
        owl:allValuesFrom fint:felles/kodeverk/iso/landkode
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/adresse/land ;
        owl:onClass fint:felles/kodeverk/iso/landkode ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:felles/komplekse-datatyper/identifikator rdf:type owl:Class ;
    rdfs:label "Identifikator" ;
    rdfs:comment "Unik identifikasjon til et objekt.\n\n# Beskrivelse\n\nEn kombinasjon av tegn eller og/eller bokstaver som unikt identifiserer et objekt blant andre objekter av samme type uten arv.\n\nIdentifikatorer må være stabile over tid, og henvise til samme objekt.\n\nDersom identifikatorer konstrueres av sammensatte verdier må særskilt hensyn tas for å sikre at identifikatorverdien ikke endres over tid.\n\n# Eksempel\n\nKan for eksempel brukes til å identifisere en person ut fra fødselsnummer eller ansattnummer.\n\n* For en person kan det være fødselsnummer\n* For er personresurs kan det være ansattnummer eller signatur\n* For er elev kan det være elevnummer.\n* For organisasjonselement kan det være organisasjonsnummer fra Enhetsregistret.\n* systemId kan være objektID eller rowID i underliggende database, dersom denne er stabil over tid." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/identifikator/gyldighetsperiode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/periode
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/identifikator/gyldighetsperiode ;
        owl:onClass fint:felles/komplekse-datatyper/periode ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/identifikator/identifikatorverdi ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/identifikator/identifikatorverdi ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:felles/komplekse-datatyper/kontaktinformasjon rdf:type owl:Class ;
    rdfs:label "Kontaktinformasjon" ;
    rdfs:comment "Informasjon som kan brukes for oppnå kontakt.\n\n# Beskrivelse\n\nGenerell kontaktinformasjon, inneholder opplysninger om telefon, e-post, osv.\n\nEn ikke-fysisk adresse, i motsetning til [Adresse](/docs/komplekse_datatyper_adresse) ." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/kontaktinformasjon/epostadresse ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/kontaktinformasjon/epostadresse ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/kontaktinformasjon/mobiltelefonnummer ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/kontaktinformasjon/mobiltelefonnummer ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/kontaktinformasjon/nettsted ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/kontaktinformasjon/nettsted ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/kontaktinformasjon/sip ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/kontaktinformasjon/sip ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/kontaktinformasjon/telefonnummer ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/kontaktinformasjon/telefonnummer ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:felles/komplekse-datatyper/matrikkelnummer rdf:type owl:Class ;
    rdfs:label "Matrikkelnummer" ;
    rdfs:comment "Entydig identifisering av metrikkelenhet innen kommune, definert i matrikkelforskriften § 7." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/matrikkelnummer/adresse ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/adresse
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/matrikkelnummer/adresse ;
        owl:onClass fint:felles/komplekse-datatyper/adresse ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/matrikkelnummer/bruksnummer ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/matrikkelnummer/bruksnummer ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/matrikkelnummer/festenummer ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/matrikkelnummer/festenummer ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/matrikkelnummer/gardsnummer ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/matrikkelnummer/gardsnummer ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/matrikkelnummer/seksjonsnummer ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/matrikkelnummer/seksjonsnummer ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/matrikkelnummer/kommunenummer ;
        owl:allValuesFrom fint:felles/kodeverk/kommune
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/matrikkelnummer/kommunenummer ;
        owl:onClass fint:felles/kodeverk/kommune ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:felles/komplekse-datatyper/periode rdf:type owl:Class ;
    rdfs:label "Periode" ;
    rdfs:comment "Tidsperiode (start- og sluttdato).\n\n# Beskrivelse\n\nTidsperiode (start- og slutttidspunkt). \nSlutttidspunkt må være senere eller lik starttidspunktet om det er definert.\nBåde start og slutt kan brukes som dato eller datotid." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/periode/beskrivelse ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/periode/beskrivelse ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/periode/slutt ;
        owl:allValuesFrom xsd:dateTime
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/periode/slutt ;
        owl:onDataRange xsd:dateTime ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/periode/start ;
        owl:allValuesFrom xsd:dateTime
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/periode/start ;
        owl:onDataRange xsd:dateTime ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:felles/komplekse-datatyper/personnavn rdf:type owl:Class ;
    rdfs:label "Personnavn" ;
    rdfs:comment "Angir navn til en person\n\n# Beskrivelse\n\nInneholder fornavn og etternavn for å beskrive navn til en person.\n\nFornavn, mellomnavn og etternavn skal leveres fra fagsystemene som de er, uten noe endringer.\n\n# Referanse\n\n* [Navneloven](https://lovdata.no/dokument/NL/lov/2002-06-07-19/)\n* [Håndbok i folkeregistrering](http://www.skatteetaten.no/no/Radgiver/Rettskilder/Handboker/Handbok-i-folkeregistrering/)\n* [Skal du ha to etternavn?](http://www.skatteetaten.no/no/Person/Folkeregister/Endre-navn/Skal-du-ha-to-etternavn/)\n\n# Eksempler\n\n|            Navn           |       Fornavn       | Mellomnavn | Etternavn   |\n|---------------------------|---------------------|------------|--------------|\n| Ole Olsen                 | Ole                 | -          | Olsen        |\n| Lise Sofie Fuglevik Olsen | Lise Sofie          | Fuglevik   | Olsen        |\n| Lise Sofie Fuglevik Olsen | Lise Sofie Fuglevik | -          | Olsen        |\n| Anne Kari Nilsen-Olsen    | Anne Kari           | -          | Nilsen-Olsen |" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/personnavn/etternavn ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/personnavn/etternavn ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/personnavn/fornavn ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/personnavn/fornavn ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/personnavn/mellomnavn ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/komplekse-datatyper/personnavn/mellomnavn ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:felles/kontaktperson rdf:type owl:Class ;
    rdfs:label "Kontaktperson" ;
    rdfs:comment "Kontaktperson til en person.\n\n# Beskrivelse\n\nKontaktperson er personer som kan kontaktes dersom det er behov for det.\n\nKontaktperson kalles også pårørende." ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kontaktperson/foreldreansvar ;
        owl:allValuesFrom xsd:boolean
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kontaktperson/foreldreansvar ;
        owl:onDataRange xsd:boolean ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kontaktperson/kontaktinformasjon ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/kontaktinformasjon
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kontaktperson/kontaktinformasjon ;
        owl:onClass fint:felles/komplekse-datatyper/kontaktinformasjon ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kontaktperson/navn ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/personnavn
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kontaktperson/navn ;
        owl:onClass fint:felles/komplekse-datatyper/personnavn ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kontaktperson/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kontaktperson/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kontaktperson/type ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kontaktperson/type ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kontaktperson/kontaktperson ;
        owl:allValuesFrom fint:felles/person
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kontaktperson/person ;
        owl:allValuesFrom fint:felles/person
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/kontaktperson/person ;
        owl:onClass fint:felles/person ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:felles/person rdf:type owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "Fysiske private personer\n\n# Beskrivelse\n\nFysiske personer. Arver felter fra [Aktør](Class:Aktør).\n\n# Eksempler\n\n## Riktig\n\n* Karl August Haraldsen\n\n## Feil\n\n* Statsminister\n\n# Referanse\n\n* [Wiki side](https://no.wikipedia.org/wiki/Fysisk_person)" ;
    rdfs:subClassOf fint:felles/basisklasser/aktor ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/person/bilde ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/person/bilde ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/person/bostedsadresse ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/adresse
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/person/bostedsadresse ;
        owl:onClass fint:felles/komplekse-datatyper/adresse ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/person/fodselsdato ;
        owl:allValuesFrom xsd:date
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/person/fodselsdato ;
        owl:onDataRange xsd:date ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:felles/person/fodselsnummer ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
