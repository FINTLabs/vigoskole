        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/autorisasjon/tilgangsrestriksjon ;
        owl:allValuesFrom fint:arkiv/kodeverk/tilgangsrestriksjon
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/autorisasjon/tilgangsrestriksjon ;
        owl:onClass fint:arkiv/kodeverk/tilgangsrestriksjon ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/autorisasjon/administrativenhet ;
        owl:allValuesFrom fint:arkiv/noark/administrativenhet
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/autorisasjon/arkivressurs ;
        owl:allValuesFrom fint:arkiv/noark/arkivressurs
    ] .

fint:arkiv/noark/avskrivning rdf:type owl:Class ;
    rdfs:label "Avskrivning" ;
    rdfs:comment "En Journalpost av typen ”inngående dokument” eller ”organinternt dokument for oppfølging” står i restanse inntil de er markert som ferdigbehandlet, eller avskrives. Det følger av arkivforskriften &#167; 10 at avskrivningsmåte skal fremgå av journalen.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard, kapittel 3.4 Avskrivning og saksoppfølging  \n\n# Referanser \n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/avskrivning/avskrevetav ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/avskrivning/avskrevetav ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/avskrivning/avskrivningsdato ;
        owl:allValuesFrom xsd:dateTime
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/avskrivning/avskrivningsdato ;
        owl:onDataRange xsd:dateTime ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/avskrivning/avskrivningsmate ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/avskrivning/avskrivningsmate ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:arkiv/noark/dokumentbeskrivelse rdf:type owl:Class ;
    rdfs:label "Dokumentbeskrivelse" ;
    rdfs:comment "Den vanligste bruken av <i>dokumentbeskrivelse </i>er for å skille mellom hoveddokument og vedlegg, hvor hoveddokumentet og hvert av vedleggene utgjør hvert sitt enkeltdokument.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 2.7 \n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/beskrivelse ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/beskrivelse ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/dokumentnummer ;
        owl:allValuesFrom xsd:long
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/dokumentnummer ;
        owl:onDataRange xsd:long ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/dokumentobjekt ;
        owl:allValuesFrom fint:arkiv/noark/dokumentobjekt
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/forfatter ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/opprettetdato ;
        owl:allValuesFrom xsd:dateTime
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/opprettetdato ;
        owl:onDataRange xsd:dateTime ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/part ;
        owl:allValuesFrom fint:arkiv/noark/part
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/referansearkivdel ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
