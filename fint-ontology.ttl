        owl:allValuesFrom fint:utdanning/kodeverk/fagstatus
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/faggruppemedlemskap/fagstatus ;
        owl:onClass fint:utdanning/kodeverk/fagstatus ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/faggruppemedlemskap/varsel ;
        owl:allValuesFrom fint:utdanning/elev/varsel
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/faggruppemedlemskap/faggruppe ;
        owl:allValuesFrom fint:utdanning/timeplan/faggruppe
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/faggruppemedlemskap/faggruppe ;
        owl:onClass fint:utdanning/timeplan/faggruppe ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/timeplan/rom rdf:type owl:Class ;
    rdfs:label "Rom" ;
    rdfs:comment "Rom hvor timene gjennomføres." ;
    rdfs:subClassOf [ a owl:Restriction ;
