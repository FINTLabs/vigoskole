fint:administrasjon/kodeverk/fravarstype/overfores rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "overføres" ;
    rdfs:comment "Angir om fravær av denne typen skal overføres til HR.\n\n# Beskrivelse\n\nEnkelte typer fravær indikerer fravær fra ordinære arbeidsoppgaver som utløser behov for vikar, men ikke fravær fra arbeidsforholdet.\n\nDisse skal ikke registreres i HR-systemet, men må likevel registreres i systemer som håndterer vikarer.\n\nDersom feltet mangler, skal dette tolkes som at typen skal overføres.\n\n# Eksempel\n\n- Kurs\n- Møter" ;
    rdfs:domain fint:administrasjon/kodeverk/fravarstype ;
    rdfs:range xsd:boolean .

