@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix fint: <https://novari.no/ontology/fint#> .

fint:ontology a owl:Ontology ;
    rdfs:label "FINT Ontology" ;
    rdfs:comment "OWL ontology generated from the FINT Enterprise Architect information model." .

fint:administrasjon/fullmakt/fullmakt rdf:type owl:Class ;
    rdfs:label "Fullmakt" ;
    rdfs:comment "Fullmakt til å gjøre handlinger i forhold til en gitt Rolle.\n\n# Beskrivelse\n\nFullmakter innehas av fysiske eller juridiske personer, og er knyttet til kontodimensjon eller organisasjonselement. Fullmakter er delegert til personer, disse benevnes som fullmektige.\n\nFullmektige kan ha stedfortreder. Stedfortrederen kan utøve den samme fullmakten som den fullmektige.\n\nFullmakter beskrives i delegasjonsreglementet for organisasjonen. For fylkeskommuner er dette et reglement besluttet av Fylkestinget og videre delegert av Fylkesrådmannen.\n\nDersom fullmakt har relasjon til mer enn en kontodimensjon (og organisasjonselement) er det å regne som en kombinasjonsfullmakt. \n\n# Eksempler\n\nRektor ved Eidsvoll VGS har anvisningsfullmakt for ansvar 241." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/gyldighetsperiode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/periode
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/gyldighetsperiode ;
        owl:onClass fint:felles/komplekse-datatyper/periode ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/myndighet ;
        owl:allValuesFrom fint:administrasjon/kodeverk/kontodimensjon
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/ramme ;
        owl:allValuesFrom fint:administrasjon/kodeverk/ramme
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/ramme ;
        owl:onClass fint:administrasjon/kodeverk/ramme ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/funksjon ;
        owl:allValuesFrom fint:administrasjon/kodeverk/funksjon
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/funksjon ;
        owl:onClass fint:administrasjon/kodeverk/funksjon ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/objekt ;
        owl:allValuesFrom fint:administrasjon/kodeverk/objekt
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/objekt ;
        owl:onClass fint:administrasjon/kodeverk/objekt ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/organisasjonselement ;
        owl:allValuesFrom fint:administrasjon/organisasjon/organisasjonselement
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/organisasjonselement ;
        owl:onClass fint:administrasjon/organisasjon/organisasjonselement ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/art ;
        owl:allValuesFrom fint:administrasjon/kodeverk/art
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/art ;
        owl:onClass fint:administrasjon/kodeverk/art ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/anlegg ;
        owl:allValuesFrom fint:administrasjon/kodeverk/anlegg
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/anlegg ;
        owl:onClass fint:administrasjon/kodeverk/anlegg ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/diverse ;
        owl:allValuesFrom fint:administrasjon/kodeverk/diverse
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/diverse ;
        owl:onClass fint:administrasjon/kodeverk/diverse ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/aktivitet ;
        owl:allValuesFrom fint:administrasjon/kodeverk/aktivitet
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/aktivitet ;
        owl:onClass fint:administrasjon/kodeverk/aktivitet ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/ansvar ;
        owl:allValuesFrom fint:administrasjon/kodeverk/ansvar
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/ansvar ;
        owl:onClass fint:administrasjon/kodeverk/ansvar ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/stedfortreder ;
        owl:allValuesFrom fint:administrasjon/personal/personalressurs
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/stedfortreder ;
        owl:onClass fint:administrasjon/personal/personalressurs ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/kontrakt ;
        owl:allValuesFrom fint:administrasjon/kodeverk/kontrakt
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/kontrakt ;
        owl:onClass fint:administrasjon/kodeverk/kontrakt ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/fullmektig ;
        owl:allValuesFrom fint:administrasjon/personal/personalressurs
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/fullmektig ;
        owl:onClass fint:administrasjon/personal/personalressurs ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/prosjekt ;
        owl:allValuesFrom fint:administrasjon/kodeverk/prosjekt
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/prosjekt ;
        owl:onClass fint:administrasjon/kodeverk/prosjekt ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/formal ;
        owl:allValuesFrom fint:administrasjon/kodeverk/formal
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/formal ;
        owl:onClass fint:administrasjon/kodeverk/formal ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/rolle ;
        owl:allValuesFrom fint:administrasjon/fullmakt/rolle
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/rolle ;
        owl:onClass fint:administrasjon/fullmakt/rolle ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/lopenummer ;
        owl:allValuesFrom fint:administrasjon/kodeverk/lopenummer
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/fullmakt/lopenummer ;
        owl:onClass fint:administrasjon/kodeverk/lopenummer ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:administrasjon/fullmakt/rolle rdf:type owl:Class ;
    rdfs:label "Rolle" ;
    rdfs:comment "Rettighet eller type fullmakt.\n\nDe vanligste rollene er:\n\n- Attestant\n- Anviser\n- Bestiller\n- Kontering\n\nEksempler: KONTERING, BESTILLER, ATTESTANT, ANVISER" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/rolle/beskrivelse ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/rolle/beskrivelse ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/rolle/navn ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/rolle/navn ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/rolle/fullmakt ;
        owl:allValuesFrom fint:administrasjon/fullmakt/fullmakt
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/fullmakt/rolle/fullmakt ;
        owl:onClass fint:administrasjon/fullmakt/fullmakt ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:administrasjon/kodeverk/aktivitet rdf:type owl:Class ;
    rdfs:label "Aktivitet" ;
    rdfs:comment "Aktivitet er en del av kontostrengen og er en detaljering av funksjon." ;
    rdfs:subClassOf fint:administrasjon/kodeverk/kontodimensjon .

fint:administrasjon/kodeverk/anlegg rdf:type owl:Class ;
    rdfs:label "Anlegg" ;
    rdfs:comment "Anlegg er en del av kontostrengen og er et objekt som skal aktiveres eller avskrives." ;
    rdfs:subClassOf fint:administrasjon/kodeverk/kontodimensjon .

fint:administrasjon/kodeverk/ansvar rdf:type owl:Class ;
    rdfs:label "Ansvar" ;
    rdfs:comment "Kodeverk som er en del av kontostrengen som beskriver hvem som har ansvaret for en utgift eller en inntekt\n\n# Beskrivelse\n\nAnsvar viser hvordan ansvaret i organisasjonen er bygd opp i samsvar med fylkeskommunens anvisningsmyndighet.\n\nAlternative navn: `Kostsenter`, `Koststed`." ;
    rdfs:subClassOf fint:administrasjon/kodeverk/kontodimensjon ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/ansvar/overordnet ;
        owl:allValuesFrom fint:administrasjon/kodeverk/ansvar
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/ansvar/overordnet ;
        owl:onClass fint:administrasjon/kodeverk/ansvar ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/ansvar/organisasjonselement ;
        owl:allValuesFrom fint:administrasjon/organisasjon/organisasjonselement
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/ansvar/underordnet ;
        owl:allValuesFrom fint:administrasjon/kodeverk/ansvar
    ] .

fint:administrasjon/kodeverk/arbeidsforholdstype rdf:type owl:Class ;
    rdfs:label "Arbeidsforholdstype" ;
    rdfs:comment "Viser hvilket behov hos arbeidsgiver som dekkes av arbeidsforholdet\n\n# Beskrivelse\n\nViser hvilket behov hos arbeidsgiver som dekkes av arbeidsforholdet\n\nAlternative navn:\n* Stillingstype\n* Stillingskategori\n* Ansattforholdkode\n\n# Eksempel\n\nKode | Beskrivelse\n---|---\nA   |     Fast\nB    |    Timelønnet\nC   |     Lærlinger\nD   |     Folkevalgt/politiker\nE    |    Midlertidig\n...   | ...\nZ    |    Annet" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/arbeidsforholdstype/forelder ;
        owl:allValuesFrom fint:administrasjon/kodeverk/arbeidsforholdstype
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/arbeidsforholdstype/forelder ;
        owl:onClass fint:administrasjon/kodeverk/arbeidsforholdstype ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:administrasjon/kodeverk/art rdf:type owl:Class ;
    rdfs:label "Art" ;
    rdfs:comment "Kodeverk som er en del av kontostrengen som beskriver hva slags inntekter og utgifter det gjelder. \n\n# Beskrivelse\n\nAlternativt navn: Konto\n\nArt er det første og såkalt styrende begrepet i kontostrengen. Angir om det er drift, investering eller balanse." ;
    rdfs:subClassOf fint:administrasjon/kodeverk/kontodimensjon .

fint:administrasjon/kodeverk/diverse rdf:type owl:Class ;
    rdfs:label "Diverse" ;
    rdfs:comment "Diverser er en del av kontostrengen og benyttes som et supplement til de spesifikasjoner som framkommer i de øvrige dimensjonene." ;
    rdfs:subClassOf fint:administrasjon/kodeverk/kontodimensjon .

fint:administrasjon/kodeverk/formal rdf:type owl:Class ;
    rdfs:label "Formål" ;
    rdfs:comment "Kodeverk som detaljerer inntekter og utgifter ved drift" ;
    rdfs:subClassOf fint:administrasjon/kodeverk/kontodimensjon .

fint:administrasjon/kodeverk/fravarsgrunn rdf:type owl:Class ;
    rdfs:label "Fraværsgrunn" ;
    rdfs:comment "Grunn til fravær.\n\n# Eksempel\n\n- Arbeidsrelatert\n- Ikke arbeidsrelatert\n- Svangerskap" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:administrasjon/kodeverk/fravarstype rdf:type owl:Class ;
    rdfs:label "Fraværstype" ;
    rdfs:comment "Type fravær.\n\n# Beskrivelse\n\nInneholder informasjon om hva slags type fravær det er som registreres, eksempelvis ferie, permisjon eller sykdom.\n\nTypen fravær brukes av HRM-systemet til å bestemme om fraværet har lønnskonsekvens, hvilken lønnsart som i så fall skal brukes, og om den er knyttet til en permisjon.\n\n# Eksempel\n\n- Egenmelding\n- Syk med legemelding\n- Barn og/ eller barnepassers sykdom\n- Ferie med lønn\n- Velferdspermisjon med lønn\n- Utdanningspermisjon med lønn\n- Utdanningspermisjon uten lønn\n- Foreldrepermisjon 100%\n- Foreldrepermisjon 80 %\n- Avspasering\n- Møter\n- Kurs" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/fravarstype/overfores ;
        owl:allValuesFrom xsd:boolean
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/fravarstype/overfores ;
        owl:onDataRange xsd:boolean ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/fravarstype/lonnsart ;
        owl:allValuesFrom fint:administrasjon/kodeverk/lonnsart
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/fravarstype/lonnsart ;
        owl:onClass fint:administrasjon/kodeverk/lonnsart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:administrasjon/kodeverk/funksjon rdf:type owl:Class ;
    rdfs:label "Funksjon" ;
    rdfs:comment "Del av kontostrengen som beskriver hva som produseres\n\n# Beskrivelse\n\nFunksjon viser fylkeskommunens aktivitet og tjenesteproduksjon.\n\nAlternativ navn: `Tjeneste`" ;
    rdfs:subClassOf fint:administrasjon/kodeverk/kontodimensjon ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/funksjon/overordnet ;
        owl:allValuesFrom fint:administrasjon/kodeverk/funksjon
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/funksjon/overordnet ;
        owl:onClass fint:administrasjon/kodeverk/funksjon ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/funksjon/underordnet ;
        owl:allValuesFrom fint:administrasjon/kodeverk/funksjon
    ] .

fint:administrasjon/kodeverk/kontodimensjon rdf:type owl:Class ;
    rdfs:label "Kontodimensjon" ;
    rdfs:comment "Abstrakt fellesbegrep som beskriver dimensjon i kontoplan.\n\n# Beskrivelse\n\nFellesbenevnelse for dimensjoner i en kontoplan." ;
    rdfs:subClassOf fint:felles/basisklasser/begrep ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/kontodimensjon/fullmakt ;
        owl:allValuesFrom fint:administrasjon/fullmakt/fullmakt
    ] .

fint:administrasjon/kodeverk/kontrakt rdf:type owl:Class ;
    rdfs:label "Kontrakt" ;
    rdfs:comment "Kontrakt transaksjonen er knyttet til." ;
    rdfs:subClassOf fint:administrasjon/kodeverk/kontodimensjon .

fint:administrasjon/kodeverk/lonnsart rdf:type owl:Class ;
    rdfs:label "Lønnsart" ;
    rdfs:comment "Type ytelse.\n\n# Beskrivelse\n\nLønnsart brukes av HRM-systemer for å indikere hvordan en ytelse skal behandles.\n\nDen inneholder også knytning til hvordan ytelsen skal rapporteres på A-meldingen.\n\nTidligere hadde lønnsart knytning til LTO-kode og LT-kode.\n\n# Referanser\n\n* Rapportering av ytelser på A-meldingen: http://veiledning-amelding.smartlearn.no/Veiledn_Generell/index.html#!Documents/rapporteringavkontantytelser.htm\n* Altinn: Innholdet i A-meldingen: https://www.altinn.no/no/a-ordningen/om-a-meldingen/Innholdet-i-a-meldingen/" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/lonnsart/kategori ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/lonnsart/kategori ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/lonnsart/art ;
        owl:allValuesFrom fint:administrasjon/kodeverk/art
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/lonnsart/art ;
        owl:onClass fint:administrasjon/kodeverk/art ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:administrasjon/kodeverk/lopenummer rdf:type owl:Class ;
    rdfs:label "Løpenummer" ;
    rdfs:comment "Løpenummer i en nummerserie." ;
    rdfs:subClassOf fint:administrasjon/kodeverk/kontodimensjon .

fint:administrasjon/kodeverk/objekt rdf:type owl:Class ;
    rdfs:label "Objekt" ;
    rdfs:comment "Et bygg, en vei eller en bestemt mottaker av en tjeneste eller et tilskudd m.m." ;
    rdfs:subClassOf fint:administrasjon/kodeverk/kontodimensjon .

fint:administrasjon/kodeverk/organisasjonstype rdf:type owl:Class ;
    rdfs:label "Organisasjonstype" ;
    rdfs:comment "Typen til et organisasjonselement.\n\n# Eksempler\n\n* Virksomhet\n* Klinikk\n* Seksjon\n* Avdeling\n* Team\n* Divisjon\n* Stab\n* Skolegruppe" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:administrasjon/kodeverk/personalressurskategori rdf:type owl:Class ;
    rdfs:label "Personalressurskategori" ;
    rdfs:comment "Ansattform til et arbeidsforhold\n\n# Beskrivelse\n\nAlternativ navn:\n* Ansatt (er ikke datatype, men kodeverk)\n* Ansattkategori\n* Ansattformer\"\n\n# Eksempel\n\n## Eksempel fra Visma HR - Kategori:\n\nKode | Beskrivelse\n---|---\nF | Fast\nM | Midlertidig\nO | Oppdragstaker\nP | Politiker\nS | Sluttet\n\n## Eksempel fra Agresso - Ressurstype:\n\nKode  | Beskrivelse\n---|---\n1 | Ansatt - kommunal\n10 | Lærling/Ung arb.taker\n2 | Ansatt - undervisning\n3 | Honorar/godtgjørelse\n4 | Sluttet\n5 | Nyansatt\n6 | Ikke ansatt - kun bruker\n7 | Politikere\n8|  Selvstendig næringsdrivende" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:administrasjon/kodeverk/prosjekt rdf:type owl:Class ;
    rdfs:label "Prosjekt" ;
    rdfs:comment "Del av kontostrengen som peker på løpende prosjekter." ;
    rdfs:subClassOf fint:administrasjon/kodeverk/kontodimensjon ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/prosjekt/prosjektart ;
        owl:allValuesFrom fint:administrasjon/kodeverk/prosjektart
    ] .

fint:administrasjon/kodeverk/prosjektart rdf:type owl:Class ;
    rdfs:label "Prosjektart" ;
    rdfs:comment "Prosjektart er et element i enten en prosjektnedbrytningsstruktur eller en arbeidsnedbrytningsstruktur.\n\n# Prosjektnedbrytningsstruktur (PNS)\n\nEngelsk: Project Breakdown Structure (PBS)\n\nDet fokuseres på delprodukter:\n\n* Delprodukt\n* Delprosjekt\n\n# Arbeidsnedbrytningsstruktur\n\nEngelsk: Work Breakdown Structure (WBS)\n\nDet fokuseres på arbeidsoppgaver:\n\n* Arbeidspakke\n* Oppgave\n* Deloppgave\n\n# Lenker\n\n* [En enkel oppskrift på en arbeidsnedbrytningsstruktur ](https://www.prosjektbloggen.no/en-enkel-oppskrift-pa-en-arbeidsnedbrytningsstruktur)\n* [Prosjektnedbrytningsstruktur(PNS/WBS)](http://ledelsesspire.blogspot.com/2013/10/prosjektnedbrytningsstruktur-pnswbs.html)" ;
    rdfs:subClassOf fint:administrasjon/kodeverk/kontodimensjon ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/prosjektart/underordnet ;
        owl:allValuesFrom fint:administrasjon/kodeverk/prosjektart
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/prosjektart/prosjekt ;
        owl:allValuesFrom fint:administrasjon/kodeverk/prosjekt
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/prosjektart/prosjekt ;
        owl:onClass fint:administrasjon/kodeverk/prosjekt ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/prosjektart/overordnet ;
        owl:allValuesFrom fint:administrasjon/kodeverk/prosjektart
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/prosjektart/overordnet ;
        owl:onClass fint:administrasjon/kodeverk/prosjektart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:administrasjon/kodeverk/ramme rdf:type owl:Class ;
    rdfs:label "Ramme" ;
    rdfs:comment "Ramme er en del av kontostrengen og viser hvilken budsjettramme som skal bære kostnadene." ;
    rdfs:subClassOf fint:administrasjon/kodeverk/kontodimensjon .

fint:administrasjon/kodeverk/stillingskode rdf:type owl:Class ;
    rdfs:label "Stillingskode" ;
    rdfs:comment "Et felles kodeverk for stillinger\n\n# Beskrivelse\n\nI det fylkeskommunale lønnssystemet har alle stillinger en stillingskode og en stillingsbetegnelse (for eksempel 7026 for bibliotekar eller 7076 for hjelpepleier). Stillingskoden kan angi noe om stillingens innhold og lønnsnivå." ;
    rdfs:subClassOf fint:felles/basisklasser/begrep ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/stillingskode/forelder ;
        owl:allValuesFrom fint:administrasjon/kodeverk/stillingskode
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/kodeverk/stillingskode/forelder ;
        owl:onClass fint:administrasjon/kodeverk/stillingskode ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:administrasjon/kodeverk/uketimetall rdf:type owl:Class ;
    rdfs:label "Uketimetall" ;
    rdfs:comment "Timer per uke i 100 % stilling\n\n# Beskrivelse\n\n# Eksempel\n\n## Eksempel fra Agresso - Arbeidsplan:  \n\nKode   |     Beskrivelse\n---|---\n33,6   |     33,6 timers uke\n34,0    |    34,0 timers uke\n34,5     |   34,5 timers uke\n35,0     |   35,0 timers uke\n35,5     |   35,5 timers uke\n36,0     |   36,0 timers uke\n37,5     |   37,5 timers uke\n...    | ..." ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:administrasjon/komplekse-datatyper/kontostreng rdf:type owl:Class ;
    rdfs:label "Kontostreng" ;
    rdfs:comment "Sammensetning av kontodimensjoner for bokføring\n\n# Beskrivelse\n\nHenvisninger til koder i alle kontodimensjoner for kontering av en kostnad eller inntekt." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/funksjon ;
        owl:allValuesFrom fint:administrasjon/kodeverk/funksjon
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/funksjon ;
        owl:onClass fint:administrasjon/kodeverk/funksjon ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/ramme ;
        owl:allValuesFrom fint:administrasjon/kodeverk/ramme
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/ramme ;
        owl:onClass fint:administrasjon/kodeverk/ramme ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/lopenummer ;
        owl:allValuesFrom fint:administrasjon/kodeverk/lopenummer
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/lopenummer ;
        owl:onClass fint:administrasjon/kodeverk/lopenummer ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/kontrakt ;
        owl:allValuesFrom fint:administrasjon/kodeverk/kontrakt
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/kontrakt ;
        owl:onClass fint:administrasjon/kodeverk/kontrakt ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/prosjekt ;
        owl:allValuesFrom fint:administrasjon/kodeverk/prosjekt
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/prosjekt ;
        owl:onClass fint:administrasjon/kodeverk/prosjekt ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/diverse ;
        owl:allValuesFrom fint:administrasjon/kodeverk/diverse
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/diverse ;
        owl:onClass fint:administrasjon/kodeverk/diverse ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/anlegg ;
        owl:allValuesFrom fint:administrasjon/kodeverk/anlegg
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/anlegg ;
        owl:onClass fint:administrasjon/kodeverk/anlegg ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/art ;
        owl:allValuesFrom fint:administrasjon/kodeverk/art
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/art ;
        owl:onClass fint:administrasjon/kodeverk/art ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/prosjektart ;
        owl:allValuesFrom fint:administrasjon/kodeverk/prosjektart
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/prosjektart ;
        owl:onClass fint:administrasjon/kodeverk/prosjektart ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/objekt ;
        owl:allValuesFrom fint:administrasjon/kodeverk/objekt
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/objekt ;
        owl:onClass fint:administrasjon/kodeverk/objekt ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/ansvar ;
        owl:allValuesFrom fint:administrasjon/kodeverk/ansvar
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/ansvar ;
        owl:onClass fint:administrasjon/kodeverk/ansvar ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/aktivitet ;
        owl:allValuesFrom fint:administrasjon/kodeverk/aktivitet
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/aktivitet ;
        owl:onClass fint:administrasjon/kodeverk/aktivitet ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/formal ;
        owl:allValuesFrom fint:administrasjon/kodeverk/formal
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/komplekse-datatyper/kontostreng/formal ;
        owl:onClass fint:administrasjon/kodeverk/formal ;
