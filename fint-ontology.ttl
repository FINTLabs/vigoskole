        owl:onProperty fint:arkiv/noark/arkivressurs/tilgang ;
        owl:allValuesFrom fint:arkiv/noark/tilgang
    ] .

fint:arkiv/noark/autorisasjon rdf:type owl:Class ;
    rdfs:label "Autorisasjon" ;
    rdfs:comment "Siling av hva en individuell pålogget bruker faktisk får lov til å gjøre i løsningen.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 4.5 \n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
