fint:arkiv/kodeverk/rolle rdf:type owl:Class ;
    rdfs:label "Rolle" ;
    rdfs:comment "Rollen til en arkivressurs.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M581\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:arkiv/kodeverk/saksmappetype rdf:type owl:Class ;
    rdfs:label "Saksmappetype" ;
    rdfs:comment "Saksmappetyper brukes for å differensiere innhold og etter hvilke rutiner saker skal behandles.\n\nDette er ikke en del av Noark standarden.\n\n# Synonymer\n<ul>\n <li>Sakstype (P360)</li>\n</ul>\n\n# Eksempel\n\n* Sak\n* PE\n* TS" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:arkiv/kodeverk/saksstatus rdf:type owl:Class ;
    rdfs:label "Saksstatus" ;
    rdfs:comment "Status til saksmappen, dvs. hvor langt saksbehandlingen har kommet.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M052\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:arkiv/kodeverk/skjermingshjemmel rdf:type owl:Class ;
    rdfs:label "Skjermingshjemmel" ;
    rdfs:comment "Henvisning til hjemmel (paragraf) i offentlighetsloven, sikkerhetsloven eller beskyttelsesinstruksen.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M501\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:arkiv/kodeverk/tilgangsgruppe rdf:type owl:Class ;
    rdfs:label "Tilgangsgruppe" ;
    rdfs:comment "Tilgangsgruppe gir mulighet for å skjerme innhold internt for andre brukere." ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:arkiv/kodeverk/tilgangsrestriksjon rdf:type owl:Class ;
    rdfs:label "Tilgangsrestriksjon" ;
    rdfs:comment "Angivelse av at dokumentene som tilhører arkivenheten ikke er offentligtilgjengelig i henhold til offentlighetsloven eller av en annen grunn.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M500\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:arkiv/kodeverk/tilknyttetregistreringsom rdf:type owl:Class ;
    rdfs:label "TilknyttetRegistreringSom" ;
    rdfs:comment "Angivelse av hvilken \"rolle\" dokumentet har i forhold til registreringen.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M217\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:arkiv/kodeverk/variantformat rdf:type owl:Class ;
    rdfs:label "Variantformat" ;
    rdfs:comment "Angivelse av hvilken variant et dokument forekommer i.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M700\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:arkiv/kulturminnevern/dispensasjonautomatiskfredakulturminne rdf:type owl:Class ;
    rdfs:label "DispensasjonAutomatiskFredaKulturminne" ;
    rdfs:comment "Sak om søknad om dispensasjon for tiltak på automatisk freda kulturminne." ;
    rdfs:subClassOf fint:arkiv/noark/saksmappe ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/kulturminnevern/dispensasjonautomatiskfredakulturminne/kulturminneid ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/kulturminnevern/dispensasjonautomatiskfredakulturminne/kulturminneid ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/kulturminnevern/dispensasjonautomatiskfredakulturminne/matrikkelnummer ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/matrikkelnummer
