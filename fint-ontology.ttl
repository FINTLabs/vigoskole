fint:okonomi/faktura/fakturagrunnlag rdf:type owl:Class ;
    rdfs:label "Fakturagrunnlag" ;
    rdfs:comment "Grunnlag for fakturering.\n\n# Beskrivelse\n\nDokumentasjon som danner grunnlag for å fakturere en kunde.\n\nBeskriver hvem som skal utstede faktura og dermed motta betaling, hvem som skal faktureres, og hvilke varer det skal faktureres for." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:okonomi/faktura/fakturagrunnlag/avgiftsbelop ;
        owl:allValuesFrom xsd:long
    ] ;
