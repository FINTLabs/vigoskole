fint:arkiv/noark/tilgang/rolle rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "rolle" ;
    rdfs:comment "Rolle tilknyttet tilgangen." ;
    rdfs:domain fint:arkiv/noark/tilgang ;
    rdfs:range fint:arkiv/kodeverk/rolle .

fint:arkiv/noark/tilgang/systemid rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "systemId" ;
    rdfs:comment "Unik intern systemidentifikasjon for tilgang." ;
    rdfs:domain fint:arkiv/noark/tilgang ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:arkiv/noark/tilgang/tittel rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "tittel" ;
    rdfs:comment "Tittel eller navn på tilgangen." ;
    rdfs:domain fint:arkiv/noark/tilgang ;
    rdfs:range xsd:string .

