fint:ressurs/eiendel/applikasjon rdf:type owl:Class ;
    rdfs:label "Applikasjon" ;
    rdfs:comment "En applikasjon med tilhørende ressurser. \n\nEn ressurs kan være en lisens eller en rolle som tilganger inne i en applikasjon. Applikasjonen kan være en desktopapplikasjon eller en skybasert tjeneste. Brukere kan da få tilgang til denne applikasjonen hvis vedkommende har fått tildelt en ressurs knyttet til applikasjonen." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:ressurs/eiendel/applikasjon/beskrivelse ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:ressurs/eiendel/applikasjon/beskrivelse ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:ressurs/eiendel/applikasjon/gyldighetsperiode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/periode
    ] ;
