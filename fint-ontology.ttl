    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/skoleressurs/personalressurs ;
        owl:onClass fint:administrasjon/personal/personalressurs ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/skoleressurs/skole ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/skole
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/skoleressurs/person ;
        owl:allValuesFrom fint:felles/person
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/skoleressurs/person ;
        owl:onClass fint:felles/person ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/skoleressurs/sensor ;
        owl:allValuesFrom fint:utdanning/vurdering/sensor
    ] .

fint:utdanning/elev/undervisningsforhold rdf:type owl:Class ;
    rdfs:label "Undervisningsforhold" ;
    rdfs:comment "Undervisningsforhold til alle med en pedagogisk funksjon\n\n# Beskrivelse \n\nAlle med en pedagogisk funksjon på skolen kan ha et undervisningsforhold.\n\n# Eksempel\n\nDette kan for eksempel være lærerens undervisningsforhold til skolen. Underviser en lærer på to skoler, vil det være naturlig å ha to undervisningsforhold." ;
    rdfs:subClassOf fint:utdanning/basisklasser/utdanningsforhold ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/undervisningsforhold/hovedskole ;
        owl:allValuesFrom xsd:boolean
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/undervisningsforhold/hovedskole ;
        owl:onDataRange xsd:boolean ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/undervisningsforhold/basisgruppe ;
        owl:allValuesFrom fint:utdanning/elev/basisgruppe
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/undervisningsforhold/arbeidsforhold ;
        owl:allValuesFrom fint:administrasjon/personal/arbeidsforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/undervisningsforhold/arbeidsforhold ;
        owl:onClass fint:administrasjon/personal/arbeidsforhold ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/undervisningsforhold/kontaktlarergruppe ;
        owl:allValuesFrom fint:utdanning/elev/kontaktlarergruppe
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/undervisningsforhold/undervisningsgruppe ;
        owl:allValuesFrom fint:utdanning/timeplan/undervisningsgruppe
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/undervisningsforhold/eksamensgruppe ;
        owl:allValuesFrom fint:utdanning/vurdering/eksamensgruppe
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/undervisningsforhold/time ;
        owl:allValuesFrom fint:utdanning/timeplan/time
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/undervisningsforhold/skole ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/skole
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/undervisningsforhold/skole ;
        owl:onClass fint:utdanning/utdanningsprogram/skole ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/undervisningsforhold/skoleressurs ;
        owl:allValuesFrom fint:utdanning/elev/skoleressurs
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/undervisningsforhold/skoleressurs ;
        owl:onClass fint:utdanning/elev/skoleressurs ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/elev/varsel rdf:type owl:Class ;
    rdfs:label "Varsel" ;
    rdfs:comment "Varsel sendt til en elev.\n\n# Referanse\n\n* [VIS - Opprette og sende varsel ](https://inschool.zendesk.com/hc/no/articles/360030859132-4b-21-Opprette-og-sende-varsel)\n* [Forskrift til opplæringslova - &#167; 3-8. Varsling](https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_5-1#%C2%A73-8)" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/varsel/fravarsprosent ;
        owl:allValuesFrom xsd:long
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/varsel/fravarsprosent ;
        owl:onDataRange xsd:long ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/varsel/sendt ;
        owl:allValuesFrom xsd:date
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/varsel/sendt ;
        owl:onDataRange xsd:date ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/varsel/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/varsel/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/varsel/tekst ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/varsel/tekst ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/varsel/karakteransvarlig ;
        owl:allValuesFrom fint:utdanning/elev/undervisningsforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/varsel/karakteransvarlig ;
        owl:onClass fint:utdanning/elev/undervisningsforhold ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/varsel/utsteder ;
        owl:allValuesFrom fint:utdanning/elev/skoleressurs
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/varsel/utsteder ;
        owl:onClass fint:utdanning/elev/skoleressurs ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/varsel/type ;
        owl:allValuesFrom fint:utdanning/kodeverk/varseltype
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/varsel/type ;
        owl:onClass fint:utdanning/kodeverk/varseltype ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/varsel/faggruppemedlemskap ;
        owl:allValuesFrom fint:utdanning/timeplan/faggruppemedlemskap
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/varsel/faggruppemedlemskap ;
        owl:onClass fint:utdanning/timeplan/faggruppemedlemskap ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/kodeverk/avbruddsarsak rdf:type owl:Class ;
    rdfs:label "Avbruddsårsak" ;
    rdfs:comment "Årsaken til at eleven avbryter utdanningsprogrammet (Vg1)/programområdet (Vg2/Vg3) ) i løpet av skoleåret  eller lærlingen/lærekandidaten hever lærekontrakten/opplæringskontrakten.\n\n# Referanse\n\nRegistreringshåndbok: https://regbok.udir.no/35004/3344/35042-1014313.html" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/betalingsstatus rdf:type owl:Class ;
    rdfs:label "Betalingsstatus" ;
    rdfs:comment "Statuser for betaling av eksamen for privatister." ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/bevistype rdf:type owl:Class ;
    rdfs:label "Bevistype" ;
    rdfs:comment "Viser hvilken bevistype eleven har fått på opplæringen.\n\n* KB - Kompetansebevis\n* VM - Vitnemål\n\n\n# Referanse\n[UDIR - Registreringshåndbok - B22](https://regbok.udir.no/oversikt)" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/brevtype rdf:type owl:Class ;
    rdfs:label "Brevtype" ;
    rdfs:comment "Beskriver hvilken prøve lærlingen/lærekandidaten går opp til.\n* F - Fagbrev\n* S - Svennebrev\n* K - Kompetansebevis\n* B - Praksisbrev\n\n# Referanse\n[UDIR - Registreringshåndbok - C22](https://regbok.udir.no/oversikt)" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/eksamensform rdf:type owl:Class ;
    rdfs:label "Eksamensform" ;
    rdfs:comment "Eksamensordningens form.\n\n# Eksempler:\n* Muntlig\n* Skriftlig\n* Praktisk\n\n# Referanser\n\n* https://www.vigo.no/vigokv/ekstype.action" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/elevkategori rdf:type owl:Class ;
    rdfs:label "Elevkategori" ;
    rdfs:comment "Kategori som et elevforhold befinner seg innenfor\n\n# Eksempel\n\nGyldige verdier kan være:\n* heltid\n* deltid\n* voksen\n* privatist\n* norsk-utv-i-utlandet\n* utenlandsk-utv-i-norge" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/fagmerknad rdf:type owl:Class ;
    rdfs:label "Fagmerknad" ;
    rdfs:comment "Merknader til vitnemål og kompetansebevis\n\n# Beskrivelse\n\nEn fagmerknad er en merknad som har en eller flere av disse funksjonene\n\n- gir opplysninger om faget som ikke går fram av karakterer eller eksamensform\n- utdyper opplysninger om karakterer og/eller eksamensform\n- henviser til vedlegg som gir slike opplysninger\n\n# Referanser\n\n[Merknader til vitnemål og kompetansebevis](https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/3-merknader-til-vitnemal-og-kompetansebevis/)" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/fagstatus rdf:type owl:Class ;
    rdfs:label "Fagstatus" ;
    rdfs:comment "Elevens, privatistens eller kandidatens (voksne) status på et gitt fag.\n\n# Beskrivelse\n\nFagstatus er en kode for undervisningen og/eller grunnlaget for karakteren. Den gir informasjon om hvordan det enkelte faget er gjennomført eller evt. ikke gjennomført.\n\n# Eksempler\n\n* E - Elev\n* F - Fritatt\n\n# Referanse\n\n[Registreringshåndbok]( https://regbok.udir.no/felt/?Id=1014315)" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/fravarstype rdf:type owl:Class ;
    rdfs:label "Fraværstype" ;
    rdfs:comment "Typer fravær.\n\n# Referanse\n\nhttps://www.udir.no/regelverk-og-tilsyn/skole-og-opplaring/saksbehandling/fravar/fravar-i-videregaende/\n\nVIS:\nhttps://inschool.zendesk.com/hc/no/articles/360023264091" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/fullfortkode rdf:type owl:Class ;
    rdfs:label "Fullførtkode" ;
    rdfs:comment "Gir status på hvordan eleven har gjennomført et programområde ved (det normale) skoleårs slutt.\n\n# Referanse\n[UDIR - Registreringshåndbok - B21](https://regbok.udir.no/oversikt)" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/grepreferanse rdf:type owl:Class ;
    rdfs:label "Grepreferanse" ;
    rdfs:comment "Ekstern referanse til Grepkodeverket.\n\n# Beskrivelse\n\nGrep er den nasjonale databasen for fag, læreplaner og opplæringstilbud i grunnopplæringen.\n\nReferanser til Grepkodeverket skal referere til gyldige og unike koder i REST (JSON) API fra Udir.\n\nhttps://www.udir.no/om-udir/data/kl06-grep\n\nDet er viktig å bruke Grepreferanser og ikke Vigoreferanser. \nBruk data.udir.no , ikke psi.udir.no, eksempelvis https://data.udir.no/kl06/SAL3001 (korrekt), ikke https://psi.udir.no/kl06/SAL3001 (feil)." .

fint:utdanning/kodeverk/karakterskala rdf:type owl:Class ;
    rdfs:label "Karakterskala" ;
    rdfs:comment "Gruppering av karakterer etter skala (bokstav, orden osv). \n\n# Eksempler\n\n* Bokstav – bokstavkarakterer\n* Tall – tallkarakterer\n* Binær – Bestått/Ikke-bestått\n* Prosent – prosentpoeng." ;
    rdfs:subClassOf fint:felles/basisklasser/begrep ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/kodeverk/karakterskala/vigoreferanse ;
        owl:allValuesFrom fint:utdanning/kodeverk/vigoreferanse
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/kodeverk/karakterskala/vigoreferanse ;
        owl:onClass fint:utdanning/kodeverk/vigoreferanse ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/kodeverk/karakterskala/verdi ;
        owl:allValuesFrom fint:utdanning/vurdering/karakterverdi
    ] .

fint:utdanning/kodeverk/karakterstatus rdf:type owl:Class ;
    rdfs:label "Karakterstatus" ;
    rdfs:comment "Kode for karakterer som blir endret.\n\n# Referanse\n\nhttps://regbok.udir.no/35004/3344/35042-1015043.html" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/otenhet rdf:type owl:Class ;
    rdfs:label "OtEnhet" ;
    rdfs:comment "Stedet hvor OT-ungdom er under oppfølging." ;
    rdfs:subClassOf fint:felles/basisklasser/begrep ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/kodeverk/otenhet/kommune ;
        owl:allValuesFrom fint:felles/kodeverk/kommune
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/kodeverk/otenhet/kommune ;
        owl:onClass fint:felles/kodeverk/kommune ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/kodeverk/otstatus rdf:type owl:Class ;
    rdfs:label "OtStatus" ;
    rdfs:comment "Statuskoder angir hva som er ungdommens hovedaktivitet\n\n# Eksempel\n\n* OTAR – I arbeid\n* OTMI – Er i militæret\n* OTAP – Arbeidspraksis eller annet tiltak i regi av NAV\n* OTUK – Ukjent aktivitet" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/kodeverk/otstatus/beskrivelse ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/kodeverk/otstatus/beskrivelse ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/kodeverk/otstatus/type ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/kodeverk/otstatus/type ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/kodeverk/provestatus rdf:type owl:Class ;
    rdfs:label "Prøvestatus" ;
    rdfs:comment "Resultat av avlagt prøve - Praktisk prøve + teori.\n\n# Referanse\n[UDIR - Registreringshåndbok - C26](https://regbok.udir.no/oversikt)" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/skolear rdf:type owl:Class ;
    rdfs:label "Skoleår" ;
    rdfs:comment "Del av året da skoler har undervisning (og ikke ferie).\n\n# Beskrivelse\n\nEt skoleår varer som hovedregel fra august til juni." ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/skoleeiertype rdf:type owl:Class ;
    rdfs:label "Skoleeiertype" ;
    rdfs:comment "Angir hvem er det som eier skole\n\n# Eksempler\n\n1 = Fylke\n2 = Stat\n3 = Kommune\n4 = Privat \n\n# Referanser\n\n* Vigo Kodeverkdatabase. Skole: [vigo.no/vigokv/skole.action](https://www.vigo.no/vigokv/skole.action)" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/termin rdf:type owl:Class ;
    rdfs:label "Termin" ;
    rdfs:comment "Inndeling av skoleåret\n\n# Beskrivelse\n\nEt skoleår er som hovedregel inndelt i to terminer. Første termin: medio august til medio januar. Andre termin: medio januar til medio juni." ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/tilrettelegging rdf:type owl:Class ;
    rdfs:label "Tilrettelegging" ;
    rdfs:comment "Tilrettelegging en elev kan ha på eksamen." ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/varseltype rdf:type owl:Class ;
    rdfs:label "Varseltype" ;
    rdfs:comment "Viser hvilken type et varsel er.\n\n# Eksempel\n\n* Fravær\n\n* Orden\n\n* Atferd\n\n* Manglende vurderingsgrunnlag i fag\n\n# Referanse\n\n* [VIS - Opprette og sende varsel ](https://inschool.zendesk.com/hc/no/articles/360030859132-4b-21-Opprette-og-sende-varsel)\n* [Forskrift til opplæringslova - &#167; 3-8. Varsling](https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_5-1#%C2%A73-8)" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/kodeverk/vigoreferanse rdf:type owl:Class ;
    rdfs:label "Vigoreferanse" ;
    rdfs:comment "Ekstern referanse til VIGO Kodeverksbase.\n\n# Beskrivelse\n\nKodeverket kommer fra Grep (Utdanningsdirektoratet sin læreplandatabase), Nasjonalt skoleregister og VIGO.\n\nReferanser til VIGO Kodeverksbase skal referere til gyldige og unike koder i REST (JSON) API fra Vigo IKS/FINTLabs.\n\nhttps://api.felleskomponent.no/utdanning/vigo/kodeverk/swagger-ui.html#/" .

fint:utdanning/kodeverk/vitnemalsmerknad rdf:type owl:Class ;
    rdfs:label "Vitnemålsmerknad" ;
    rdfs:comment "En vitnemålsmerknad har en eller flere av følgende funksjoner:\n\n* gir opplysninger som gjelder opplæringen generelt eller som gjelder hele vitnemålet/kompetansebeviset\n\n* henviser til vedlegg som gir slike opplysninger\n\n* utdyper en fagmerknad\n\nDet kan bare føres vitnemålsmerknader som er gitt av Utdanningsdirektoratet.\n\n# Referanser\n[UDIR : Merknader til vitnemål og kompetansebevis](https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/3-merknader-til-vitnemal-og-kompetansebevis/)" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:utdanning/larling/avlagtprove rdf:type owl:Class ;
    rdfs:label "AvlagtPrøve" ;
    rdfs:comment "Informasjon om en avlagt prøve for en person i et fag." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/larling/avlagtprove/provedato ;
        owl:allValuesFrom xsd:date
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/larling/avlagtprove/provedato ;
        owl:onDataRange xsd:date ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/larling/avlagtprove/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/larling/avlagtprove/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/larling/avlagtprove/provestatus ;
        owl:allValuesFrom fint:utdanning/kodeverk/provestatus
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/larling/avlagtprove/provestatus ;
        owl:onClass fint:utdanning/kodeverk/provestatus ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
