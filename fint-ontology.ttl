        owl:onClass fint:administrasjon/organisasjon/organisasjonselement ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:arkiv/noark/arkivdel rdf:type owl:Class ;
    rdfs:label "Arkivdel" ;
    rdfs:comment "En vilkårlig definert del av et arkiv. Et arkiv skal kunne deles opp i arkivdeler for å gruppere arkivet etter overordnede kriterier. \n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 2.3\n\n# Referanser \n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/arkivdel/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/arkivdel/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/arkivdel/tittel ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/arkivdel/tittel ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/arkivdel/klassifikasjonssystem ;
        owl:allValuesFrom fint:arkiv/noark/klassifikasjonssystem
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/arkivdel/registrering ;
        owl:allValuesFrom fint:arkiv/noark/registrering
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/arkivdel/mappe ;
        owl:allValuesFrom fint:arkiv/noark/mappe
    ] .

fint:arkiv/noark/arkivressurs rdf:type owl:Class ;
    rdfs:label "Arkivressurs" ;
    rdfs:comment "Ansatt med rolle og rettigheter innen arkiv.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 4.3\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/arkivressurs/kildesystemid ;
