        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/saksmappe/saksansvarlig ;
        owl:allValuesFrom fint:arkiv/noark/arkivressurs
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/saksmappe/saksansvarlig ;
        owl:onClass fint:arkiv/noark/arkivressurs ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/saksmappe/saksmappetype ;
        owl:allValuesFrom fint:arkiv/kodeverk/saksmappetype
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/saksmappe/saksmappetype ;
        owl:onClass fint:arkiv/kodeverk/saksmappetype ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/saksmappe/administrativenhet ;
        owl:allValuesFrom fint:arkiv/noark/administrativenhet
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/saksmappe/administrativenhet ;
        owl:onClass fint:arkiv/noark/administrativenhet ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/saksmappe/tilgangsgruppe ;
        owl:allValuesFrom fint:arkiv/kodeverk/tilgangsgruppe
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/saksmappe/tilgangsgruppe ;
        owl:onClass fint:arkiv/kodeverk/tilgangsgruppe ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:arkiv/noark/skjerming rdf:type owl:Class ;
    rdfs:label "Skjerming" ;
    rdfs:comment "Skjerming benyttes til å skjerme registrerte opplysninger eller enkeltdokumenter. Skjermingen trer i kraft når en tilgangskode påføres den enkelte mappe, registrering eller det enkelte dokument.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 2.8.1 \n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/skjerming/skjermingshjemmel ;
        owl:allValuesFrom fint:arkiv/kodeverk/skjermingshjemmel
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/skjerming/skjermingshjemmel ;
        owl:onClass fint:arkiv/kodeverk/skjermingshjemmel ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/skjerming/tilgangsrestriksjon ;
        owl:allValuesFrom fint:arkiv/kodeverk/tilgangsrestriksjon
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/skjerming/tilgangsrestriksjon ;
        owl:onClass fint:arkiv/kodeverk/tilgangsrestriksjon ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:arkiv/noark/tilgang rdf:type owl:Class ;
    rdfs:label "Tilgang" ;
    rdfs:comment "Styring av hvem som har tilgang til hvilke opplysninger. \n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 4 \n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/tilgang/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/tilgang/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/tilgang/tittel ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/tilgang/tittel ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/tilgang/rolle ;
        owl:allValuesFrom fint:arkiv/kodeverk/rolle
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/tilgang/rolle ;
        owl:onClass fint:arkiv/kodeverk/rolle ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/tilgang/arkivressurs ;
        owl:allValuesFrom fint:arkiv/noark/arkivressurs
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/tilgang/administrativenhet ;
        owl:allValuesFrom fint:arkiv/noark/administrativenhet
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/tilgang/administrativenhet ;
        owl:onClass fint:arkiv/noark/administrativenhet ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/tilgang/arkivdel ;
        owl:allValuesFrom fint:arkiv/noark/arkivdel
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/tilgang/arkivdel ;
        owl:onClass fint:arkiv/noark/arkivdel ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:arkiv/personal/personalmappe rdf:type owl:Class ;
    rdfs:label "Personalmappe" ;
    rdfs:comment "Saksmappe med opplysninger om den enkelte arbeidstakers arbeidsforhold.\n\n# Beskrivelse\n\nOpplysninger i en personalmappe kan være personalia, arbeidskontrakt og annen korrespondanse som berører arbeidsforholdet." ;
    rdfs:subClassOf fint:arkiv/noark/saksmappe ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/personal/personalmappe/navn ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/personnavn
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/personal/personalmappe/navn ;
        owl:onClass fint:felles/komplekse-datatyper/personnavn ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/personal/personalmappe/person ;
        owl:allValuesFrom fint:felles/person
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/personal/personalmappe/person ;
        owl:onClass fint:felles/person ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/personal/personalmappe/leder ;
        owl:allValuesFrom fint:administrasjon/personal/personalressurs
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/personal/personalmappe/leder ;
        owl:onClass fint:administrasjon/personal/personalressurs ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/personal/personalmappe/arbeidssted ;
        owl:allValuesFrom fint:administrasjon/organisasjon/organisasjonselement
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/personal/personalmappe/arbeidssted ;
        owl:onClass fint:administrasjon/organisasjon/organisasjonselement ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/personal/personalmappe/personalressurs ;
        owl:allValuesFrom fint:administrasjon/personal/personalressurs
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/personal/personalmappe/personalressurs ;
        owl:onClass fint:administrasjon/personal/personalressurs ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:arkiv/samferdsel/soknaddrosjeloyve rdf:type owl:Class ;
    rdfs:label "SøknadDrosjeløyve" ;
    rdfs:comment "Sak om søknad om løyve (tillatelse til å) kjøre drosje.\n\n# Beskrivelse\n\n Et drosjeløyve er en tillatelse til å transportere mennesker i personbil mot betaling." ;
    rdfs:subClassOf fint:arkiv/noark/saksmappe ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/samferdsel/soknaddrosjeloyve/organisasjonsnavn ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/samferdsel/soknaddrosjeloyve/organisasjonsnavn ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/samferdsel/soknaddrosjeloyve/organisasjonsnummer ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/samferdsel/soknaddrosjeloyve/organisasjonsnummer ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

