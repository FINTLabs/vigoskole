fint:utdanning/vurdering/halvarsfagvurdering rdf:type owl:Class ;
    rdfs:label "Halvårsfagvurdering" ;
    rdfs:comment "Karakterer og andre vurderingsuttrykk.\n\n# Beskrivelse\n\nHalvårsvurdering gis for deltakelse av en elev i en gruppe.\n\nVurdering i fag skal ha relasjon til den `Undervisningsgruppe` som vurderingen er foretatt i. Det er også mulig å sette relasjon direkte til angjeldende fag.\n\n# Referanser\n\n* UDir. Registreringshåndbok, Karakterer og andre vurderingsuttrykk: [regbok.udir.no/35004/3344/35042-1021153.html](http://regbok.udir.no/35004/3344/35042-1021153.html)\n* Føring av vitnemål og kompetansebevis for videregående opplæring i Kunnskapsløftet 2017. Karakterer og andre vurderingsuttrykk: [https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/](https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/)\n* Forskrift til opplæringslova &#167; 3-4: [https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4](https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4)" ;
    rdfs:subClassOf fint:utdanning/vurdering/fagvurdering ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/halvarsfagvurdering/elevforhold ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/halvarsfagvurdering/elevforhold ;
        owl:onClass fint:utdanning/elev/elevforhold ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/halvarsfagvurdering/elevvurdering ;
        owl:allValuesFrom fint:utdanning/vurdering/elevvurdering
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/halvarsfagvurdering/elevvurdering ;
        owl:onClass fint:utdanning/vurdering/elevvurdering ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/vurdering/halvarsordensvurdering rdf:type owl:Class ;
    rdfs:label "Halvårsordensvurdering" ;
    rdfs:comment "Halvårsvurdering av orden og atferd..\n\n# Beskrivelse\n\nVurderinger av orden og atferd gjøres uten relasjon til noen gruppe, kun til et elevforhold.\n\n# Referanser\n\n* UDir. Registreringshåndbok, Karakterer og andre vurderingsuttrykk: [regbok.udir.no/35004/3344/35042-1021153.html](http://regbok.udir.no/35004/3344/35042-1021153.html)\n* Føring av vitnemål og kompetansebevis for videregående opplæring i Kunnskapsløftet 2017. Karakterer og andre vurderingsuttrykk: [https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/](https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/)\n* Forskrift til opplæringslova &#167; 3-4: [https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4](https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4)" ;
    rdfs:subClassOf fint:utdanning/vurdering/ordensvurdering ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/halvarsordensvurdering/elevforhold ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/halvarsordensvurdering/elevforhold ;
        owl:onClass fint:utdanning/elev/elevforhold ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/halvarsordensvurdering/elevvurdering ;
        owl:allValuesFrom fint:utdanning/vurdering/elevvurdering
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/halvarsordensvurdering/elevvurdering ;
        owl:onClass fint:utdanning/vurdering/elevvurdering ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

