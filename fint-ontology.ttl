    rdf:type owl:FunctionalProperty ;
    rdfs:label "gjest" ;
    rdfs:comment "Viser om eleven er gjesteelev." ;
    rdfs:domain fint:utdanning/elev/elev ;
    rdfs:range xsd:boolean .

