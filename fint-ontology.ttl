    ] .

fint:utdanning/elev/kontaktlarergruppe rdf:type owl:Class ;
    rdfs:label "Kontaktlærergruppe" ;
    rdfs:comment "Elevgruppe som ein kontaktlærer har særleg ansvar for.\n\n# Beskrivelse\n\nKontaktlæreren har i denne gruppa særleg ansvar for dei praktiske, administrative og sosialpedagogiske gjeremåla som gjeld klassen eller basisgruppa og dei elevane som er der, mellom anna kontakten med heimen, jf Opplæringslova §8-2." ;
    rdfs:subClassOf fint:utdanning/basisklasser/gruppe ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/kontaktlarergruppe/termin ;
        owl:allValuesFrom fint:utdanning/kodeverk/termin
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/kontaktlarergruppe/elevforhold ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/kontaktlarergruppe/skole ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/skole
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/kontaktlarergruppe/skole ;
        owl:onClass fint:utdanning/utdanningsprogram/skole ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/kontaktlarergruppe/skolear ;
        owl:allValuesFrom fint:utdanning/kodeverk/skolear
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/kontaktlarergruppe/skolear ;
        owl:onClass fint:utdanning/kodeverk/skolear ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/kontaktlarergruppe/basisgruppe ;
        owl:allValuesFrom fint:utdanning/elev/basisgruppe
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/kontaktlarergruppe/basisgruppe ;
        owl:onClass fint:utdanning/elev/basisgruppe ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/kontaktlarergruppe/undervisningsforhold ;
        owl:allValuesFrom fint:utdanning/elev/undervisningsforhold
    ] ;
