    rdfs:range fint:arkiv/noark/dokumentfil .

fint:arkiv/noark/dokumentobjekt/sjekksum rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "sjekksum" ;
    rdfs:comment "En verdi som beregnes ut fra innholdet i dokumentet, og som dermed gir integritetssikring til dokumentets innhold.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M705\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/dokumentobjekt ;
    rdfs:range xsd:string .

fint:arkiv/noark/dokumentobjekt/sjekksumalgoritme rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "sjekksumAlgoritme" ;
    rdfs:comment "Algoritmen som er brukt for å beregne sjekksummen.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M706\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/dokumentobjekt ;
    rdfs:range xsd:string .

fint:arkiv/noark/dokumentobjekt/variantformat rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "variantFormat" ;
    rdfs:comment "Angivelse av hvilken variant et dokument forekommer.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M700\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/dokumentobjekt ;
    rdfs:range fint:arkiv/kodeverk/variantformat .

fint:arkiv/noark/dokumentobjekt/versjonsnummer rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "versjonsnummer" ;
    rdfs:comment "Identifikasjon av versjoner innenfor ett og samme dokument.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M005\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/dokumentobjekt ;
    rdfs:range xsd:long .

fint:arkiv/noark/journalpost/antallvedlegg rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "antallVedlegg" ;
    rdfs:comment "Antall fysiske vedlegg til et fysisk hoveddokument.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M304\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/journalpost ;
    rdfs:range xsd:long .

fint:arkiv/noark/journalpost/avskrivning rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "avskrivning" ;
    rdfs:comment "Avskrivning av journalpost\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard, kapittel 3.4 Avskrivning og saksoppfølging  \n\n# Referanser \n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/journalpost ;
    rdfs:range fint:arkiv/noark/avskrivning .

fint:arkiv/noark/journalpost/dokumentetsdato rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "dokumentetsDato" ;
    rdfs:comment "Dato som er påført selve dokumentet.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M103\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\nTimedelen er egentlig unødvendig der bare dato har verdi. Det anbefales at en da setter den til klokken 12 på dagen (zulu). Derved kan dato leses direkte uten å gjøre om til lokaltid ( i Norge).\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990` -&gt; `1990-03-29T12:00:00Z`\n\n* `29. juni 1990` -&gt; `1990-06-29T12:00:00Z`" ;
    rdfs:domain fint:arkiv/noark/journalpost ;
    rdfs:range xsd:dateTime .

fint:arkiv/noark/journalpost/forfallsdato rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "forfallsDato" ;
    rdfs:comment "Dato som angir fristen for når et inngående dokument må være besvart.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M109\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\nTimedelen er egentlig unødvendig der bare dato har verdi. Det anbefales at en da setter den til klokken 12 på dagen (zulu). Derved kan dato leses direkte uten å gjøre om til lokaltid ( i Norge).\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990` -&gt; `1990-03-29T12:00:00Z`\n\n* `29. juni 1990` -&gt; `1990-06-29T12:00:00Z`" ;
    rdfs:domain fint:arkiv/noark/journalpost ;
    rdfs:range xsd:dateTime .

fint:arkiv/noark/journalpost/journalar rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "journalAr" ;
    rdfs:comment "Viser året journalposten ble opprettet.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M013\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/journalpost ;
    rdfs:range xsd:string .

fint:arkiv/noark/journalpost/journaldato rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "journalDato" ;
    rdfs:comment "Datoen journalposten er opprettet/arkivert.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M101\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\nTimedelen er egentlig unødvendig der bare dato har verdi. Det anbefales at en da setter den til klokken 12 på dagen (zulu). Derved kan dato leses direkte uten å gjøre om til lokaltid ( i Norge).\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990` -&gt; `1990-03-29T12:00:00Z`\n\n* `29. juni 1990` -&gt; `1990-06-29T12:00:00Z`" ;
    rdfs:domain fint:arkiv/noark/journalpost ;
    rdfs:range xsd:dateTime .

fint:arkiv/noark/journalpost/journalenhet rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "journalenhet" ;
    rdfs:comment "Navn på enhet som har det arkivmessige ansvaret for kvalitetssikring av arkivdanningen, og eventuelt registrering (journalføring) og arkivering av fysiske dokumenter.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M308\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/journalpost ;
    rdfs:range fint:arkiv/noark/administrativenhet .

fint:arkiv/noark/journalpost/journalpostnummer rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "journalPostnummer" ;
    rdfs:comment "Inngår i M004 journalpostID. Viser rekkefølgen journalpostene ble opprettet innenfor saksmappen, f.eks. 2011/3869-8 (dokument nr. 8 i sak 2011/3869).\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M015\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/journalpost ;
    rdfs:range xsd:long .

fint:arkiv/noark/journalpost/journalposttype rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "journalposttype" ;
    rdfs:comment "Navn på type journalpost.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M082\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/journalpost ;
    rdfs:range fint:arkiv/kodeverk/journalposttype .

fint:arkiv/noark/journalpost/journalsekvensnummer rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "journalSekvensnummer" ;
    rdfs:comment "Viser rekkefølgen når journalposten ble opprettet under året.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M014\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/journalpost ;
    rdfs:range xsd:long .

fint:arkiv/noark/journalpost/journalstatus rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "journalstatus" ;
    rdfs:comment "Status til journalposten, dvs. om dokumentet er registrert, under behandling eller endelig arkivert.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M053\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/journalpost ;
    rdfs:range fint:arkiv/kodeverk/journalstatus .

fint:arkiv/noark/journalpost/mottattdato rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "mottattDato" ;
    rdfs:comment "Dato et eksternt dokument ble mottatt.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M104\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\nTimedelen er egentlig unødvendig der bare dato har verdi. Det anbefales at en da setter den til klokken 12 på dagen (zulu). Derved kan dato leses direkte uten å gjøre om til lokaltid ( i Norge).\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990` -&gt; `1990-03-29T12:00:00Z`\n\n* `29. juni 1990` -&gt; `1990-06-29T12:00:00Z`" ;
    rdfs:domain fint:arkiv/noark/journalpost ;
    rdfs:range xsd:dateTime .

fint:arkiv/noark/journalpost/offentlighetsvurdertdato rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "offentlighetsvurdertDato" ;
    rdfs:comment "Datoen da offentlighetsvurdering ble foretatt.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M110\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\nTimedelen er egentlig unødvendig der bare dato har verdi. Det anbefales at en da setter den til klokken 12 på dagen (zulu). Derved kan dato leses direkte uten å gjøre om til lokaltid ( i Norge).\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990` -&gt; `1990-03-29T12:00:00Z`\n\n* `29. juni 1990` -&gt; `1990-06-29T12:00:00Z`" ;
    rdfs:domain fint:arkiv/noark/journalpost ;
    rdfs:range xsd:dateTime .

fint:arkiv/noark/journalpost/sendtdato rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "sendtDato" ;
    rdfs:comment "Dato et internt produsert dokument ble sendt/ekspedert.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M105\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\nTimedelen er egentlig unødvendig der bare dato har verdi. Det anbefales at en da setter den til klokken 12 på dagen (zulu). Derved kan dato leses direkte uten å gjøre om til lokaltid ( i Norge).\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990` -&gt; `1990-03-29T12:00:00Z`\n\n* `29. juni 1990` -&gt; `1990-06-29T12:00:00Z`" ;
    rdfs:domain fint:arkiv/noark/journalpost ;
    rdfs:range xsd:dateTime .

fint:arkiv/noark/klasse/klasseid rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "klasseId" ;
    rdfs:comment "Entydig identifikasjon av klassen innenfor klassifikasjonssystemet.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M002\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
