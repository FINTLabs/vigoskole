    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/time/undervisningsforhold ;
        owl:onClass fint:utdanning/elev/undervisningsforhold ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/time/rom ;
        owl:allValuesFrom fint:utdanning/timeplan/rom
    ] .

fint:utdanning/timeplan/undervisningsgruppe rdf:type owl:Class ;
    rdfs:label "Undervisningsgruppe" ;
    rdfs:comment "Gruppering av elever som mottar undervisning. \n\n# Beskrivelse\n\nElever i forskjellige undervisningsgrupper kan ta samme faget.\nFlere fag kan undervises i samme undervisningsgruppe.\nDet kan være flere lærere i en undervisningsgruppe.\n\nUndervisningsgrupper har vanligvis en kode, men denne er lokalt definert, og varierer fra skole til skole, og fra fylke til fylke.\n\nDenne grupperingen omhandler administrering av undervisningen. \n\nSe også [Faggruppe](/docs/timeplan_faggruppe)." ;
    rdfs:subClassOf fint:utdanning/basisklasser/gruppe ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/undervisningsgruppe/termin ;
        owl:allValuesFrom fint:utdanning/kodeverk/termin
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/undervisningsgruppe/skole ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/skole
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/undervisningsgruppe/skole ;
        owl:onClass fint:utdanning/utdanningsprogram/skole ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/undervisningsgruppe/skolear ;
        owl:allValuesFrom fint:utdanning/kodeverk/skolear
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
