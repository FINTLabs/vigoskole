    rdf:type owl:FunctionalProperty ;
    rdfs:label "systemId" ;
    rdfs:comment "Systemidentifikator til en elev.\n\n# Beskrivelse \n\nDette kan være identifikator som eksisterer i SAS/SIS (IPOS/OID)." ;
    rdfs:domain fint:utdanning/elev/elev ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

