    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/elevvurdering/sluttfagvurdering ;
        owl:allValuesFrom fint:utdanning/vurdering/sluttfagvurdering
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/elevvurdering/underveisordensvurdering ;
        owl:allValuesFrom fint:utdanning/vurdering/underveisordensvurdering
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/elevvurdering/vitnemalsmerknad ;
        owl:allValuesFrom fint:utdanning/kodeverk/vitnemalsmerknad
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/elevvurdering/underveisfagvurdering ;
        owl:allValuesFrom fint:utdanning/vurdering/underveisfagvurdering
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/elevvurdering/halvarsordensvurdering ;
        owl:allValuesFrom fint:utdanning/vurdering/halvarsordensvurdering
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/elevvurdering/elevforhold ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/elevvurdering/elevforhold ;
        owl:onClass fint:utdanning/elev/elevforhold ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/elevvurdering/halvarsfagvurdering ;
        owl:allValuesFrom fint:utdanning/vurdering/halvarsfagvurdering
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/elevvurdering/sluttordensvurdering ;
        owl:allValuesFrom fint:utdanning/vurdering/sluttordensvurdering
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/elevvurdering/eksamensvurdering ;
        owl:allValuesFrom fint:utdanning/vurdering/eksamensvurdering
    ] .

fint:utdanning/vurdering/fagvurdering rdf:type owl:Class ;
    rdfs:label "Fagvurdering" ;
    rdfs:comment "Karakterer og andre vurderingsuttrykk.\n\n# Beskrivelse\n\nVurdering i fag skal ha relasjon til det faget det er foretatt vurdering i.\n\n# Referanser\n\n* UDir. Registreringshåndbok, Karakterer og andre vurderingsuttrykk: [regbok.udir.no/35004/3344/35042-1021153.html](http://regbok.udir.no/35004/3344/35042-1021153.html)\n* Føring av vitnemål og kompetansebevis for videregående opplæring i Kunnskapsløftet 2017. Karakterer og andre vurderingsuttrykk: [https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/](https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/)\n* Forskrift til opplæringslova &#167; 3-4: [https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4](https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4)" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fagvurdering/kommentar ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fagvurdering/kommentar ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fagvurdering/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fagvurdering/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fagvurdering/vurderingsdato ;
        owl:allValuesFrom xsd:dateTime
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fagvurdering/vurderingsdato ;
        owl:onDataRange xsd:dateTime ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fagvurdering/skolear ;
        owl:allValuesFrom fint:utdanning/kodeverk/skolear
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fagvurdering/skolear ;
        owl:onClass fint:utdanning/kodeverk/skolear ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fagvurdering/undervisningsgruppe ;
        owl:allValuesFrom fint:utdanning/timeplan/undervisningsgruppe
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fagvurdering/undervisningsgruppe ;
        owl:onClass fint:utdanning/timeplan/undervisningsgruppe ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fagvurdering/karakter ;
        owl:allValuesFrom fint:utdanning/vurdering/karakterverdi
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fagvurdering/karakter ;
        owl:onClass fint:utdanning/vurdering/karakterverdi ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fagvurdering/fag ;
        owl:allValuesFrom fint:utdanning/timeplan/fag
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/fagvurdering/fag ;
