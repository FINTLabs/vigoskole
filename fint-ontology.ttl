fint:administrasjon/personal/personalressurs rdf:type owl:Class ;
    rdfs:label "Personalressurs" ;
    rdfs:comment "Arbeidstaker eller oppdragstaker i organisasjonen\n\n# Beskrivelse\n\nPersonalressurs er personer som leverer tjenester i form av å være ansatt. Personalressursen kan også være en person fra vikarbyrå, eller et firma som bekler et arbeidsforhold gjennom en kontrakt/avtale. Registrert i HR-systemet.\n\n# Eksempler\n\n* *ordinære* ansatte i faste og midlertidige stillinger\n* oppdragstakere: \n  * politikere\n  * ressurser med timelønn\n  * sensorer\n  * eksamensvakt\n  * hospitant\n\nInneholder i utgangspunktet ikke *leverandørrepresenanter* (ekstern vikar, foredragsholdere, konsulenter)." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/ansattnummer ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/ansattnummer ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/ansettelsesperiode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/periode
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/ansettelsesperiode ;
        owl:onClass fint:felles/komplekse-datatyper/periode ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/ansiennitet ;
        owl:allValuesFrom xsd:date
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/ansiennitet ;
        owl:onDataRange xsd:date ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/brukernavn ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/brukernavn ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/jobbtittel ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/jobbtittel ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/kontaktinformasjon ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/kontaktinformasjon
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/kontaktinformasjon ;
        owl:onClass fint:felles/komplekse-datatyper/kontaktinformasjon ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/personalressurskategori ;
        owl:allValuesFrom fint:administrasjon/kodeverk/personalressurskategori
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/personalressurskategori ;
        owl:onClass fint:administrasjon/kodeverk/personalressurskategori ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/arbeidsforhold ;
        owl:allValuesFrom fint:administrasjon/personal/arbeidsforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/personalansvar ;
        owl:allValuesFrom fint:administrasjon/personal/arbeidsforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/leder ;
        owl:allValuesFrom fint:administrasjon/organisasjon/organisasjonselement
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/skoleressurs ;
        owl:allValuesFrom fint:utdanning/elev/skoleressurs
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/skoleressurs ;
        owl:onClass fint:utdanning/elev/skoleressurs ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/personalressurs/stedfortreder ;
