fint:utdanning/utdanningsprogram/skole/skoleeiertype rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "skoleeierType" ;
    rdfs:comment "Er denne skolen eid av kommunen, fylke, private aktører eller noe annet.\nKilde er Vigo Kodeverkdatabase.\n\n# Eksempler\n\n* Fylke\n* Stat\n* Kommune\n* Privat \n\n# Referanser\n\n* Vigo Kodeverkdatabase: [vigo.no/vigokv/skole.action](https://www.vigo.no/vigokv/skole.action)" ;
    rdfs:domain fint:utdanning/utdanningsprogram/skole ;
    rdfs:range fint:utdanning/kodeverk/skoleeiertype .

fint:utdanning/utdanningsprogram/skole/skolenummer rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "skolenummer" ;
    rdfs:comment "Vigo sitt skolenummer \n\n# Beskrivelse \n\nBenyttes i VIGO og de skoleadministrative systemene. Benyttes også i forbindelse med rapportering til SSB, Utdanningsdirektoratet, Lånekassen og Samordna opptak.\n\n# Referanser\n\n* UDir Registreringshåndbok: [regbok.udir.no/35004/3344/35042-1024179.html](http://regbok.udir.no/35004/3344/35042-1024179.html)\n\n# Eksempel \n\n* Byremo videregående skole har skolenummer 10022.\n* Moelv videregående skole har skolenummer 4453." ;
    rdfs:domain fint:utdanning/utdanningsprogram/skole ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

