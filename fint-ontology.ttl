    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/fravar/fravarstype ;
        owl:allValuesFrom fint:administrasjon/kodeverk/fravarstype
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
