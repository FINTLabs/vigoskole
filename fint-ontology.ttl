    ] .

fint:utdanning/timeplan/fag rdf:type owl:Class ;
    rdfs:label "Fag" ;
    rdfs:comment "Emneområde i utdanning i henhold til læreplanverket.\n\n# Beskrivelse\n\nUtdanning gjennomføres i form av fag. Fag i videregående utdanning har en fagtype og en fagkode. Begge er definert i VIGO og Grep kodeverk.  For føring på vitnemål kan kun fagkoder fastsatt av Utdanningsdirektoratet benyttes.\n\nFag og fagkoder kan slås opp hos Utdanningsdirektoratet på https://www.udir.no/laring-og-trivsel/lareplanverket/finn-fagkode/\n\nFagkoder er også beskrevet i [Registreringshåndboken A04](http://regbok.udir.no/35004/3344/35042-1014304.html).\n\n# Fagtyper\n\nFag grupperes etter  [Rundskriv Udir-01-2017](https://www.udir.no/regelverk-og-tilsyn/finn-regelverk/etter-tema/Innhold-i-opplaringen/udir-01-2017/) og skriv fra Utdanningsdirektoratet om [Føring av vitnemål og kompetansebevis for videregående opplæring i Kunnskapsløftet, pkt 2.5](https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/2-oppsett-av-vitnemal-og-kompetansebevis/#2.5-rekkefolge-for-foring-av-fag-og-fagtyper).\n\nDe aktuelle fagtypene i henhold til [Registreringshåndboken A05](http://regbok.udir.no/35004/3344/35042-1014305.html) er:\n\n- Fellesfag\n- Felles programfag\n- Valgfrie programfag\n- Uspesifiserte programfag\n- Yrkesfaglig fordypning\n- Individuell opplæringsplan\n\n# Referanser\n\n* https://www.udir.no/laring-og-trivsel/lareplanverket/\n* https://www.udir.no/utdanningslopet/videregaende-opplaring/\n* http://regbok.udir.no/\n* http://grepwiki.udir.no/\n* https://www.vigo.no/vigokv/index.action" ;
    rdfs:subClassOf fint:utdanning/basisklasser/gruppe ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/fag/programomrade ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/programomrade
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/fag/tilrettelegging ;
        owl:allValuesFrom fint:utdanning/elev/elevtilrettelegging
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/fag/faggruppe ;
        owl:allValuesFrom fint:utdanning/timeplan/faggruppe
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/fag/skole ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/skole
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/fag/undervisningsgruppe ;
        owl:allValuesFrom fint:utdanning/timeplan/undervisningsgruppe
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/fag/eksamensgruppe ;
        owl:allValuesFrom fint:utdanning/vurdering/eksamensgruppe
    ] .

fint:utdanning/timeplan/faggruppe rdf:type owl:Class ;
    rdfs:label "Faggruppe" ;
    rdfs:comment "Gruppe av elever som mottar undervisning i samme fag.\n\n# Beskrivelse\n\nUndervisningsgrupper har vanligvis en kode, men denne er lokalt definert, og varierer fra skole til skole, og fra fylke til fylke.\n\nDenne grupperingen omhandler faglig organisering av undervisningen.\n\nSe også [Undervisningsgruppe](/docs/timeplan_undervisningsgruppe)." ;
    rdfs:subClassOf fint:utdanning/basisklasser/gruppe ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/faggruppe/skole ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/skole
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/faggruppe/skole ;
        owl:onClass fint:utdanning/utdanningsprogram/skole ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/faggruppe/skolear ;
        owl:allValuesFrom fint:utdanning/kodeverk/skolear
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/faggruppe/skolear ;
        owl:onClass fint:utdanning/kodeverk/skolear ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/faggruppe/fag ;
        owl:allValuesFrom fint:utdanning/timeplan/fag
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/faggruppe/fag ;
        owl:onClass fint:utdanning/timeplan/fag ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/timeplan/faggruppe/faggruppemedlemskap ;
        owl:allValuesFrom fint:utdanning/timeplan/faggruppemedlemskap
    ] .

fint:utdanning/timeplan/faggruppemedlemskap rdf:type owl:Class ;
    rdfs:label "Faggruppemedlemskap" ;
    rdfs:comment "Medlemskap i faggruppe." ;
    rdfs:subClassOf fint:utdanning/basisklasser/gruppemedlemskap ;
    rdfs:subClassOf [ a owl:Restriction ;
