    rdfs:range fint:utdanning/kodeverk/avbruddsarsak .

fint:utdanning/elev/elevforhold/avbruddsdato rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "avbruddsdato" ;
    rdfs:comment "Dato da elevforholdet ble avbrutt\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\nTimedelen er egentlig unødvendig der bare dato har verdi. Det anbefales at en da setter den til klokken 12 på dagen (zulu). Derved kan dato leses direkte uten å gjøre om til lokaltid ( i Norge).\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990` -&gt; `1990-03-29T12:00:00Z`\n\n* `29. juni 1990` -&gt; `1990-06-29T12:00:00Z`" ;
    rdfs:domain fint:utdanning/elev/elevforhold ;
    rdfs:range xsd:date .

