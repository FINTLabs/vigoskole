        owl:allValuesFrom fint:arkiv/noark/skjerming
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/skjerming ;
        owl:onClass fint:arkiv/noark/skjerming ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/tilknyttetdato ;
        owl:allValuesFrom xsd:dateTime
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/tilknyttetdato ;
        owl:onDataRange xsd:dateTime ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/tittel ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/tittel ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/dokumenttype ;
        owl:allValuesFrom fint:arkiv/kodeverk/dokumenttype
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/dokumenttype ;
        owl:onClass fint:arkiv/kodeverk/dokumenttype ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:arkiv/noark/dokumentbeskrivelse/tilknyttetav ;
