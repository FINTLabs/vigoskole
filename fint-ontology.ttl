        owl:allValuesFrom fint:utdanning/timeplan/fag
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevtilrettelegging/fag ;
        owl:onClass fint:utdanning/timeplan/fag ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevtilrettelegging/tilrettelegging ;
        owl:allValuesFrom fint:utdanning/kodeverk/tilrettelegging
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevtilrettelegging/tilrettelegging ;
        owl:onClass fint:utdanning/kodeverk/tilrettelegging ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevtilrettelegging/elev ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevtilrettelegging/elev ;
