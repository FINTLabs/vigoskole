fint:ressurs/kodeverk/applikasjonskategori rdf:type owl:Class ;
    rdfs:label "Applikasjonskategori" ;
    rdfs:comment "Kategorier av applikasjoner.\n\nEksempel:\n\n* Pedagogisk programvare\n* Kontorstøtte\n* Fagsystemer" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:ressurs/kodeverk/brukertype rdf:type owl:Class ;
    rdfs:label "Brukertype" ;
    rdfs:comment "De ulike brukertypene som kan benytte lisensen.\n\nEksempler:\n\n* ELEV\n* ANSATTSKOLE\n* ANSATTADMINISTRASJON\n* EKSTERN" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:ressurs/kodeverk/enhetstype rdf:type owl:Class ;
    rdfs:label "Enhetstype" ;
    rdfs:comment "Kategori som den digitale enheten hører til.\n\nEksempler:\n\n* mobiltelefon\n* datamaskin\n* nettbrett" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:ressurs/kodeverk/handhevingstype rdf:type owl:Class ;
    rdfs:label "Håndhevingstype" ;
    rdfs:comment "Hvordan ulike lisensmodeller kan håndheves av systemer for forvaltning av applikasjonen.\n\nEksempel:\n\n* Hardstopp (ikke lov å tildele flere lisenser enn det kildesystemet angir)\n* Ubegrenset (ingen begrensing på antall lisenser som kan tildeles)\n* Overallokering tillatt (kan tildeles lisenser utover maks antall. Ikke nødvendigvis ubegrenset)" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:ressurs/kodeverk/lisensmodell rdf:type owl:Class ;
    rdfs:label "Lisensmodell" ;
    rdfs:comment "Lisensmodeller som kan knyttes til en lisens.\n\nEksempel:\n\n* site\n* user\n* device" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:ressurs/kodeverk/plattform rdf:type owl:Class ;
    rdfs:label "Plattform" ;
    rdfs:comment "Plattformen tjenesten kan leveres på.\n\nEksempel:\n\n* Windows\n* MAC OS\n* Linux\n* IOS\n* Android" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:ressurs/kodeverk/produsent rdf:type owl:Class ;
    rdfs:label "Produsent" ;
    rdfs:comment "Navn på produsenten av den  digitale enheten.\n\nEksempler:\n\n* HP\n* Lenovo\n* Apple\n* Samsung" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:ressurs/kodeverk/status rdf:type owl:Class ;
    rdfs:label "Status" ;
    rdfs:comment "Status på den digitale enheten i fagsystemet (feks ett asset management system):\n\nEksempler:\n\n* i bruk\n* på lager\n* defekt\n* utgått" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:ressurs/tilgang/identitet rdf:type owl:Class ;
    rdfs:label "Identitet" ;
    rdfs:comment "Identitet identifiserer innehaver av rettigheter i relasjonen til organisasjonen.\n\nKilden for denne type informasjon vil typisk være identitetsforvaltningssystemet." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:ressurs/tilgang/identitet/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:ressurs/tilgang/identitet/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:ressurs/tilgang/identitet/eaid-dsta34ca2-aaef-43ef-81d9-b14539180495 ;
        owl:allValuesFrom fint:felles/kodeverk/fylke
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:ressurs/tilgang/identitet/eaid-dsta34ca2-aaef-43ef-81d9-b14539180495 ;
        owl:onClass fint:felles/kodeverk/fylke ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:ressurs/tilgang/identitet/rettighet ;
        owl:allValuesFrom fint:ressurs/tilgang/rettighet
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:ressurs/tilgang/identitet/personalressurs ;
        owl:allValuesFrom fint:administrasjon/personal/personalressurs
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:ressurs/tilgang/identitet/personalressurs ;
        owl:onClass fint:administrasjon/personal/personalressurs ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:ressurs/tilgang/rettighet rdf:type owl:Class ;
    rdfs:label "Rettighet" ;
    rdfs:comment "Navngir en rettighet. Hva rettigheten gir tilgang til er systemspesifikt." ;
    rdfs:subClassOf fint:felles/basisklasser/begrep ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:ressurs/tilgang/rettighet/beskrivelse ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:ressurs/tilgang/rettighet/beskrivelse ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:ressurs/tilgang/rettighet/identitet ;
        owl:allValuesFrom fint:ressurs/tilgang/identitet
    ] .

fint:utdanning/basisklasser/gruppe rdf:type owl:Class ;
    rdfs:label "Gruppe" ;
    rdfs:comment "En generisk samling av elever og lærere\n\n# Beskrivelse \n\nGruppe representeres som en spesialisering (se tabell nedenfor).\n\nGrupper knyttes til Utdanningsforhold via Gruppemedlemskap eller direkte relasjoner.\n\nEn gruppe kan ha referanser til kodeverk fra Grep og VIGO. En gruppe kan ha perioder som angir når den er gyldig eller aktiv. Hvorvidt en gruppe har referanser og perioder avhenger av hvilken konkret klasse som benyttes.\n\n| Klasse | Kode | Periode |\n| ------- | ----- | ------ |\n| Basisgruppe | | X |\n| Kontaktlærergruppe | | X |\n| Utdanningsprogram | X | |\n| Programområde | X | |\n| Fag | X | |\n| Årstrinn | X | |\n| Eksamensgruppe | | X |\n| Undervisningsgruppe | | X |" ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/gruppe/beskrivelse ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/gruppe/beskrivelse ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/gruppe/navn ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/gruppe/navn ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/gruppe/periode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/periode
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/gruppe/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/gruppe/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/gruppe/grepreferanse ;
        owl:allValuesFrom fint:utdanning/kodeverk/grepreferanse
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/gruppe/grepreferanse ;
        owl:onClass fint:utdanning/kodeverk/grepreferanse ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/gruppe/vigoreferanse ;
        owl:allValuesFrom fint:utdanning/kodeverk/vigoreferanse
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/gruppe/vigoreferanse ;
        owl:onClass fint:utdanning/kodeverk/vigoreferanse ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/gruppe/medlemskap ;
        owl:allValuesFrom fint:utdanning/elev/medlemskap
    ] .

fint:utdanning/basisklasser/gruppemedlemskap rdf:type owl:Class ;
    rdfs:label "Gruppemedlemskap" ;
    rdfs:comment "Deltagelse i en gruppe\n\n# Beskrivelse\n\nKnytter sammen et elevforhold og en gruppe (basisgruppe, kontaktlærergruppe, undervisningsgruppe, eksamensgruppe eller programområde). Gjør det mulig å uttrykke gyldighetsperiode for et medlemskap." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/gruppemedlemskap/gyldighetsperiode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/periode
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/gruppemedlemskap/gyldighetsperiode ;
        owl:onClass fint:felles/komplekse-datatyper/periode ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/gruppemedlemskap/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/gruppemedlemskap/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/basisklasser/utdanningsforhold rdf:type owl:Class ;
    rdfs:label "Utdanningsforhold" ;
    rdfs:comment "Et felles begrep for rollene til mennesker (elever, lærere, sensorer osv) som deltar i undervisning\n\n# Beskrivelse \n\nAbstrakt klasse som inneholder relasjoner og informasjon som brukes som elevforhold eller undervisningsforhold.\n\n# Eksempel\n\n* Lærer\n* Elev\n* Sensor" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/utdanningsforhold/beskrivelse ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/utdanningsforhold/beskrivelse ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/utdanningsforhold/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/utdanningsforhold/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/basisklasser/utdanningsforhold/medlemskap ;
        owl:allValuesFrom fint:utdanning/elev/medlemskap
    ] .

fint:utdanning/elev/basisgruppe rdf:type owl:Class ;
    rdfs:label "Basisgruppe" ;
    rdfs:comment "Elevgruppe som definert i Opplæringslova §8-2. \n\n# Beskrivelse\n\nI opplæringa skal elevane delast i klassar eller basisgrupper som skal vareta deira behov for sosialt tilhør. For delar av opplæringa kan elevane delast i andre grupper etter behov. Til vanleg skal organiseringa ikkje skje etter fagleg nivå, kjønn eller etnisk tilhør. Klassane, basisgruppene og gruppene må ikkje vere større enn det som er pedagogisk og tryggleiksmessig forsvarleg.\n\nKlassen eller basisgruppa skal ha ein eller fleire lærarar (kontaktlærarar) som har særleg ansvar for dei praktiske, administrative og sosialpedagogiske gjeremåla som gjeld klassen eller basisgruppa og dei elevane som er der, mellom anna kontakten med heimen.\n\nBegrepet som har tildligere vært kjent som \"klasse\".\n\n\"Vanlig\" gruppe i SATS (klassegruppe)\n\nViser informasjon om:\n* År på VGS person går i\n* Programområdet\n* A, B eller C klasse\n\nSynonym:\n* Klasse\n\nØvre grense er beskrevet i Opplæringslova §8-3 eller i forskrift." ;
    rdfs:subClassOf fint:utdanning/basisklasser/gruppe ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/basisgruppe/skolear ;
        owl:allValuesFrom fint:utdanning/kodeverk/skolear
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/basisgruppe/skolear ;
        owl:onClass fint:utdanning/kodeverk/skolear ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/basisgruppe/elevforhold ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/basisgruppe/termin ;
        owl:allValuesFrom fint:utdanning/kodeverk/termin
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/basisgruppe/trinn ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/arstrinn
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/basisgruppe/trinn ;
        owl:onClass fint:utdanning/utdanningsprogram/arstrinn ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/basisgruppe/skole ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/skole
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/basisgruppe/skole ;
        owl:onClass fint:utdanning/utdanningsprogram/skole ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/basisgruppe/undervisningsforhold ;
        owl:allValuesFrom fint:utdanning/elev/undervisningsforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/basisgruppe/gruppemedlemskap ;
        owl:allValuesFrom fint:utdanning/elev/basisgruppemedlemskap
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/basisgruppe/kontaktlarergruppe ;
        owl:allValuesFrom fint:utdanning/elev/kontaktlarergruppe
    ] .

fint:utdanning/elev/basisgruppemedlemskap rdf:type owl:Class ;
    rdfs:label "Basisgruppemedlemskap" ;
    rdfs:comment "Medlemskap i basisgrupper.\n\n# Beskrivelse\n\nGruppemedlemskap som knytter sammen elevforhold og basisgrupper." ;
    rdfs:subClassOf fint:utdanning/basisklasser/gruppemedlemskap ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/basisgruppemedlemskap/basisgruppe ;
        owl:allValuesFrom fint:utdanning/elev/basisgruppe
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/basisgruppemedlemskap/basisgruppe ;
        owl:onClass fint:utdanning/elev/basisgruppe ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/basisgruppemedlemskap/elevforhold ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/basisgruppemedlemskap/elevforhold ;
        owl:onClass fint:utdanning/elev/elevforhold ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/elev/elev rdf:type owl:Class ;
    rdfs:label "Elev" ;
    rdfs:comment "Informasjon om en person som mottar undervisning.\n\n# Beskrivelse \n\nBeskriver informasjon relatert til undervisning for en Person.\n\nTilsvarende finnes for ansatte: __Personalressurs__." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/brukernavn ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/brukernavn ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/elevnummer ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/elevnummer ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/feidenavn ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/feidenavn ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/gjest ;
        owl:allValuesFrom xsd:boolean
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/gjest ;
        owl:onDataRange xsd:boolean ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/hybeladresse ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/adresse
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/hybeladresse ;
        owl:onClass fint:felles/komplekse-datatyper/adresse ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/kontaktinformasjon ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/kontaktinformasjon
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/kontaktinformasjon ;
        owl:onClass fint:felles/komplekse-datatyper/kontaktinformasjon ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/person ;
        owl:allValuesFrom fint:felles/person
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/person ;
        owl:onClass fint:felles/person ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elev/elevforhold ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] .

fint:utdanning/elev/elevforhold rdf:type owl:Class ;
    rdfs:label "Elevforhold" ;
    rdfs:comment "Elevens forskjellige utdanningsforhold\n\n# Beskrivelse\n\nEn Elev kan ha flere Elevforhold.\n\n# Eksempel\n\nEn elev kan være i elevforhold med status privatist og deltid samtidig. Eller en elev kan ha flere elevforhold på flere forskjellige skoler." ;
    rdfs:subClassOf fint:utdanning/basisklasser/utdanningsforhold ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevforhold/anmerkninger ;
        owl:allValuesFrom fint:utdanning/vurdering/anmerkninger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevforhold/avbruddsdato ;
        owl:allValuesFrom xsd:date
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevforhold/avbruddsdato ;
        owl:onDataRange xsd:date ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevforhold/gyldighetsperiode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/periode
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevforhold/gyldighetsperiode ;
        owl:onClass fint:felles/komplekse-datatyper/periode ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevforhold/hovedskole ;
        owl:allValuesFrom xsd:boolean
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevforhold/hovedskole ;
        owl:onDataRange xsd:boolean ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevforhold/tosprakligfagopplaring ;
        owl:allValuesFrom xsd:boolean
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevforhold/tosprakligfagopplaring ;
        owl:onDataRange xsd:boolean ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevforhold/sidemal ;
        owl:allValuesFrom fint:utdanning/kodeverk/fagmerknad
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevforhold/kategori ;
        owl:allValuesFrom fint:utdanning/kodeverk/elevkategori
    ] ;
