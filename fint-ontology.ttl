    rdfs:domain fint:arkiv/samferdsel/soknaddrosjeloyve ;
    rdfs:range xsd:string .

fint:felles/basisklasser/aktor/kontaktinformasjon rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "kontaktinformasjon" ;
    rdfs:comment "Den foretrukne måten for å komme i kontakt med en aktør.\n\n# Beskrivelse\n\nDen fortrukne måten å komme i kontakt med en aktør. En aktør kan blant annet være en privat person eller et organisasjonselement i organisasjonsstrukturen." ;
    rdfs:domain fint:felles/basisklasser/aktor ;
    rdfs:range fint:felles/komplekse-datatyper/kontaktinformasjon .

fint:felles/basisklasser/aktor/postadresse rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "postadresse" ;
    rdfs:comment "Informasjon om postadresse til en aktør\n\n# Beskrivelse\n\nDen fortrukne måten å komme i kontakt per post med en aktør. En aktør kan blant annet være en privat person eller et organisasjonselement i organisasjonsstrukturen." ;
    rdfs:domain fint:felles/basisklasser/aktor ;
    rdfs:range fint:felles/komplekse-datatyper/adresse .

fint:felles/basisklasser/begrep/gyldighetsperiode rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "gyldighetsperiode" ;
    rdfs:comment "Angir gyldighetsperioden for et begrep/kode" ;
    rdfs:domain fint:felles/basisklasser/begrep ;
    rdfs:range fint:felles/komplekse-datatyper/periode .

fint:felles/basisklasser/begrep/kode rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "kode" ;
    rdfs:comment "Verdi som identifiserer begrepet" ;
    rdfs:domain fint:felles/basisklasser/begrep ;
    rdfs:range xsd:string .

fint:felles/basisklasser/begrep/navn rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "navn" ;
    rdfs:comment "Hovednavn for begrepet" ;
    rdfs:domain fint:felles/basisklasser/begrep ;
    rdfs:range xsd:string .

fint:felles/basisklasser/begrep/passiv rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "passiv" ;
    rdfs:comment "Angir at koden er passiv, og ikke kan velges.\n\n# Beskrivelse\n\nPassive koder kan henvises til i eksisterende data, men kan ikke velges ved registrering av nye data.\n\nMedmindre attributten finnes og er satt til usann regnes koden som aktiv." ;
    rdfs:domain fint:felles/basisklasser/begrep ;
    rdfs:range xsd:boolean .

fint:felles/basisklasser/begrep/systemid rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "systemId" ;
    rdfs:comment "Intern identifikator som brukes enten i kildesystemet eller i kildestandarden (for ISO, KS og lignende standarder)" ;
    rdfs:domain fint:felles/basisklasser/begrep ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:felles/basisklasser/enhet/forretningsadresse rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "forretningsadresse" ;
    rdfs:comment "Besøksadresse til en organisasjonsenhet i enhetsregisteret.\n\n# Beskrivelse\n\n\n# Format\n\n\n# Eksempler" ;
    rdfs:domain fint:felles/basisklasser/enhet ;
    rdfs:range fint:felles/komplekse-datatyper/adresse .

fint:felles/basisklasser/enhet/organisasjonsnavn rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "organisasjonsnavn" ;
    rdfs:comment "Navn på enhet som er registrert i Enhetsregisteret\n\n# Beskrivelse\n\n\n# Format\n\n\n# Eksempler" ;
    rdfs:domain fint:felles/basisklasser/enhet ;
    rdfs:range xsd:string .

fint:felles/basisklasser/enhet/organisasjonsnummer rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "organisasjonsnummer" ;
    rdfs:comment "Nisifret nummer som entydig identifiserer enheter i Enhetsregisteret\n\n# Beskrivelse\n\nOrganisasjonsnummeret består av 9 siffer hvor det siste sifferet er et kontrollsiffer beregnet med standard vekter, modulus 11. Etter dette blir vektene 3, 2, 7, 6, 5, 4, 3 og 2 regnet fra første siffer.\n\n[Se brreg.no](https://www.brreg.no/om-oss/samfunnsoppdraget-vart/registera-vare/einingsregisteret/organisasjonsnummeret/)\n\n# Format\n9 siffer \n\n# Eksempler\n\n971042176\n974770199" ;
    rdfs:domain fint:felles/basisklasser/enhet ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:felles/kodeverk/fylke/kommune rdf:type owl:ObjectProperty ;
    rdfs:label "kommune" ;
    rdfs:comment "Alle kommuner som inngår i fylke" ;
    rdfs:domain fint:felles/kodeverk/fylke ;
    rdfs:range fint:felles/kodeverk/kommune ;
    owl:inverseOf fint:felles/kodeverk/kommune/fylke .

fint:felles/kodeverk/kommune/fylke rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "fylke" ;
    rdfs:comment "Fylke som kommune hører i" ;
    rdfs:domain fint:felles/kodeverk/kommune ;
    rdfs:range fint:felles/kodeverk/fylke ;
    owl:inverseOf fint:felles/kodeverk/fylke/kommune .

fint:felles/kodeverk/valuta/bokstavkode rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "bokstavkode" ;
    rdfs:comment "Bokstavkode for aktuell valuta." ;
    rdfs:domain fint:felles/kodeverk/valuta ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:felles/kodeverk/valuta/navn rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "navn" ;
    rdfs:comment "Navn på valuta." ;
    rdfs:domain fint:felles/kodeverk/valuta ;
    rdfs:range xsd:string .

fint:felles/kodeverk/valuta/nummerkode rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "nummerkode" ;
    rdfs:comment "Nummerkode for aktuell valuta." ;
    rdfs:domain fint:felles/kodeverk/valuta ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:felles/komplekse-datatyper/adresse/adresselinje rdf:type owl:DatatypeProperty ;
    rdfs:label "adresselinje" ;
    rdfs:comment "Adresseinformasjon\n\n# Beskrivelse\n\nAdresseinformasjon. Linjer representeres hver for seg, fra øverst til nederst.\n\nDette kan være:\n* Gateadresse\n* Postboksadresse\n* Bolignummer\n* C/O adresse\n* Attn:\n* Mottak på vegne av andre\n\n# Format\n\nSom dokumentert i [referanser fra klassen](Class:Adresse).\n\n# Eksempler\n\nSe [eksempler fra klassen](Class:Adresse)." ;
    rdfs:domain fint:felles/komplekse-datatyper/adresse ;
    rdfs:range xsd:string .

fint:felles/komplekse-datatyper/adresse/land rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "land" ;
    rdfs:comment "Land hvor adressen befinner seg" ;
    rdfs:domain fint:felles/komplekse-datatyper/adresse ;
    rdfs:range fint:felles/kodeverk/iso/landkode .

fint:felles/komplekse-datatyper/adresse/postnummer rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "postnummer" ;
    rdfs:comment "Postnummer\n\n# Beskrivelse\n\n\n# Format\n\n\n# Eksempler" ;
    rdfs:domain fint:felles/komplekse-datatyper/adresse ;
    rdfs:range xsd:string .

fint:felles/komplekse-datatyper/adresse/poststed rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "poststed" ;
    rdfs:comment "Poststed\n\n# Beskrivelse\n\n\n# Format\n\n\n# Eksempler" ;
    rdfs:domain fint:felles/komplekse-datatyper/adresse ;
    rdfs:range xsd:string .

fint:felles/komplekse-datatyper/identifikator/gyldighetsperiode rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "gyldighetsperiode" ;
    rdfs:comment "Perioden, gitt i form av fra-og-med-dato og til-dato, som en gitt identifikator er gyldig." ;
    rdfs:domain fint:felles/komplekse-datatyper/identifikator ;
    rdfs:range fint:felles/komplekse-datatyper/periode .

fint:felles/komplekse-datatyper/identifikator/identifikatorverdi rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "identifikatorverdi" ;
    rdfs:comment "En konkret kombinasjonen av tegn og/eller bokstaver som utgjør en bestemt identifikator.\n\n# Krav til identifikatorverdi\n\n- Må være et gyldig URI \"path segment\", ref. https://tools.ietf.org/html/rfc3986#section-3.3\n- Må unikt identifisere en instans av en gitt type\n- Kan ikke være tom\n\n# Eksempel\n\nFor eksempel et fødselsnummer, ansattnummer, etc." ;
    rdfs:domain fint:felles/komplekse-datatyper/identifikator ;
    rdfs:range xsd:string .

fint:felles/komplekse-datatyper/kontaktinformasjon/epostadresse rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "epostadresse" ;
    rdfs:comment "Navngitt elektronisk adresse for mottak av e-post\n\n# Referanser\n\n* [E-post adresse](https://en.wikipedia.org/wiki/Email_address)\n* [RFC 5322. Internet Message Format](https://tools.ietf.org/html/rfc5322)\n* [RFC 6854. Update to Internet Message Format](https://tools.ietf.org/html/rfc6854)" ;
    rdfs:domain fint:felles/komplekse-datatyper/kontaktinformasjon ;
    rdfs:range xsd:string .

fint:felles/komplekse-datatyper/kontaktinformasjon/mobiltelefonnummer rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "mobiltelefonnummer" ;
    rdfs:comment "Person sitt mobiltelefonnummer.\n\n# Format\n\nFormat må følge norsk nummerplan E.164, alternativt med `+` for å angi internasjonalt prefiks for internasjonale numre.\n\n# Referanser\n\n- [ITU E.164](https://www.itu.int/rec/T-REC-E.164/en)\n- [Nummerplan (Wikipedia)](https://no.wikipedia.org/wiki/Nummerplan_(E.164))\n\n# Eksempel\n## Riktig:\n\n- 47845326\n- +4747845326\n- +1234234234234\n- +79161238752\n\n## Feil:\n\n- 456 45 334\n- 0047 23 23 23 23\n- 02643\n- 0VAFK" ;
    rdfs:domain fint:felles/komplekse-datatyper/kontaktinformasjon ;
    rdfs:range xsd:string .

fint:felles/komplekse-datatyper/kontaktinformasjon/nettsted rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "nettsted" ;
    rdfs:comment "Adresse til et nettsted\n\n# Beskrivelse\n\nAdresse til et nettsted/hjemmeside.\n\n# Format \n\n Tilltate protokoller HTTP og HTTPS.\n\n# Eksempel\n\n## Riktig\n\n* http://www.nrk.no\n* https://www.nrk.no/qqq.html\n* https://8.8.8.8/rdf/?qqq=rrr\n\n## Ikke riktig\n\n* mailto:qqq@vafk.no\n* tel:+4781506543\n* ftp://petr:1o1Wut?@vafk.no\n\n# Referanser\n\n* [RFC 1738. Uniform Resource Locators](https://www.ietf.org/rfc/rfc1738.txt)\n* [RFC 3986. Uniform Resource Identifier (URI): Generic Syntax](https://www.ietf.org/rfc/rfc3986.txt)" ;
    rdfs:domain fint:felles/komplekse-datatyper/kontaktinformasjon ;
    rdfs:range xsd:string .

fint:felles/komplekse-datatyper/kontaktinformasjon/sip rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "sip" ;
    rdfs:comment "SIP, protokoll for VoIP (IP-telefoni)\n\n# Beskrivelse\n\nKan typsisk være telefonnummer, brukernavn eller epostadresse. SIP «oversetter» et telefonnummer eller annen adresseinformasjon til en IP-adresse\n\n# Format \n\nstring\n\n# Eksempel\n\n* qqq@vafk.no\n\n# Referanser\n\nhttps://snl.no/SIP" ;
    rdfs:domain fint:felles/komplekse-datatyper/kontaktinformasjon ;
    rdfs:range xsd:string .

fint:felles/komplekse-datatyper/kontaktinformasjon/telefonnummer rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "telefonnummer" ;
    rdfs:comment "Person sitt telefonnummer.\n\n# Format\n\nFormat må følge norsk nummerplan E.164, alternativt med `+` for å angi internasjonalt prefiks for internasjonale numre.\n\n# Referanser\n\n- [ITU E.164](https://www.itu.int/rec/T-REC-E.164/en)\n- [Nummerplan (Wikipedia)](https://no.wikipedia.org/wiki/Nummerplan_(E.164))\n\n# Eksempel\n## Riktig:\n\n- 47845326\n- +4747845326\n- +1234234234234\n- +79161238752\n\n## Feil:\n\n- 456 45 334\n- 0047 23 23 23 23\n- 02643\n- 0VAFK" ;
    rdfs:domain fint:felles/komplekse-datatyper/kontaktinformasjon ;
    rdfs:range xsd:string .

fint:felles/komplekse-datatyper/matrikkelnummer/adresse rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "adresse" ;
    rdfs:comment "Adresse til matrikkelenhet." ;
    rdfs:domain fint:felles/komplekse-datatyper/matrikkelnummer ;
    rdfs:range fint:felles/komplekse-datatyper/adresse .

fint:felles/komplekse-datatyper/matrikkelnummer/bruksnummer rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "bruksnummer" ;
    rdfs:comment "Fortløpende nummerering av bruk under gårdsnummer" ;
    rdfs:domain fint:felles/komplekse-datatyper/matrikkelnummer ;
    rdfs:range xsd:string .

fint:felles/komplekse-datatyper/matrikkelnummer/festenummer rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "festenummer" ;
    rdfs:comment "Fortløpende nummerering av fester under gårdsnummer/bruksnummer" ;
    rdfs:domain fint:felles/komplekse-datatyper/matrikkelnummer ;
    rdfs:range xsd:string .

fint:felles/komplekse-datatyper/matrikkelnummer/gardsnummer rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "gårdsnummer" ;
    rdfs:comment "Nummerering av gårdsenhet i matrikkelen, nummeret er unikt innenfor kommune" ;
    rdfs:domain fint:felles/komplekse-datatyper/matrikkelnummer ;
    rdfs:range xsd:string .

fint:felles/komplekse-datatyper/matrikkelnummer/kommunenummer rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "kommunenummer" ;
    rdfs:comment "Nummerering av kommunen i henhold til Statistisk sentralbyrå sin offisielle liste" ;
    rdfs:domain fint:felles/komplekse-datatyper/matrikkelnummer ;
    rdfs:range fint:felles/kodeverk/kommune .

fint:felles/komplekse-datatyper/matrikkelnummer/seksjonsnummer rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "seksjonsnummer" ;
    rdfs:comment "Fortløpende nummerering av seksjoner under gårdsnummer/bruksnummer og eventuelt festenummer" ;
    rdfs:domain fint:felles/komplekse-datatyper/matrikkelnummer ;
    rdfs:range xsd:string .

fint:felles/komplekse-datatyper/periode/beskrivelse rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "beskrivelse" ;
    rdfs:comment "Brukes til å sette beskrivende navn på perioden.\n\n# Eksempel\n\n* 2010 – kalenderår\n* 2010/2011 – skoleår\n* H2010 – høstsemesteret\n* V2011 – vårsemesteret" ;
    rdfs:domain fint:felles/komplekse-datatyper/periode ;
    rdfs:range xsd:string .

fint:felles/komplekse-datatyper/periode/slutt rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "slutt" ;
    rdfs:comment "Til tidspunkt\n\n# Beskrivelse\n\nSlutttidspunkt for perioden.\n\nSlutttidspunkt må være senere eller lik startdato om det er definert.\n\n# Når feltet brukes som et rent datofelt:\n\n## Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\nTimedelen er egentlig unødvendig der bare dato har verdi. Det anbefales at en da setter den til klokken 12 på dagen (zulu). Derved kan dato leses direkte uten å gjøre om til lokaltid ( i Norge).\n\n## Eksempler\n\n29. mars 1990 -&gt; 1990-03-29T12:00:00Z\n\n29. juni 1990 -&gt; 1990-06-29T12:00:00Z\n\n# Når feltet brukes som et datotid felt:\n\n## Format\n\nISO 8601 format YYYY-MM-DDThh:mm:ssZ\n\n## Eksempler\n\n29. mars 1990 klokken 13:30 (UTC +1) -&gt; 1990-03-29T12:30:00Z\n\n29. juni 1990 klokken 13:30 (UTC +2 sommertid) -&gt; 1990-06-29T11:30:00Z\n\n# Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601" ;
    rdfs:domain fint:felles/komplekse-datatyper/periode ;
    rdfs:range xsd:dateTime .

fint:felles/komplekse-datatyper/periode/start rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "start" ;
    rdfs:comment "Fra tidspunkt\n\n# Beskrivelse\n\nStarttidspunkt for perioden.\n\n# Når feltet brukes som et rent datofelt:\n\n## Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\nTimedelen er egentlig unødvendig der bare dato har verdi. Det anbefales at en da setter den til klokken 12 på dagen (zulu). Derved kan dato leses direkte uten å gjøre om til lokaltid ( i Norge).\n\n## Eksempler\n\n29. mars 1990 -&gt; 1990-03-29T12:00:00Z\n\n29. juni 1990 -&gt; 1990-06-29T12:00:00Z\n\n# Når feltet brukes som et datotid felt:\n\n## Format\n\nISO 8601 format YYYY-MM-DDThh:mm:ssZ\n\n## Eksempler\n\n29. mars 1990 klokken 13:30 (UTC +1) -&gt; 1990-03-29T12:30:00Z\n\n29. juni 1990 klokken 13:30 (UTC +2 sommertid) -&gt; 1990-06-29T11:30:00Z\n\n# Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601" ;
    rdfs:domain fint:felles/komplekse-datatyper/periode ;
    rdfs:range xsd:dateTime .

fint:felles/komplekse-datatyper/personnavn/etternavn rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "etternavn" ;
    rdfs:comment "Angir etternavn til en person.\n\n# Beskrivelse\nEtternavn. \n\n# Format\nRen tekst.\n\n# Eksempler\n\n[Se eksempler på Personnavn](/docs/komplekse_datatyper_personnavn)" ;
    rdfs:domain fint:felles/komplekse-datatyper/personnavn ;
    rdfs:range xsd:string .

fint:felles/komplekse-datatyper/personnavn/fornavn rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "fornavn" ;
    rdfs:comment "Angir fornavn til en person.\n\n# Beskrivelse\nFornavn. \n\n# Format\nRen tekst.\n\n# Eksempler\n\n[Se eksempler på Personnavn](/docs/komplekse_datatyper_personnavn)" ;
    rdfs:domain fint:felles/komplekse-datatyper/personnavn ;
    rdfs:range xsd:string .

fint:felles/komplekse-datatyper/personnavn/mellomnavn rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "mellomnavn" ;
    rdfs:comment "Mellomnavn\n\n# Beskrivelse\n\nMellomnavn\n\n# Format\n\nRen tekst\n\n# Eksempler\n\n[Se eksempler på Personnavn](/docs/komplekse_datatyper_personnavn)" ;
    rdfs:domain fint:felles/komplekse-datatyper/personnavn ;
    rdfs:range xsd:string .

fint:felles/kontaktperson/foreldreansvar rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "foreldreansvar" ;
    rdfs:comment "Angir om kontaktpersonen har foreldreansvar for personen vedkommende er pårørende for." ;
    rdfs:domain fint:felles/kontaktperson ;
    rdfs:range xsd:boolean .

fint:felles/kontaktperson/kontaktinformasjon rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "kontaktinformasjon" ;
    rdfs:comment "Kontaktinformasjon for kontaktperson." ;
    rdfs:domain fint:felles/kontaktperson ;
    rdfs:range fint:felles/komplekse-datatyper/kontaktinformasjon .

fint:felles/kontaktperson/kontaktperson rdf:type owl:ObjectProperty ;
    rdfs:label "kontaktperson" ;
    rdfs:comment "Personer kontaktpersonen er pårørende for." ;
    rdfs:domain fint:felles/kontaktperson ;
    rdfs:range fint:felles/person ;
    owl:inverseOf fint:felles/person/parorende .

fint:felles/kontaktperson/navn rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "navn" ;
    rdfs:comment "Navn på kontaktperson." ;
    rdfs:domain fint:felles/kontaktperson ;
    rdfs:range fint:felles/komplekse-datatyper/personnavn .

fint:felles/kontaktperson/person rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "person" ;
    rdfs:comment "Person som er kontaktperson." ;
    rdfs:domain fint:felles/kontaktperson ;
    rdfs:range fint:felles/person ;
    owl:deprecated "true"^^xsd:boolean .

fint:felles/kontaktperson/systemid rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "systemId" ;
    rdfs:comment "Kildesystemets unike identifikator for kontaktperson." ;
    rdfs:domain fint:felles/kontaktperson ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:felles/kontaktperson/type rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "type" ;
    rdfs:comment "Beskriver hva slags type kontaktperson.\n\n# Eksempel\n\n- forelder\n- ektefelle\n- barn\n- søsken\n- bestemor" ;
    rdfs:domain fint:felles/kontaktperson ;
    rdfs:range xsd:string .

fint:felles/person/bilde rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "bilde" ;
    rdfs:comment "HTTP(S) lenke til et bilde av en person.\n\nDet forutsettes at det er bilde med den beste oppløsningen mulig." ;
    rdfs:domain fint:felles/person ;
    rdfs:range xsd:string .

fint:felles/person/bostedsadresse rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "bostedsadresse" ;
    rdfs:comment "Folkeregistrert adresse til person\n\n# Format\n\nSe beskrivelse av [klasse Adresse](Class:Adresse)" ;
    rdfs:domain fint:felles/person ;
    rdfs:range fint:felles/komplekse-datatyper/adresse .

fint:felles/person/elev rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "elev" ;
    rdfs:comment "En person kan være en elev" ;
    rdfs:domain fint:felles/person ;
    rdfs:range fint:utdanning/elev/elev ;
    owl:inverseOf fint:utdanning/elev/elev/person .

fint:felles/person/fodselsdato rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "fødselsdato" ;
    rdfs:comment "Dato for fødsel\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\nTimedelen er egentlig unødvendig der bare dato har verdi. Det anbefales at en da setter den til klokken 12 på dagen (zulu). Derved kan dato leses direkte uten å gjøre om til lokaltid ( i Norge).\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990` -&gt; `1990-03-29T12:00:00Z`\n\n* `29. juni 1990` -&gt; `1990-06-29T12:00:00Z`" ;
    rdfs:domain fint:felles/person ;
    rdfs:range xsd:date .

fint:felles/person/fodselsnummer rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "fødselsnummer" ;
    rdfs:comment "Fødselsnummer eller en av de fiktive variantene\n\n# Beskrivelse\n\nEt ellevesifret identifikasjonsnummer som alle folkeregistrerte i Norge har. Fødselsnummeret består av fødselsdato (6 siffer) og personnummer (5 siffer).\n\n# Format \n\n11 siffer\n\n# Referanser\n\n* [Wiki side](https://no.wikipedia.org/wiki/Fødselsnummer)\n* [Registreringshåndboken A01.Fødselsnummer](http://regbok.udir.no/35004/3344/35042-1027331.html)" ;
    rdfs:domain fint:felles/person ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:felles/person/foreldre rdf:type owl:ObjectProperty ;
    rdfs:label "foreldre" ;
    rdfs:comment "Den/De som har foreldreansvar til personen.\n\nDette kan være personens foreldre eller adoptivforeldre." ;
    rdfs:domain fint:felles/person ;
    rdfs:range fint:felles/person ;
    owl:inverseOf fint:felles/person/foreldreansvar .

fint:felles/person/foreldreansvar rdf:type owl:ObjectProperty ;
    rdfs:label "foreldreansvar" ;
    rdfs:comment "Personer denne personen har foreldreansvar for.\n\n# Referanser\n\n- Folkeregisterloven §3-1 og Folkeregisterforskriften  §3-1-1\n- Barnelova §§ 2-7\n- https://www.skatteetaten.no/person/folkeregister/fodsel-og-navnevalg/barn-fodt-i-norge/farskap-og-foreldreansvar/" ;
    rdfs:domain fint:felles/person ;
    rdfs:range fint:felles/person ;
    owl:inverseOf fint:felles/person/foreldre .

fint:felles/person/kjonn rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "kjønn" ;
    rdfs:comment "Kjønn for person.\n\n# Beskrivelse\n\nSe beskrivelse av [Kjønn klasse](Class:Kjønn)" ;
    rdfs:domain fint:felles/person ;
    rdfs:range fint:felles/kodeverk/iso/kjonn .

fint:felles/person/kommune rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "kommune" ;
    rdfs:comment "Kommune hvor personen er bosatt" ;
    rdfs:domain fint:felles/person ;
    rdfs:range fint:felles/kodeverk/kommune .

fint:felles/person/larling rdf:type owl:ObjectProperty ;
    rdfs:label "lærling" ;
    rdfs:comment "En person kan være en lærling." ;
    rdfs:domain fint:felles/person ;
    rdfs:range fint:utdanning/larling/larling ;
    owl:inverseOf fint:utdanning/larling/larling/person .

fint:felles/person/malform rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "målform" ;
    rdfs:comment "Målform som denne personen foretrekker å bruke (eksempelvis nynorsk, bokmål eller samisk)." ;
    rdfs:domain fint:felles/person ;
    rdfs:range fint:felles/kodeverk/iso/sprak .

fint:felles/person/morsmal rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "morsmål" ;
    rdfs:comment "Morsmål til en person" ;
    rdfs:domain fint:felles/person ;
    rdfs:range fint:felles/kodeverk/iso/sprak .

fint:felles/person/navn rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "navn" ;
    rdfs:comment "Angir navn på en person. \n\n# Beskrivelse\n\nSe beskrivelse for [Personnavn klasse](Class:Personnavn)" ;
    rdfs:domain fint:felles/person ;
