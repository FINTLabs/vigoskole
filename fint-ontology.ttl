fint:arkiv/noark/administrativenhet rdf:type owl:Class ;
    rdfs:label "AdministrativEnhet" ;
    rdfs:comment "Navn på avdeling, kontor eller annen administrativ enhet som har ansvaret for saksbehandlingen.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 4.2\n* Noark 5 versjon 5.0 metadatakatalog - nr. M086\n\n# Referanser\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
