    rdfs:domain fint:administrasjon/organisasjon/organisasjonselement ;
    rdfs:range xsd:string .

fint:administrasjon/organisasjon/organisasjonselement/organisasjonsid rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "organisasjonsId" ;
    rdfs:comment "Unikt internnummer som er unikt for organisasjonselement\n\n# Beskrivelse\n\nDette kan være et nummer som ikke er synlig i fagsystem." ;
    rdfs:domain fint:administrasjon/organisasjon/organisasjonselement ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:administrasjon/organisasjon/organisasjonselement/organisasjonskode rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "organisasjonsKode" ;
    rdfs:comment "Beskrivende kode\n\n# Beskrivelse\nBeskrivende kode, som ofte beskriver hvor man er i hierarkiet (for eksempel 35 er overordnet til 356).\n\nVerdien må være unik innenfor en gitt gyldighetsperiode.\n\n# Eksempel\n\n## Eksempel fra Østfold fylkeskommune\n\n* F12\n* F12.10\n* F12.10.44\n* F12.10.44.50\n* F12.10.44.50.15\n\n## Eksempel fra Vest-Agder fylkeskommune\n\n* 3 Fylkesrådmann\n* 32 Utdanningsavdeling\n* 3211 Seksjon for plan og utvikling\n* 3212 Seksjon for inntak og gjennomføring\n* 3213 Seksjon for fagopplæring\n* 3215 SMI skolen\n* 321501 SMI skolen, andre avdelinger\n* 321502 Ungdomsskoleavdelingen - grunnskoleopplæring\n* 321503 Ungdomsavdelingen - VGO" ;
    rdfs:domain fint:administrasjon/organisasjon/organisasjonselement ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:administrasjon/organisasjon/organisasjonselement/organisasjonstype rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "organisasjonstype" ;
    rdfs:comment "Hvilken type organisasjonselement dette er." ;
    rdfs:domain fint:administrasjon/organisasjon/organisasjonselement ;
    rdfs:range fint:administrasjon/kodeverk/organisasjonstype .

fint:administrasjon/organisasjon/organisasjonselement/overordnet rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "overordnet" ;
    rdfs:comment "Referanse til organisasjonselement på nivået over gjeldende organisasjonselement.\n\n# Beskrivelse\nAlle overordnede (forelder) organisasjonselement.\n\nPå øverste nivå, vil overordnet peke til seg selv.\n\n# Format\nReferanse til seg selv.\n\n# Eksempler\n\n* *Faggruppe for digitalisering og systemforvaltning* refererer til overordnet organisasjonselement, som er *IT-seksjonen*.\n* *Avdeling for helse og sosial* kan referere til organisasjonselemenetet til skolen, som kan være *Byremo videregående skole*" ;
    rdfs:domain fint:administrasjon/organisasjon/organisasjonselement ;
    rdfs:range fint:administrasjon/organisasjon/organisasjonselement .

fint:administrasjon/organisasjon/organisasjonselement/skole rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "skole" ;
    rdfs:comment "Referanse til Utdannings domenet" ;
    rdfs:domain fint:administrasjon/organisasjon/organisasjonselement ;
    rdfs:range fint:utdanning/utdanningsprogram/skole ;
    owl:inverseOf fint:utdanning/utdanningsprogram/skole/organisasjon .

fint:administrasjon/personal/arbeidsforhold/aktivitet rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "aktivitet" ;
    rdfs:comment "Aktivitet arbeidsforhold er tilknyttet." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/kodeverk/aktivitet .

fint:administrasjon/personal/arbeidsforhold/anlegg rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "anlegg" ;
    rdfs:comment "Anlegg arbeidsforhold er tilknyttet." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/kodeverk/anlegg .

fint:administrasjon/personal/arbeidsforhold/ansettelsesprosent rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "ansettelsesprosent" ;
    rdfs:comment "Den prosenten personalressursen eier, i henholdt til arbeidsavtalen\n\n# Format\nAngitt fra 0 til 10000 i hundredelsprosent.\n\n# Eksempler\n\n* `1000` tilsvarer 10 %\n* `1033` tilsvarer 10,33 %\n* `8000` tilsvarer 80 %\n* `10000` tilsvarer 100 %\n* For tilkallingsvikar kan denne være `0`" ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range xsd:string .

fint:administrasjon/personal/arbeidsforhold/ansvar rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "ansvar" ;
    rdfs:comment "Relasjon til begrepet ansvar\n\n# Beskrivelse\n\nBeskriver hvilket ansvar arbeidsforholdet vanligvis knyttes til. \n\nSynonymer:  kostsenter, kostnadsbærer.\n\nSe kodeverk [Ansvar](/docs/kodeverk_ansvar)." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/kodeverk/ansvar .

fint:administrasjon/personal/arbeidsforhold/arbeidsforholdsperiode rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "arbeidsforholdsperiode" ;
    rdfs:comment "Periode for en gitt stilling.\n\n# Beskrivelse\n\nRepresenterer reell start- og sluttdato for stilling, selv om stillingen er representert som flere arbeidsforhold.\n\nPrinsippet for anvendelse av gyldighetsperiode og arbeidsforholdsperiode er som følger:\n\n* HRM eksporterer arbeidsforholdene for hvert stillingsnummer som en tidslinje hvor gyldighetsperioder ikke er overlappende.\n\n* For en gitt transaksjonsdato (f.eks. dagens dato):  Finn de instansene av Arbeidsforhold-objektet (versjon av arbeidsforhold) hvor transaksjonsdatoen faller innenfor gyldighetsperioden, dvs: gyldighetsperiode.start &lt;= transaksjonsdato &lt;= gyldighetsperiode.slutt\n\n* Kontroller transaksjonsdato mot arbeidsforholdsperiode:  For at en gitt instans av Arbeidsforhold skal regnes som aktiv for timeplanlegging og registrering av lønn og fravær må arbeidsforholdsperiode.start &lt;= transaksjonsdato &lt;= arbeidsforholdsperiode.slutt" ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:felles/komplekse-datatyper/periode .

fint:administrasjon/personal/arbeidsforhold/arbeidsforholdstype rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "arbeidsforholdstype" ;
    rdfs:comment "Beskrivende kode som kategoriserer hva slags funksjon stillingen grupperes til\n\n# Beskrivelse\n\nBeskrivende kode som kategoriserer hva slags funksjon stillingen grupperes til.\n\nAnsattkode eller stillingskategori som den også kalles.\n\n# Eksempler\n\nSe eksempel i Arbeidsforholdstype-kodeverk" ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/kodeverk/arbeidsforholdstype .

fint:administrasjon/personal/arbeidsforhold/arbeidslokasjon rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "arbeidslokasjon" ;
    rdfs:comment "Fysisk lokasjon hvor den ansatte har sitt arbeidssted." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/organisasjon/arbeidslokasjon ;
    owl:inverseOf fint:administrasjon/organisasjon/arbeidslokasjon/arbeidsforhold .

fint:administrasjon/personal/arbeidsforhold/arbeidssted rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "arbeidssted" ;
    rdfs:comment "Tilhørighet til organisasjonsstruktur\n\n# Beskrivelse\n\nFor eksempel koden til \"Avdeling for Helse og mijlø\".\n\nKommentar fra feltet organisasjonId:\nKode for relasjon til organisasjonstruktur. \n\nTilsvarer Arbeidssted i HR-system, mens VFS kaller dette for Ansvar og beskriver det med: \"Type 2 = Ansvar, benyttes til å plassere den ansatte på riktig skole\".\n\nFor eksempel kode for \"Bjerke videregående skole\".\n\nArbeid stedskode som er bygget på en eller flere organisasjonsenheter\n\nI en bedrift er en avdeling en organisasjonsenhet som utgjør ansvarsområdet til en (avdelings)sjef. Avdelingssjefen kan for eksempel hete formann, salgssjef eller kontorsjef. (ref.Store norske leksikon)\n\n# Format\n\n\n# Eksempler" ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/organisasjon/organisasjonselement ;
    owl:inverseOf fint:administrasjon/organisasjon/organisasjonselement/arbeidsforhold .

fint:administrasjon/personal/arbeidsforhold/arslonn rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "årslønn" ;
    rdfs:comment "Årslønn/grunnlønn i 100 % stilling.\n\n# Beskrivelse\nLønn i 100% stilling. Inneholder ikke definerte tillegg. Angis i øre.\n\n# Eksempel\n\n* `40000000` tilsvarer 400 000" ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range xsd:string .

fint:administrasjon/personal/arbeidsforhold/art rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "art" ;
    rdfs:comment "Art arbeidsforhold er tilknyttet." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/kodeverk/art .

fint:administrasjon/personal/arbeidsforhold/diverse rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "diverse" ;
    rdfs:comment "Diverse arbeidsforhold er tilknyttet." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/kodeverk/diverse .

fint:administrasjon/personal/arbeidsforhold/fastlonn rdf:type owl:ObjectProperty ;
    rdfs:label "fastlønn" ;
    rdfs:comment "All fastlønn for arbeidsforhold." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/personal/fastlonn ;
    owl:inverseOf fint:administrasjon/personal/fastlonn/arbeidsforhold .

fint:administrasjon/personal/arbeidsforhold/fasttillegg rdf:type owl:ObjectProperty ;
    rdfs:label "fasttillegg" ;
    rdfs:comment "Alle faste tillegg for arbeidsforhold." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/personal/fasttillegg ;
    owl:inverseOf fint:administrasjon/personal/fasttillegg/arbeidsforhold .

fint:administrasjon/personal/arbeidsforhold/formal rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "formål" ;
    rdfs:comment "Formål viser aktivitet og tjenesteproduksjon" ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/kodeverk/formal .

fint:administrasjon/personal/arbeidsforhold/fravar rdf:type owl:ObjectProperty ;
    rdfs:label "fravær" ;
    rdfs:comment "Alle fravær knyttet til arbeidsforhold." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/personal/fravar ;
    owl:inverseOf fint:administrasjon/personal/fravar/arbeidsforhold .

fint:administrasjon/personal/arbeidsforhold/funksjon rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "funksjon" ;
    rdfs:comment "Arbeidsforholdets relasjon til funksjon. \n\n# Beskrivelse\n\nBeskriver hvilken funksjon arbeidsforholdet vanligvis knyttes til.\n\nSynonymer:  Tjeneste\n\nSe kodeverk [Funksjon](/docs/kodeverk_funksjon). \n\n\n# Eksempler\n\nR1 Visma 2 kostra funksjoner:\n\nFor eksempel koden til \"Studiespesialisering\" eller \"PEDAGOGISK LEDELSE OG PEDAGOGISKE FELLESUTGIFTER\"." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/kodeverk/funksjon .

fint:administrasjon/personal/arbeidsforhold/gyldighetsperiode rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "gyldighetsperiode" ;
    rdfs:comment "Gyldig periode for et gitt arbeidsforhold\n\n# Beskrivelse \n\nPeriode en personalressurs har vært (eller er) ansatt i et bestemt arbeidsforhold. Inneholder en dato for start, og kan inneholde slutt-dato.\n\nEndringer i samme stilling kan representeres som flere arbeidsforhold med samme stillingsnummer og ulike gyldighetsperioder.\n\nPrinsippet for anvendelse av gyldighetsperiode og arbeidsforholdsperiode er som følger:\n\n* HRM eksporterer arbeidsforholdene for hvert stillingsnummer som en tidslinje hvor gyldighetsperioder ikke er overlappende.\n\n* For en gitt transaksjonsdato (f.eks. dagens dato):  Finn de instansene av Arbeidsforhold-objektet (versjon av arbeidsforhold) hvor transaksjonsdatoen faller innenfor gyldighetsperioden, dvs: gyldighetsperiode.start &lt;= transaksjonsdato &lt;= gyldighetsperiode.slutt\n\n* Kontroller transaksjonsdato mot arbeidsforholdsperiode:  For at en gitt instans av Arbeidsforhold skal regnes som aktiv for timeplanlegging og registrering av lønn og fravær må arbeidsforholdsperiode.start &lt;= transaksjonsdato &lt;= arbeidsforholdsperiode.slutt" ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:felles/komplekse-datatyper/periode .

fint:administrasjon/personal/arbeidsforhold/hovedstilling rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "hovedstilling" ;
    rdfs:comment "Angir hvilket arbeidsforhold som er hovedarbeidsforhold.\n\n# Beskrivelse\n\nPrimærstillingen personalressursen er knyttet til, og som er grunnlaget for det juridiske arbeidsforholdet.\n\nEn personalressurs kan ha flere arbeidsforhold, men kun en av disse kan være hovedstillingen.\n\n# Format\n\ntrue/false" ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range xsd:boolean .

fint:administrasjon/personal/arbeidsforhold/kontrakt rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "kontrakt" ;
    rdfs:comment "Kontrakt arbeidsforhold er tilknyttet." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/kodeverk/kontrakt .

fint:administrasjon/personal/arbeidsforhold/lonn rdf:type owl:ObjectProperty ;
    rdfs:label "lønn" ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/personal/lonn ;
    owl:deprecated "true"^^xsd:boolean .

fint:administrasjon/personal/arbeidsforhold/lonnsprosent rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "lønnsprosent" ;
    rdfs:comment "Prosent av årslønn den ansatte  skal ha utbetalt\n\n# Beskrivelse\n\nDet personalressursen skal ha utbetalt.\n\n# Format\n\nAngitt fra 0 til 10000 i hundredelsprosent.\n\n\n# Eksempler\n\n* `1000` tilsvarer 10 %\n* `1033` tilsvarer 10,33 %\n* `8000` tilsvarer 80 %\n* `10000` tilsvarer 100 %" ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range xsd:string .

fint:administrasjon/personal/arbeidsforhold/lopenummer rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "løpenummer" ;
    rdfs:comment "Løpenummer arbeidsforhold er tilknyttet." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/kodeverk/lopenummer .

fint:administrasjon/personal/arbeidsforhold/objekt rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "objekt" ;
    rdfs:comment "Objekt arbeidsforhold er tilknyttet." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/kodeverk/objekt .

fint:administrasjon/personal/arbeidsforhold/personalleder rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "personalleder" ;
    rdfs:comment "Personalleder til et arbeidsforhold.\n\n# Beskrivelse\n\nIndikerer personalleder til et arbeidsforhold." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/personal/personalressurs ;
    owl:inverseOf fint:administrasjon/personal/personalressurs/personalansvar .

fint:administrasjon/personal/arbeidsforhold/personalressurs rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "personalressurs" ;
    rdfs:comment "Pesonalressurs til et arbeidsforhold" ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/personal/personalressurs ;
    owl:inverseOf fint:administrasjon/personal/personalressurs/arbeidsforhold .

fint:administrasjon/personal/arbeidsforhold/prosjekt rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "prosjekt" ;
    rdfs:comment "Prosjekt arbeidsforhold tilknyttet." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/kodeverk/prosjekt .

fint:administrasjon/personal/arbeidsforhold/ramme rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "ramme" ;
    rdfs:comment "Ramme arbeidsforhold er tilknyttet." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/kodeverk/ramme .

fint:administrasjon/personal/arbeidsforhold/stillingskode rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "stillingskode" ;
    rdfs:comment "En fire- eller sekssifret stillingskode. Firesiffret kodeliste fra KS. Kan være utvidet i tillegg med to siffer. De to siste er egentilpasset.\n\n# Beskrivelse\n\nSe kodeverk Stillingskode." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/kodeverk/stillingskode .

fint:administrasjon/personal/arbeidsforhold/stillingsnummer rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "stillingsnummer" ;
    rdfs:comment "Løpenummer for stilling\n\n# Beskrivelse\n\nLøpenummer for stillinger som arbeidstaker har eller har hatt i organisasjonen.  Arbeidsforhold representerer tidslinjen til en stilling, alle arbeidsforhold med samme stillingsnummer representerer samme stilling. Gyldighetsperiodene til arbeidsforhold med samme stillingsnummer kan ikke overlappe.\n\n# Format\n\nId-verdi til en stilling.\n\n# Eksempler\n\nFor en personalressurs med tre arbeidsforhold, kan det være: 1 2 3" ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range xsd:string .

fint:administrasjon/personal/arbeidsforhold/stillingstittel rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "stillingstittel" ;
    rdfs:comment "Arbeidstakers stillingstittel i gjeldende stilling.\n\n# Beskrivelse\n\nBrukes i noen tilfeller som fritekst tittel slik at ansatte kan overstyre hva som skal vises på offentlige websider og intranett.\n\nDette er ikke det samme som Stillingsbenevnelse som er titelen/tekstverdien til stillingskoden.\n\n# Format\n\nTekst\n\n# Eksempler\n\n* \"IT-sjef\" (mens stillingsbenevnelse kan være \"SEKSJONSLEDER\"\n* \"Rådgiver, IT\" (mens stillingsbenevnelse kan være \"Rådgiver 1\"" ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range xsd:string .

fint:administrasjon/personal/arbeidsforhold/systemid rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "systemId" ;
    rdfs:comment "Unik identifikator innenfor alle arbeidsforhold\n\n# Beskrivelse\n\nUnik identifikator innenfor alle arbeidsforhold til alle ansatte." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:administrasjon/personal/arbeidsforhold/tilstedeprosent rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "tilstedeprosent" ;
    rdfs:comment "Det personalressursen faktisk jobber\n\n# Beskrivelse\n\nI hvilken prosentstørrelse personalressursen er tilgjengelig for arbeidsgiver.\n\n# Format\n\nAngitt fra 0 til 10000 i hundredelsprosent.\n\n# Eksempler\n\n* `1000` tilsvarer 10 %\n* `1033` tilsvarer 10,33 %\n* `8000` tilsvarer 80 %\n* `10000` tilsvarer 100 %" ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range xsd:string .

fint:administrasjon/personal/arbeidsforhold/timerperuke rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "timerPerUke" ;
    rdfs:comment "Timer pr uke i 100% stilling\n\n# Beskrivelse\n\nUlike type stillinger kan ha ulikt timetall for en 100% stilling\n\n# Format\n\n\n# Eksempler" ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/kodeverk/uketimetall .

fint:administrasjon/personal/arbeidsforhold/undervisningsforhold rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "undervisningsforhold" ;
    rdfs:comment "Relasjon til en tilsvarende objekt i Utdannings domenet" ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:utdanning/elev/undervisningsforhold ;
    owl:inverseOf fint:utdanning/elev/undervisningsforhold/arbeidsforhold .

fint:administrasjon/personal/arbeidsforhold/variabellonn rdf:type owl:ObjectProperty ;
    rdfs:label "variabellønn" ;
    rdfs:comment "All variabel lønn for arbeidsforhold." ;
    rdfs:domain fint:administrasjon/personal/arbeidsforhold ;
    rdfs:range fint:administrasjon/personal/variabellonn ;
    owl:inverseOf fint:administrasjon/personal/variabellonn/arbeidsforhold .

fint:administrasjon/personal/fastlonn/arbeidsforhold rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "arbeidsforhold" ;
    rdfs:comment "Arbeidsforhold fastlønn gjelder for." ;
    rdfs:domain fint:administrasjon/personal/fastlonn ;
    rdfs:range fint:administrasjon/personal/arbeidsforhold ;
    owl:inverseOf fint:administrasjon/personal/arbeidsforhold/fastlonn .

fint:administrasjon/personal/fastlonn/lonnsart rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "lønnsart" ;
    rdfs:comment "Lønnsart for fastlønn." ;
    rdfs:domain fint:administrasjon/personal/fastlonn ;
    rdfs:range fint:administrasjon/kodeverk/lonnsart .

fint:administrasjon/personal/fastlonn/prosent rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "prosent" ;
    rdfs:comment "Andel av lønnsprosent som beslaglegges.\n\n# Representasjon av prosent\n\nI informasjonsmodellen oppgis en prosentverdi som et heltall. Dette tallet er antall hundredels prosent.\n\n## Eksempel\n\n* 44 prosent vil ha verdien 4400.\n* 58,73 prosent vil ha verdien 5873" ;
    rdfs:domain fint:administrasjon/personal/fastlonn ;
    rdfs:range xsd:string .

fint:administrasjon/personal/fasttillegg/arbeidsforhold rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "arbeidsforhold" ;
    rdfs:comment "Arbeidsforhold fasttillegget gjelder for." ;
    rdfs:domain fint:administrasjon/personal/fasttillegg ;
    rdfs:range fint:administrasjon/personal/arbeidsforhold ;
    owl:inverseOf fint:administrasjon/personal/arbeidsforhold/fasttillegg .

fint:administrasjon/personal/fasttillegg/belop rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "beløp" ;
    rdfs:comment "Beløp, i øre." ;
    rdfs:domain fint:administrasjon/personal/fasttillegg ;
    rdfs:range xsd:long .

fint:administrasjon/personal/fasttillegg/lonnsart rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "lønnsart" ;
    rdfs:comment "Lønnsart for tillegget." ;
    rdfs:domain fint:administrasjon/personal/fasttillegg ;
    rdfs:range fint:administrasjon/kodeverk/lonnsart .

fint:administrasjon/personal/fravar/arbeidsforhold rdf:type owl:ObjectProperty ;
    rdfs:label "arbeidsforhold" ;
    rdfs:comment "Arbeidsforholdet fraværet gjelder for.\n\nFlere arbeidsforhold kan kun angis dersom det gjelder samme personalressurs, og type fravær og prosent fravær er identiske." ;
    rdfs:domain fint:administrasjon/personal/fravar ;
    rdfs:range fint:administrasjon/personal/arbeidsforhold ;
    owl:inverseOf fint:administrasjon/personal/arbeidsforhold/fravar .

fint:administrasjon/personal/fravar/fortsettelse rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "fortsettelse" ;
    rdfs:comment "Fortsettende fravær." ;
    rdfs:domain fint:administrasjon/personal/fravar ;
    rdfs:range fint:administrasjon/personal/fravar ;
    owl:inverseOf fint:administrasjon/personal/fravar/fortsetter .

fint:administrasjon/personal/fravar/fortsetter rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "fortsetter" ;
    rdfs:comment "Fraværet som dette fraværet er fortsettende for." ;
    rdfs:domain fint:administrasjon/personal/fravar ;
    rdfs:range fint:administrasjon/personal/fravar ;
    owl:inverseOf fint:administrasjon/personal/fravar/fortsettelse .

fint:administrasjon/personal/fravar/fravarsgrunn rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "fraværsgrunn" ;
    rdfs:comment "Grunn til fraværet." ;
    rdfs:domain fint:administrasjon/personal/fravar ;
    rdfs:range fint:administrasjon/kodeverk/fravarsgrunn .

fint:administrasjon/personal/fravar/fravarstype rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "fraværstype" ;
    rdfs:comment "Type fravær." ;
    rdfs:domain fint:administrasjon/personal/fravar ;
    rdfs:range fint:administrasjon/kodeverk/fravarstype .

fint:administrasjon/personal/fravar/godkjenner rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "godkjenner" ;
    rdfs:comment "Personalressurs som har godkjent fraværsmeldingen." ;
    rdfs:domain fint:administrasjon/personal/fravar ;
    rdfs:range fint:administrasjon/personal/personalressurs .

fint:administrasjon/personal/fravar/godkjent rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "godkjent" ;
    rdfs:comment "Tidsstempel som angir når fravær ble godkjent.\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990 klokken 13:30 (UTC +1)` -&gt; `1990-03-29T12:30:00Z`\n\n* `29. juni 1990 klokken 13:30 (UTC +2 sommertid)` -&gt; `1990-06-29T11:30:00Z`" ;
    rdfs:domain fint:administrasjon/personal/fravar ;
    rdfs:range xsd:dateTime .

fint:administrasjon/personal/fravar/kildesystemid rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "kildesystemId" ;
    rdfs:comment "Kildesystemets unike identifikator for fravær." ;
    rdfs:domain fint:administrasjon/personal/fravar ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:administrasjon/personal/fravar/periode rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "periode" ;
    rdfs:comment "Periode for fraværet.\n\nForskjellige fraværstyper kan ha begrensninger i forhold til om perioden må være et antall timer eller et antall dager.\n\nPerioden angir både tidspunkt for fraværet og varighet av fraværet." ;
    rdfs:domain fint:administrasjon/personal/fravar ;
    rdfs:range fint:felles/komplekse-datatyper/periode .

fint:administrasjon/personal/fravar/prosent rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "prosent" ;
    rdfs:comment "Prosent fraværende\n\n# Beskrivelse\n\nGrad av sykemelding for arbeidsforhold. \n\n# Representasjon av prosent\n\nI informasjonsmodellen oppgis en prosentverdi som et heltall. Dette tallet er antall hundredels prosent.\n\n# Eksempel\n\n- Helt sykemeldt:\n  - 10000\n- 50% permisjon:\n  - 5000" ;
    rdfs:domain fint:administrasjon/personal/fravar ;
    rdfs:range xsd:string .

fint:administrasjon/personal/fravar/systemid rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "systemId" ;
    rdfs:comment "Unik identifikator i personalsystemet for fraværet." ;
    rdfs:domain fint:administrasjon/personal/fravar ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:administrasjon/personal/lonn/anviser rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "anviser" ;
    rdfs:comment "Personalressurs som har anvist lønnsmeldingen etter fullmakt." ;
    rdfs:domain fint:administrasjon/personal/lonn ;
    rdfs:range fint:administrasjon/personal/personalressurs .

fint:administrasjon/personal/lonn/anvist rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "anvist" ;
    rdfs:comment "Tidsstempel som angir når lønn ble anvist.\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990 klokken 13:30 (UTC +1)` -&gt; `1990-03-29T12:30:00Z`\n\n* `29. juni 1990 klokken 13:30 (UTC +2 sommertid)` -&gt; `1990-06-29T11:30:00Z`" ;
    rdfs:domain fint:administrasjon/personal/lonn ;
    rdfs:range xsd:dateTime .

fint:administrasjon/personal/lonn/attestant rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "attestant" ;
    rdfs:comment "Personalressurs som har attestert lønnsmeldingen etter fullmakt." ;
    rdfs:domain fint:administrasjon/personal/lonn ;
    rdfs:range fint:administrasjon/personal/personalressurs .

fint:administrasjon/personal/lonn/attestert rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "attestert" ;
    rdfs:comment "Tidsstempel som angir når lønn ble attestert.\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990 klokken 13:30 (UTC +1)` -&gt; `1990-03-29T12:30:00Z`\n\n* `29. juni 1990 klokken 13:30 (UTC +2 sommertid)` -&gt; `1990-06-29T11:30:00Z`" ;
    rdfs:domain fint:administrasjon/personal/lonn ;
    rdfs:range xsd:dateTime .

fint:administrasjon/personal/lonn/beskrivelse rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "beskrivelse" ;
    rdfs:comment "Beskrivelse av lønn, til føring på lønnsslipp.\n\n# Beskrivelse\n\nForklarende beskrivelse, til bruk i behandling, rapportering og for anføring på lønnsslipp.\n\n# Eksempel\n\n- Fag- og gruppekode en lærer underviser i. \n- Reisestrekning for kilometergodtgjørelse\n- Beskrivelse av tillegg." ;
    rdfs:domain fint:administrasjon/personal/lonn ;
    rdfs:range xsd:string .

fint:administrasjon/personal/lonn/kildesystemid rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "kildesystemId" ;
    rdfs:comment "Kildesystemets unike identifikator for lønn.\n\n# Beskrivelse\n\nForsystem som oppretter lønnstransaksjon kan angi en unik identifikator for transaksjonen.  Denne identifikatoren kan brukes av lønnssystemet for å oppdage duplikate transaksjoner." ;
    rdfs:domain fint:administrasjon/personal/lonn ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:administrasjon/personal/lonn/konterer rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "konterer" ;
    rdfs:comment "Personalressurs som har kontert lønnsmeldingen etter fullmakt." ;
    rdfs:domain fint:administrasjon/personal/lonn ;
    rdfs:range fint:administrasjon/personal/personalressurs .

fint:administrasjon/personal/lonn/kontert rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "kontert" ;
    rdfs:comment "Tidsstempel som angir når lønn ble kontert.\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990 klokken 13:30 (UTC +1)` -&gt; `1990-03-29T12:30:00Z`\n\n* `29. juni 1990 klokken 13:30 (UTC +2 sommertid)` -&gt; `1990-06-29T11:30:00Z`" ;
    rdfs:domain fint:administrasjon/personal/lonn ;
    rdfs:range xsd:dateTime .

fint:administrasjon/personal/lonn/kontostreng rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "kontostreng" ;
    rdfs:comment "Kontering av lønn." ;
    rdfs:domain fint:administrasjon/personal/lonn ;
    rdfs:range fint:administrasjon/komplekse-datatyper/kontostreng .

fint:administrasjon/personal/lonn/opptjent rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "opptjent" ;
    rdfs:comment "Periode hvor lønn ble opptjent.\n\n# Beskrivelse\n\nFor etterbetaling av lønn kan opptjeningsperiode være forskjellig fra utbetalingsperiode." ;
    rdfs:domain fint:administrasjon/personal/lonn ;
    rdfs:range fint:felles/komplekse-datatyper/periode .

fint:administrasjon/personal/lonn/periode rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "periode" ;
    rdfs:comment "Periode som lønn utbetales.\n\n# Eksempel\n\n- 01.08.2017 - 31.07.2018 (fastlønn for et skoleår)\n- 01.08.2017 - 31.08.2017 (for variabellønn)\n- 01.08.2017 og inntil videre (for øvrige faste ansatte)\n- 13.09.2017 - 15.09.2017 (for en vikar eller en sensor)" ;
    rdfs:domain fint:administrasjon/personal/lonn ;
    rdfs:range fint:felles/komplekse-datatyper/periode .

fint:administrasjon/personal/lonn/systemid rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "systemId" ;
    rdfs:comment "Lønnssystemets unike identifikator for lønn." ;
    rdfs:domain fint:administrasjon/personal/lonn ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:administrasjon/personal/personalressurs/ansattnummer rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "ansattnummer" ;
    rdfs:comment "Den unike identifIkatoren til en ansatt i ansatt-/ressursregistret i HR-systemet\n\n# Beskrivelse\n\nIdentifiserer en personalressurs unikt. En personalressurs vil kun være registert med ett ansattnummer." ;
    rdfs:domain fint:administrasjon/personal/personalressurs ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:administrasjon/personal/personalressurs/ansettelsesperiode rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "ansettelsesperiode" ;
    rdfs:comment "Perioden personalressursen er i et forhold til fylkeskommunen\n\n# Beskrivelse\n\n* Startdato: Datoen for når personalressursen første gang begynte i fylkeskommunene.\n* Sluttdato: Dato for når personalressursen sitt forhold til fylkeskommunen opphører." ;
    rdfs:domain fint:administrasjon/personal/personalressurs ;
    rdfs:range fint:felles/komplekse-datatyper/periode .

fint:administrasjon/personal/personalressurs/ansiennitet rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "ansiennitet" ;
    rdfs:comment "Ansiennitet for personalressurs hos arbeidsgiver.\n\n# Beskrivelse\n\nAnsiennitet er normalt den ansattes tiltredelsesdato hos arbeidsgiver, men tariffavtalene fastsetter tilleggsregler blant annet for godskriving av tidligere offentlig og privat tjeneste.\n\n# Referanser\n\n- KS Hovedtariffavtalen &#167; 12\n- Statens personalhåndbok 2018, kapittel 7.3.4\n- https://snl.no/ansiennitet\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\nTimedelen er egentlig unødvendig der bare dato har verdi. Det anbefales at en da setter den til klokken 12 på dagen (zulu). Derved kan dato leses direkte uten å gjøre om til lokaltid ( i Norge).\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990` -&gt; `1990-03-29T12:00:00Z`\n\n* `29. juni 1990` -&gt; `1990-06-29T12:00:00Z`" ;
    rdfs:domain fint:administrasjon/personal/personalressurs ;
    rdfs:range xsd:date .

fint:administrasjon/personal/personalressurs/arbeidsforhold rdf:type owl:ObjectProperty ;
    rdfs:label "arbeidsforhold" ;
    rdfs:comment "Arbeidsforhold til en personalressurs" ;
    rdfs:domain fint:administrasjon/personal/personalressurs ;
    rdfs:range fint:administrasjon/personal/arbeidsforhold ;
    owl:inverseOf fint:administrasjon/personal/arbeidsforhold/personalressurs .

fint:administrasjon/personal/personalressurs/brukernavn rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "brukernavn" ;
    rdfs:comment "Brukernavn til en ansatt\n\n# Beskrivelse\n\nSkal inneholde brukernavn for pålogging, som finnes i katalogtjenesten (feks Active Directory). Brukes som en identifikator som består, når fødselsnummer og/eller andre identifikatorer endrer seg.\n\n# Format\n\nBrukernavn i det format en personalressurs trenger for å logge seg på systemer i organisasjonen." ;
    rdfs:domain fint:administrasjon/personal/personalressurs ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:administrasjon/personal/personalressurs/fullmakt rdf:type owl:ObjectProperty ;
    rdfs:label "fullmakt" ;
    rdfs:comment "Fullmakter som Personalressursen har blitt gitt." ;
    rdfs:domain fint:administrasjon/personal/personalressurs ;
    rdfs:range fint:administrasjon/fullmakt/fullmakt ;
    owl:inverseOf fint:administrasjon/fullmakt/fullmakt/fullmektig .

fint:administrasjon/personal/personalressurs/jobbtittel rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "jobbtittel" ;
    rdfs:comment "Navn som beskriver en jobb eller stilling.\n\n# Beskrivelse\n\nJobbtitler er mer spesifikke siden de reflekterer nivået på jobben, samt ansvaret i jobben." ;
    rdfs:domain fint:administrasjon/personal/personalressurs ;
    rdfs:range xsd:string .

fint:administrasjon/personal/personalressurs/kontaktinformasjon rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "kontaktinformasjon" ;
    rdfs:comment "Arbeidsrelatert kontaktinformasjon til en personalressurs\n\n# Beskrivelse\n\nDen fortrukne måten å komme i kontakt med en personalressurs." ;
    rdfs:domain fint:administrasjon/personal/personalressurs ;
    rdfs:range fint:felles/komplekse-datatyper/kontaktinformasjon .

fint:administrasjon/personal/personalressurs/leder rdf:type owl:ObjectProperty ;
    rdfs:label "leder" ;
    rdfs:domain fint:administrasjon/personal/personalressurs ;
    rdfs:range fint:administrasjon/organisasjon/organisasjonselement ;
    owl:inverseOf fint:administrasjon/organisasjon/organisasjonselement/leder .

fint:administrasjon/personal/personalressurs/person rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "person" ;
    rdfs:comment "Person som er en personalressurs" ;
    rdfs:domain fint:administrasjon/personal/personalressurs ;
    rdfs:range fint:felles/person ;
    owl:inverseOf fint:felles/person/personalressurs .

fint:administrasjon/personal/personalressurs/personalansvar rdf:type owl:ObjectProperty ;
    rdfs:label "personalansvar" ;
    rdfs:comment "Arbeidsforhold som Personalressurs har personalansvar for.\n\n# Beskrivelse\n\nPersonalansvar" ;
    rdfs:domain fint:administrasjon/personal/personalressurs ;
    rdfs:range fint:administrasjon/personal/arbeidsforhold ;
    owl:inverseOf fint:administrasjon/personal/arbeidsforhold/personalleder .

fint:administrasjon/personal/personalressurs/personalressurskategori rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "personalressurskategori" ;
    rdfs:comment "Angir hvilken kategori personalressurs\n\n# Beskrivelse\n\nHvilken kategori/ansattform personalressursen innehar.\n\n# Format\n\n# Eksempel\n\nKan for eksempel velges blant følgende: `Fast`, `Midlertidig`, `Oppdragstaker`, `Politiker`, `Sluttet`\n\nSe kodeverk Personalressurskategori for utvidet eksempel." ;
    rdfs:domain fint:administrasjon/personal/personalressurs ;
    rdfs:range fint:administrasjon/kodeverk/personalressurskategori .

fint:administrasjon/personal/personalressurs/skoleressurs rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "skoleressurs" ;
    rdfs:comment "Relasjon til informasjon om undervisningsforhold." ;
    rdfs:domain fint:administrasjon/personal/personalressurs ;
    rdfs:range fint:utdanning/elev/skoleressurs ;
    owl:inverseOf fint:utdanning/elev/skoleressurs/personalressurs .

fint:administrasjon/personal/personalressurs/stedfortreder rdf:type owl:ObjectProperty ;
    rdfs:label "stedfortreder" ;
    rdfs:domain fint:administrasjon/personal/personalressurs ;
    rdfs:range fint:administrasjon/fullmakt/fullmakt ;
    owl:inverseOf fint:administrasjon/fullmakt/fullmakt/stedfortreder .

fint:administrasjon/personal/personalressurs/systemid rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "systemId" ;
    rdfs:comment "Unik intern system-id for personalressurs\n\n# Beskrivelse\n\nSystemspesifikk id, som normalt ikke er synlig i fagsystemet." ;
    rdfs:domain fint:administrasjon/personal/personalressurs ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:administrasjon/personal/variabellonn/antall rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "antall" ;
    rdfs:comment "Mengde som beskrives av tillegget, i hundredeler.\n\n# Beskrivelse\n\nEnhet er spesifisert av lønnsart.\n\n# Eksempel\n\n- Antall hundredels timer.\n- Antall dekameter (km/100).\n- Antall øre" ;
    rdfs:domain fint:administrasjon/personal/variabellonn ;
    rdfs:range xsd:string .

fint:administrasjon/personal/variabellonn/arbeidsforhold rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "arbeidsforhold" ;
    rdfs:comment "Arbeidsforhold variabellønn gjelder for." ;
    rdfs:domain fint:administrasjon/personal/variabellonn ;
    rdfs:range fint:administrasjon/personal/arbeidsforhold ;
    owl:inverseOf fint:administrasjon/personal/arbeidsforhold/variabellonn .

fint:administrasjon/personal/variabellonn/belop rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "beløp" ;
    rdfs:comment "Beløp i øre som skal utbetales. Beregnes av lønnssystemet basert på antall og lønnsart." ;
    rdfs:domain fint:administrasjon/personal/variabellonn ;
    rdfs:range xsd:string .

fint:administrasjon/personal/variabellonn/lonnsart rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "lønnsart" ;
    rdfs:comment "Lønnsart for variabel lønn." ;
    rdfs:domain fint:administrasjon/personal/variabellonn ;
    rdfs:range fint:administrasjon/kodeverk/lonnsart .

fint:arkiv/kulturminnevern/dispensasjonautomatiskfredakulturminne/kulturminneid rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "kulturminneId" ;
    rdfs:comment "Kulturminnets ID i Askeladden." ;
    rdfs:domain fint:arkiv/kulturminnevern/dispensasjonautomatiskfredakulturminne ;
