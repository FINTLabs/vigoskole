        owl:onClass fint:okonomi/kodeverk/vare ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:okonomi/faktura/fakturamottaker rdf:type owl:Class ;
    rdfs:label "Fakturamottaker" ;
    rdfs:comment "Aktør som skal betale faktura. \n\n# Beskrivelse\n\nMottaker er, per i dag, alltid en person." ;
