    rdfs:domain fint:utdanning/elev/elev ;
    rdfs:range fint:felles/komplekse-datatyper/adresse .

fint:utdanning/elev/elev/kontaktinformasjon rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "kontaktinformasjon" ;
    rdfs:comment "Skolespesifikk kontaktinformasjon til en elev\n\n# Beskrivelse\n\nDen fortrukne måten å komme i kontakt med en elev på skolen." ;
    rdfs:domain fint:utdanning/elev/elev ;
    rdfs:range fint:felles/komplekse-datatyper/kontaktinformasjon .

fint:utdanning/elev/elev/person rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "person" ;
    rdfs:comment "Privatperson som er knyttet til en elev.\n\nRelasjonen skal gå til et personobjekt i utdanningsdomenet." ;
    rdfs:domain fint:utdanning/elev/elev ;
