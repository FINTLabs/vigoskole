    rdf:type owl:FunctionalProperty ;
    rdfs:label "tilknyttetDato" ;
    rdfs:comment "Datoen et dokument ble knyttet til en registrering.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M620\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\nTimedelen er egentlig unødvendig der bare dato har verdi. Det anbefales at en da setter den til klokken 12 på dagen (zulu). Derved kan dato leses direkte uten å gjøre om til lokaltid ( i Norge).\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990` -&gt; `1990-03-29T12:00:00Z`\n\n* `29. juni 1990` -&gt; `1990-06-29T12:00:00Z`" ;
    rdfs:domain fint:arkiv/noark/dokumentbeskrivelse ;
    rdfs:range xsd:dateTime .

fint:arkiv/noark/dokumentbeskrivelse/tilknyttetregistreringsom rdf:type owl:ObjectProperty ;
    rdfs:label "tilknyttetRegistreringSom" ;
    rdfs:comment "Angivelse av hvilken rolle dokumentet har i forhold til registreringen.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M217\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/dokumentbeskrivelse ;
    rdfs:range fint:arkiv/kodeverk/tilknyttetregistreringsom .

