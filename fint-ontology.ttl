        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/anmerkninger/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/anmerkninger/eaid-dst7a7058-d5a0-4754-af15-fd736f66ff37 ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/anmerkninger/skolear ;
        owl:allValuesFrom fint:utdanning/kodeverk/skolear
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/anmerkninger/skolear ;
        owl:onClass fint:utdanning/kodeverk/skolear ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/vurdering/eksamensgruppe rdf:type owl:Class ;
    rdfs:label "Eksamensgruppe" ;
    rdfs:comment "Gruppering av elever som tar samme eksamen \n\n# Beskrivelse\n\nUnderordnet til fag.\n\nKan brukes for å:\n* Vise forhold mellom eksamensresultat og sensor\n* Vise gruppering av elever som tok eksamen sammen\n\nDet er også mulig å koble resultater av eksamener direkte på klasse `Fag`.\n\nEksamensgrupper har en kode som er sentralt definert av VIGO." ;
    rdfs:subClassOf fint:utdanning/basisklasser/gruppe ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/eksamensgruppe/eksamensdato ;
        owl:allValuesFrom xsd:dateTime
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/eksamensgruppe/eksamensdato ;
        owl:onDataRange xsd:dateTime ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/eksamensgruppe/skole ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/skole
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/eksamensgruppe/skole ;
        owl:onClass fint:utdanning/utdanningsprogram/skole ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/eksamensgruppe/termin ;
        owl:allValuesFrom fint:utdanning/kodeverk/termin
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/eksamensgruppe/termin ;
        owl:onClass fint:utdanning/kodeverk/termin ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/eksamensgruppe/eksamensform ;
        owl:allValuesFrom fint:utdanning/kodeverk/eksamensform
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/eksamensgruppe/eksamensform ;
        owl:onClass fint:utdanning/kodeverk/eksamensform ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/eksamensgruppe/skolear ;
        owl:allValuesFrom fint:utdanning/kodeverk/skolear
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/eksamensgruppe/skolear ;
        owl:onClass fint:utdanning/kodeverk/skolear ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/eksamensgruppe/eksamen ;
        owl:allValuesFrom fint:utdanning/timeplan/eksamen
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/eksamensgruppe/eksamen ;
        owl:onClass fint:utdanning/timeplan/eksamen ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/eksamensgruppe/elevforhold ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/eksamensgruppe/fag ;
        owl:allValuesFrom fint:utdanning/timeplan/fag
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/eksamensgruppe/fag ;
        owl:onClass fint:utdanning/timeplan/fag ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/eksamensgruppe/gruppemedlemskap ;
        owl:allValuesFrom fint:utdanning/vurdering/eksamensgruppemedlemskap
