fint:utdanning/elev/elev/brukernavn rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "brukernavn" ;
    rdfs:comment "Brukernavn til en elev\n\n# Beskrivelse\n\nSkal inneholde brukernavn for pålogging, som finnes i katalogtjenesten (feks Active Directory). Brukes som en identifikator som består, når fødselsnummer og/eller andre identifikatorer endrer seg.\n\n# Format\n\nBrukernavn i det format en elev trenger for å logge seg på systemer i organisasjonen.\n\n# NB!\n\nFremtidig funksjon for dette feltet er under revisjon." ;
    rdfs:domain fint:utdanning/elev/elev ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:utdanning/elev/elev/elevforhold rdf:type owl:ObjectProperty ;
    rdfs:label "elevforhold" ;
    rdfs:comment "Elevforholdene til en elev" ;
    rdfs:domain fint:utdanning/elev/elev ;
    rdfs:range fint:utdanning/elev/elevforhold ;
    owl:inverseOf fint:utdanning/elev/elevforhold/elev .

fint:utdanning/elev/elev/elevnummer rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "elevnummer" ;
    rdfs:comment "Et unikt nummer som identifiserer en elev" ;
    rdfs:domain fint:utdanning/elev/elev ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

fint:utdanning/elev/elev/feidenavn rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "feidenavn" ;
    rdfs:comment "Fullt Feide-navn\n\n# Beskrivelse\nDette er det samme som `eduPersonPrincipalName` i Feide skjemaet. Se [eduPersonPrincipalName](https://docs.feide.no/schema/info_go/go_attributter_ch02.html#edupersonprincipalname) for utdypende informasjon.\n\n# Eksempel\n- oleolsen@haugaland.fylkeskommune.no" ;
    rdfs:domain fint:utdanning/elev/elev ;
    rdfs:range fint:felles/komplekse-datatyper/identifikator .

