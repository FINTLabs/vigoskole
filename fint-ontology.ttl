fint:administrasjon/organisasjon/arbeidslokasjon rdf:type owl:Class ;
    rdfs:label "Arbeidslokasjon" ;
    rdfs:comment "Fysisk lokasjon hvor en ansatt har sitt arbeidssted." ;
    rdfs:subClassOf fint:felles/basisklasser/enhet ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/arbeidslokasjon/lokasjonskode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/arbeidslokasjon/lokasjonskode ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/arbeidslokasjon/lokasjonsnavn ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/arbeidslokasjon/lokasjonsnavn ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/arbeidslokasjon/arbeidsforhold ;
        owl:allValuesFrom fint:administrasjon/personal/arbeidsforhold
    ] .

fint:administrasjon/organisasjon/organisasjonselement rdf:type owl:Class ;
    rdfs:label "Organisasjonselement" ;
    rdfs:comment "Et element i organisasjonsstrukturen\n\n# Beskrivelse\n\nInnslagspunkt i organisasjonsstrukturen. Organisasjonselement er en avdeling/seksjon/enhet, som inneholder relasjon til leder. \n\nFlere organisasjonselement bygger hierarki med relasjon til orverordnet organisasjonselement, som former organisasjonsstrukturen.\n\n# Eksempler\n\n|     OrgKode     | OrgId |             Beskrivelse              | overordenetId |\n|-----------------|---------|--------------------------------------|-----------------|\n| F12             |      25 | OPPL Opplæringsavdelingen            |               0 |\n| F12.10          |      28 | OPPL Videregående opplæring          |              25 |\n| F12.10.44       |      39 | ASKI Askim vgs                       |              28 |\n| F12.10.44.50.15 |      52 | ASKI Internasjonalisering og eksamen |              39 |\n| F12.10.44.50.15 |      55 | ASKI FG Idrett                       |              52 |\n| F12.10.44.10    |      70 | ASKI Personal- og renholdsstab       |              39 |" ;
    rdfs:subClassOf fint:felles/basisklasser/enhet ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/gyldighetsperiode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/periode
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/gyldighetsperiode ;
        owl:onClass fint:felles/komplekse-datatyper/periode ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/kortnavn ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/kortnavn ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/navn ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/navn ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/organisasjonsid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/organisasjonsid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/organisasjonskode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/organisasjonskode ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/leder ;
        owl:allValuesFrom fint:administrasjon/personal/personalressurs
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/leder ;
        owl:onClass fint:administrasjon/personal/personalressurs ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/ansvar ;
        owl:allValuesFrom fint:administrasjon/kodeverk/ansvar
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/organisasjonstype ;
        owl:allValuesFrom fint:administrasjon/kodeverk/organisasjonstype
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/organisasjonstype ;
        owl:onClass fint:administrasjon/kodeverk/organisasjonstype ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/overordnet ;
        owl:allValuesFrom fint:administrasjon/organisasjon/organisasjonselement
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/overordnet ;
        owl:onClass fint:administrasjon/organisasjon/organisasjonselement ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/skole ;
        owl:allValuesFrom fint:utdanning/utdanningsprogram/skole
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/skole ;
        owl:onClass fint:utdanning/utdanningsprogram/skole ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/organisasjon/organisasjonselement/arbeidsforhold ;
        owl:allValuesFrom fint:administrasjon/personal/arbeidsforhold
    ] .

fint:administrasjon/personal/arbeidsforhold rdf:type owl:Class ;
    rdfs:label "Arbeidsforhold" ;
    rdfs:comment "Arbeidsforhold er et avtaleforhold mellom personalressurs og arbeidsgiver\n\n# Beskrivelse\n\nArbeidsforhold defineres som et avtaleforhold hvor den ene part (arbeidstakeren / personalressurs) forplikter seg til å utføre arbeid for den annen part (arbeidsgiveren / organisasjonselement). Arbeidsforholdet kan også utføres av en person fra vikarbyrå, eller et firma gjennom en kontrakt/avtale.\n\n# Eksempler\n\n* Ansatt som rådgiver i fast stilling\n* Vikariat for en annen person som er i permisjon fra sitt arbeidsforhold" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/arbeidsforhold/ansettelsesprosent ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/arbeidsforhold/ansettelsesprosent ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/arbeidsforhold/arbeidsforholdsperiode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/periode
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/arbeidsforhold/arbeidsforholdsperiode ;
        owl:onClass fint:felles/komplekse-datatyper/periode ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/arbeidsforhold/arslonn ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/arbeidsforhold/arslonn ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/arbeidsforhold/gyldighetsperiode ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/periode
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/arbeidsforhold/gyldighetsperiode ;
        owl:onClass fint:felles/komplekse-datatyper/periode ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/arbeidsforhold/hovedstilling ;
        owl:allValuesFrom xsd:boolean
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/arbeidsforhold/hovedstilling ;
        owl:onDataRange xsd:boolean ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/arbeidsforhold/lonnsprosent ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/arbeidsforhold/lonnsprosent ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/arbeidsforhold/stillingsnummer ;
        owl:allValuesFrom xsd:string
    ] ;
