fint:utdanning/vurdering/sluttfagvurdering rdf:type owl:Class ;
    rdfs:label "Sluttfagvurdering" ;
    rdfs:comment "Karakterer og andre vurderingsuttrykk.\n\n# Beskrivelse\n\nSluttvurdering (Standpunktkarakter) gis for deltakelse av en elev i en gruppe.\n\nVurderingen skal ha en relasjon til det angjeldende faget.\n\n# Referanser\n\n* UDir. Registreringshåndbok, Karakterer og andre vurderingsuttrykk: [regbok.udir.no/35004/3344/35042-1021153.html](http://regbok.udir.no/35004/3344/35042-1021153.html)\n* Føring av vitnemål og kompetansebevis for videregående opplæring i Kunnskapsløftet 2017. Karakterer og andre vurderingsuttrykk: [https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/](https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/)\n* Forskrift til opplæringslova &#167; 3-4: [https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4](https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4)" ;
    rdfs:subClassOf fint:utdanning/vurdering/fagvurdering ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/sluttfagvurdering/elevforhold ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/sluttfagvurdering/elevforhold ;
        owl:onClass fint:utdanning/elev/elevforhold ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/sluttfagvurdering/eksamensgruppe ;
        owl:allValuesFrom fint:utdanning/vurdering/eksamensgruppe
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/sluttfagvurdering/eksamensgruppe ;
        owl:onClass fint:utdanning/vurdering/eksamensgruppe ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/sluttfagvurdering/karakterhistorie ;
        owl:allValuesFrom fint:utdanning/vurdering/karakterhistorie
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/sluttfagvurdering/elevvurdering ;
        owl:allValuesFrom fint:utdanning/vurdering/elevvurdering
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/sluttfagvurdering/elevvurdering ;
        owl:onClass fint:utdanning/vurdering/elevvurdering ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/vurdering/sluttordensvurdering rdf:type owl:Class ;
    rdfs:label "Sluttordensvurdering" ;
    rdfs:comment "Sluttvurdering av orden og atferd..\n\n# Beskrivelse\n\nVurderinger av orden og atferd gjøres uten relasjon til noen gruppe, kun til et elevforhold.\n\n# Referanser\n\n* UDir. Registreringshåndbok, Karakterer og andre vurderingsuttrykk: [regbok.udir.no/35004/3344/35042-1021153.html](http://regbok.udir.no/35004/3344/35042-1021153.html)\n* Føring av vitnemål og kompetansebevis for videregående opplæring i Kunnskapsløftet 2017. Karakterer og andre vurderingsuttrykk: [https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/](https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/)\n* Forskrift til opplæringslova &#167; 3-4: [https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4](https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4)" ;
    rdfs:subClassOf fint:utdanning/vurdering/ordensvurdering ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/sluttordensvurdering/elevforhold ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/sluttordensvurdering/elevforhold ;
        owl:onClass fint:utdanning/elev/elevforhold ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/sluttordensvurdering/elevvurdering ;
        owl:allValuesFrom fint:utdanning/vurdering/elevvurdering
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/sluttordensvurdering/elevvurdering ;
        owl:onClass fint:utdanning/vurdering/elevvurdering ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/vurdering/underveisfagvurdering rdf:type owl:Class ;
    rdfs:label "Underveisfagvurdering" ;
    rdfs:comment "Karakterer og andre vurderingsuttrykk.\n\n# Beskrivelse\n\nUnderveisvurdering gis for deltakelse av en elev i en gruppe.\n\nVurdering i fag skal ha relasjon til den `Undervisningsgruppe` som vurderingen er foretatt i. Det er også mulig å sette relasjon direkte til angjeldende fag.\n\n# Referanser\n\n* UDir. Registreringshåndbok, Karakterer og andre vurderingsuttrykk: [regbok.udir.no/35004/3344/35042-1021153.html](http://regbok.udir.no/35004/3344/35042-1021153.html)\n* Føring av vitnemål og kompetansebevis for videregående opplæring i Kunnskapsløftet 2017. Karakterer og andre vurderingsuttrykk: [https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/](https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/)\n* Forskrift til opplæringslova &#167; 3-4: [https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4](https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4)" ;
    rdfs:subClassOf fint:utdanning/vurdering/fagvurdering ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/underveisfagvurdering/elevforhold ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/underveisfagvurdering/elevforhold ;
        owl:onClass fint:utdanning/elev/elevforhold ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/underveisfagvurdering/eaid-dstbf33fa-344f-40d9-8aee-464e828b31f5 ;
        owl:allValuesFrom fint:utdanning/timeplan/fag
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/underveisfagvurdering/elevvurdering ;
        owl:allValuesFrom fint:utdanning/vurdering/elevvurdering
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/underveisfagvurdering/elevvurdering ;
        owl:onClass fint:utdanning/vurdering/elevvurdering ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/vurdering/underveisordensvurdering rdf:type owl:Class ;
    rdfs:label "Underveisordensvurdering" ;
    rdfs:comment "Underveisvurdering av orden og atferd..\n\n# Beskrivelse\n\nVurderinger av orden og atferd gjøres uten relasjon til noen gruppe, kun til et elevforhold.\n\n# Referanser\n\n* UDir. Registreringshåndbok, Karakterer og andre vurderingsuttrykk: [regbok.udir.no/35004/3344/35042-1021153.html](http://regbok.udir.no/35004/3344/35042-1021153.html)\n* Føring av vitnemål og kompetansebevis for videregående opplæring i Kunnskapsløftet 2017. Karakterer og andre vurderingsuttrykk: [https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/](https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/)\n* Forskrift til opplæringslova &#167; 3-4: [https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4](https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4)" ;
    rdfs:subClassOf fint:utdanning/vurdering/ordensvurdering ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/underveisordensvurdering/elevforhold ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/underveisordensvurdering/elevforhold ;
        owl:onClass fint:utdanning/elev/elevforhold ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/underveisordensvurdering/elevvurdering ;
        owl:allValuesFrom fint:utdanning/vurdering/elevvurdering
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/underveisordensvurdering/elevvurdering ;
        owl:onClass fint:utdanning/vurdering/elevvurdering ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:utdanning/vurdering/vurdering rdf:type owl:Class ;
    rdfs:label "Vurdering" ;
    rdfs:comment "Karakterer og andre vurderingsuttrykk.\n\n# Beskrivelse\n\nVurdering gis for deltakelse av en elev i en gruppe. Dette kan være Halvårsvurdering, Standpunktkarakter, underveisvurdering eller annet. \n\nVurdering i fag skal ha relasjon til den `Undervisningsgruppe` eller `Eksamensgruppe` som vurderingen er foretatt i. Det er også mulig å sette relasjon direkte til angjeldende fag.\n\nVurderinger av orden og andre frittstående vurderinger gjøres uten relasjon til noen gruppe.\n\n# Referanser\n\n* UDir. Registreringshåndbok, Karakterer og andre vurderingsuttrykk: [regbok.udir.no/35004/3344/35042-1021153.html](http://regbok.udir.no/35004/3344/35042-1021153.html)\n* Føring av vitnemål og kompetansebevis for videregående opplæring i Kunnskapsløftet 2017. Karakterer og andre vurderingsuttrykk: [https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/](https://www.udir.no/eksamen-og-prover/dokumentasjon/vitnemal-og-kompetansebevis/foring-vitnemal-kompetansebevis-vgs/5-karakterer-og-andre-vurderingsuttrykk/)\n* Forskrift til opplæringslova &#167; 3-4: [https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4](https://lovdata.no/dokument/SF/forskrift/2006-06-23-724/KAPITTEL_4-1#&#167;3-4)" ;
    owl:deprecated "true"^^xsd:boolean ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/vurdering/endelig ;
        owl:allValuesFrom xsd:boolean
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/vurdering/endelig ;
        owl:onDataRange xsd:boolean ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/vurdering/kommentar ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/vurdering/kommentar ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/vurdering/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/vurdering/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/vurdering/eksamensgruppe ;
        owl:allValuesFrom fint:utdanning/vurdering/eksamensgruppe
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/vurdering/eksamensgruppe ;
        owl:onClass fint:utdanning/vurdering/eksamensgruppe ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/vurdering/fag ;
        owl:allValuesFrom fint:utdanning/timeplan/fag
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/vurdering/fag ;
        owl:onClass fint:utdanning/timeplan/fag ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/vurdering/elevforhold ;
        owl:allValuesFrom fint:utdanning/elev/elevforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/vurdering/elevforhold ;
        owl:onClass fint:utdanning/elev/elevforhold ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/vurdering/vurdering/undervisningsgruppe ;
