        owl:onClass fint:felles/person ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:administrasjon/personal/variabellonn rdf:type owl:Class ;
    rdfs:label "Variabellønn" ;
    rdfs:comment "Informasjon om variabel lønn.\n\n# Beskrivelse\n\nVariabel lønn består av ett eller flere tillegg, hver knyttet til en lønnsart.  Lønnsart bestemmer eventuelle faste satser for tillegget, samt grunnlag for skatt- og pensjonstrekk, og hvordan det rapporteres på A-meldingen.\n\nSelve beregningen av variabel lønn gjøres av HRM, og formålet er å overføre tilstrekkelig informasjon til at HRM kan foreta beregningen.\n\nMå brukes sammen med lønnsart for at HRM-systemet skal foreta korrekt beregning og rapportere riktig på A-meldingen.\n\n# Eksempler:\n\n1. Vikartime for undervisningspersonell: \n  - antall: antall timer * 1400 / årsramme\n2. Timelønn\n  - antall: antall timer\n3. Kjøregodtgjørelse\n  - antall: antall kilometer\n4. Kontantytelse for et møte\n  - antall: beløp\n\n# Lovlige endringer\n\n## Opprettelse av ny variabelllønn\n\n- `periode` angir periode hvor variabellønn skal utbetales.  \n- `opptjent` må benyttes dersom lønn ble opptjent i en annen utbetalingsperiode.\n\n## Endring av eksisterende variabellønn\n\n- Ikke tillatt.\n\n## Sletting av eksisterende variabellønn\n\n- Ikke tillatt." ;
    rdfs:subClassOf fint:administrasjon/personal/lonn ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/variabellonn/antall ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/variabellonn/antall ;
        owl:onDataRange xsd:string ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/variabellonn/belop ;
        owl:allValuesFrom xsd:string
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/variabellonn/belop ;
        owl:onDataRange xsd:string ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/variabellonn/lonnsart ;
        owl:allValuesFrom fint:administrasjon/kodeverk/lonnsart
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/variabellonn/lonnsart ;
        owl:onClass fint:administrasjon/kodeverk/lonnsart ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/variabellonn/arbeidsforhold ;
        owl:allValuesFrom fint:administrasjon/personal/arbeidsforhold
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:administrasjon/personal/variabellonn/arbeidsforhold ;
        owl:onClass fint:administrasjon/personal/arbeidsforhold ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

fint:arkiv/kodeverk/dokumentstatus rdf:type owl:Class ;
    rdfs:label "DokumentStatus" ;
    rdfs:comment "Kodeverk for status til et dokument.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M054\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:arkiv/kodeverk/dokumenttype rdf:type owl:Class ;
    rdfs:label "DokumentType" ;
    rdfs:comment "Kodeverk for type dokument.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M083\n\nI Noark ble begrepet Dokumentkategori endret til Dokumenttype i versjon 4.\nBegrepet Dokumentkategori brukes i Elements og P360.\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden#!#block-body-2" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:arkiv/kodeverk/format rdf:type owl:Class ;
    rdfs:label "Format" ;
    rdfs:comment "Dokumentets format.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M701\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden\n\n* https://arkivverket.metakat.no/Objekttype/Index/EAID_A17DA4C4_5952_4511_B44F_C8CA6A790558\n\n* https://lovdata.no/forskrift/2017-12-19-2286/§5-17 (Godkjente filformater for arkivdokumenter ved avlevering eller deponering).\n\n# Eksempler\n\n* RA-TEKST\n* RA-TIFF6\n* RA-PDF\n* RA-XML\n* RA-JPEG\n* RA-SOSI" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:arkiv/kodeverk/journalposttype rdf:type owl:Class ;
    rdfs:label "JournalpostType" ;
    rdfs:comment "Navn på type journalpost.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M082\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:arkiv/kodeverk/journalstatus rdf:type owl:Class ;
    rdfs:label "JournalStatus" ;
    rdfs:comment "Status til journalposten, dvs. om dokumentet er registrert, under behandling eller endelig arkivert.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M053\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:arkiv/kodeverk/klassifikasjonstype rdf:type owl:Class ;
    rdfs:label "Klassifikasjonstype" ;
    rdfs:comment "Kodeverk for type klassifikasjonssystem.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M086\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:subClassOf fint:felles/basisklasser/begrep .

fint:arkiv/kodeverk/korrespondanseparttype rdf:type owl:Class ;
    rdfs:label "KorrespondansepartType" ;
    rdfs:comment "Kodeverk over korrespondansepart typer.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M087\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
