fint:utdanning/elev/elevtilrettelegging rdf:type owl:Class ;
    rdfs:label "Elevtilrettelegging" ;
    rdfs:comment "Tilrettelegging en elev har på eksamen.\n\nDet skal her oppgis enten fag eller eksamensform.\n\n# Referanse\n\n[Registrere tilretteleggingstype for eksamen](https://inschool.zendesk.com/hc/no/articles/360031198011-5a-02-Registrere-tilretteleggingstype-for-eksamen)" ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevtilrettelegging/systemid ;
        owl:allValuesFrom fint:felles/komplekse-datatyper/identifikator
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty fint:utdanning/elev/elevtilrettelegging/systemid ;
        owl:onClass fint:felles/komplekse-datatyper/identifikator ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:subClassOf [ a owl:Restriction ;
