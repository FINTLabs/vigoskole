    rdfs:label "merknadstekst" ;
    rdfs:comment "Merknad fra saksbehandler, leder eller arkivpersonale\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M310\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/merknad ;
    rdfs:range xsd:string .

fint:arkiv/noark/merknad/merknadstype rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "merknadstype" ;
    rdfs:comment "Type merknad.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M084\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/merknad ;
    rdfs:range fint:arkiv/kodeverk/merknadstype .

fint:arkiv/noark/part/adresse rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "adresse" ;
    rdfs:comment "Adressen til saksparten.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M406, M407, M408 og M409\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/part ;
    rdfs:range fint:felles/komplekse-datatyper/adresse .

fint:arkiv/noark/part/fodselsnummer rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "fødselsnummer" ;
    rdfs:comment "Fødselsnummer til part. Kun gyldig hvis Part er en Privatperson." ;
    rdfs:domain fint:arkiv/noark/part ;
    rdfs:range xsd:string .

fint:arkiv/noark/part/kontaktinformasjon rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "kontaktinformasjon" ;
    rdfs:comment "Kontaktinformasjonen til saksparten.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M410 og M411\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/part ;
    rdfs:range fint:felles/komplekse-datatyper/kontaktinformasjon .

fint:arkiv/noark/part/kontaktperson rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "kontaktperson" ;
    rdfs:comment "Kontaktperson hos en organisasjon som er avsender eller mottaker, eller sakspart.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M412\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/part ;
    rdfs:range xsd:string .

fint:arkiv/noark/part/organisasjonsnummer rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "organisasjonsnummer" ;
    rdfs:comment "Organisasjonsnummer til Part. Kun gyldig hvis Part er en organisasjon." ;
    rdfs:domain fint:arkiv/noark/part ;
    rdfs:range xsd:string .

fint:arkiv/noark/part/partnavn rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "partNavn" ;
    rdfs:comment "Navn på virksomhet eller person som er part.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M302\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/part ;
    rdfs:range xsd:string .

fint:arkiv/noark/part/partrolle rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "partRolle" ;
    rdfs:comment "Angivelse av rollen til parten.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M303\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/part ;
    rdfs:range fint:arkiv/kodeverk/partrolle .

fint:arkiv/noark/registrering/administrativenhet rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "administrativEnhet" ;
    rdfs:comment "Navn på avdeling, kontor eller annen administrativ enhet som har ansvaret for saksbehandlingen.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M305\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range fint:arkiv/noark/administrativenhet .

fint:arkiv/noark/registrering/arkivdel rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "arkivdel" ;
    rdfs:comment "Arkivdel som registrering tilhører." ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range fint:arkiv/noark/arkivdel ;
    owl:inverseOf fint:arkiv/noark/arkivdel/registrering .

fint:arkiv/noark/registrering/arkivertav rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "arkivertAv" ;
    rdfs:comment "Navn på person som opprettet/registrerte arkivenheten.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M601\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range fint:arkiv/noark/arkivressurs .

fint:arkiv/noark/registrering/arkivertdato rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "arkivertDato" ;
    rdfs:comment "Dato og klokkeslett når alle dokumentene som er tilknyttet registreringen ble arkivert\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M604\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990 klokken 13:30 (UTC +1)` -&gt; `1990-03-29T12:30:00Z`\n\n* `29. juni 1990 klokken 13:30 (UTC +2 sommertid)` -&gt; `1990-06-29T11:30:00Z`" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range xsd:dateTime .

fint:arkiv/noark/registrering/beskrivelse rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "beskrivelse" ;
    rdfs:comment "Tekstlig beskrivelse av arkivenheten\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M201\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range xsd:string .

fint:arkiv/noark/registrering/dokumentbeskrivelse rdf:type owl:ObjectProperty ;
    rdfs:label "dokumentbeskrivelse" ;
    rdfs:comment "Dokumentbeskrivelsene til en registrering.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 2.7\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range fint:arkiv/noark/dokumentbeskrivelse .

fint:arkiv/noark/registrering/forfatter rdf:type owl:DatatypeProperty ;
    rdfs:label "forfatter" ;
    rdfs:comment "Navn på person (eller eventuelt organisasjon) som har forfattet eller skapt dokumentet.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M024\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range xsd:string .

fint:arkiv/noark/registrering/klasse rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "klasse" ;
    rdfs:comment "Klassifisering av registrering.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 2.4\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range fint:arkiv/noark/klasse .

fint:arkiv/noark/registrering/korrespondansepart rdf:type owl:ObjectProperty ;
    rdfs:label "korrespondansepart" ;
    rdfs:comment "Mottaker eller sender av arkivdokumenter.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 2.6\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range fint:arkiv/noark/korrespondansepart .

fint:arkiv/noark/registrering/merknad rdf:type owl:ObjectProperty ;
    rdfs:label "merknad" ;
    rdfs:comment "Merknader til registrering.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard- kap. 2.8.4\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range fint:arkiv/noark/merknad .

fint:arkiv/noark/registrering/nokkelord rdf:type owl:DatatypeProperty ;
    rdfs:label "nokkelord" ;
    rdfs:comment "Nøkkeord eller stikkord som beskriver innholdet i enheten.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M022\n* Noark 5 versjon 5.0 standard - kap. 2.8.2\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range xsd:string .

fint:arkiv/noark/registrering/offentligtittel rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "offentligTittel" ;
    rdfs:comment "Offentlig tittel på arkivenheten, ord som skal skjermes er fjernet fra innholdet i tittelen (erstattet med ******)\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M025\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range xsd:string .

fint:arkiv/noark/registrering/opprettetav rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "opprettetAv" ;
    rdfs:comment "Navn på person som opprettet/registrerte arkivenheten.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M601\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range fint:arkiv/noark/arkivressurs .

fint:arkiv/noark/registrering/opprettetdato rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "opprettetDato" ;
    rdfs:comment "Dato og klokkeslett når arkivenheten ble opprettet/registrert.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M600\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990 klokken 13:30 (UTC +1)` -&gt; `1990-03-29T12:30:00Z`\n\n* `29. juni 1990 klokken 13:30 (UTC +2 sommertid)` -&gt; `1990-06-29T11:30:00Z`" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range xsd:dateTime .

fint:arkiv/noark/registrering/part rdf:type owl:ObjectProperty ;
    rdfs:label "part" ;
    rdfs:comment "Parter til registrering.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 2.8.5\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range fint:arkiv/noark/part .

fint:arkiv/noark/registrering/referansearkivdel rdf:type owl:DatatypeProperty ;
    rdfs:label "referanseArkivDel" ;
    rdfs:comment "Referanse til arkivdelen som denne arkivenheten er tilknyttet\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M208\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range xsd:string .

fint:arkiv/noark/registrering/registreringsid rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "registreringsId" ;
    rdfs:comment "Inngår i M004 journalpostID. Viser rekkefølgen journalpostene ble opprettet innenfor saksmappen, f.eks. 2011/3869-8 (dokument nr. 8 i sak 2011/3869).\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M004\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range xsd:string .

fint:arkiv/noark/registrering/saksbehandler rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "saksbehandler" ;
    rdfs:comment "Navn på person som er saksbehandler.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M307\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range fint:arkiv/noark/arkivressurs .

fint:arkiv/noark/registrering/skjerming rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "skjerming" ;
    rdfs:comment "Skjerming av registrering.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 2.8.1\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range fint:arkiv/noark/skjerming .

fint:arkiv/noark/registrering/tilgangsgruppe rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "tilgangsgruppe" ;
    rdfs:comment "Angir hvilken tilgangsgruppe som har tilgang til Registreringen" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range fint:arkiv/kodeverk/tilgangsgruppe .

fint:arkiv/noark/registrering/tittel rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "tittel" ;
    rdfs:comment "Tittel eller navn på arkivenheten.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M020\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/registrering ;
    rdfs:range xsd:string .

fint:arkiv/noark/saksmappe/administrativenhet rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "administrativEnhet" ;
    rdfs:comment "Navn på avdeling, kontor eller annen administrativ enhet som har ansvaret for saksbehandlingen.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M305\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/saksmappe ;
    rdfs:range fint:arkiv/noark/administrativenhet .

fint:arkiv/noark/saksmappe/arkivnotat rdf:type owl:ObjectProperty ;
    rdfs:label "arkivnotat" ;
    rdfs:comment "Arkivnotater knyttet til saksmappe.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 2.6\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/saksmappe ;
    rdfs:range fint:arkiv/noark/registrering .

fint:arkiv/noark/saksmappe/journalenhet rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "journalenhet" ;
    rdfs:comment "Navn på enhet som har det arkivmessige ansvaret for kvalitetssikring av arkivdanningen, og eventuelt registrering (journalføring) og arkivering av fysiske dokumenter.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M308\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/saksmappe ;
    rdfs:range fint:arkiv/noark/administrativenhet .

fint:arkiv/noark/saksmappe/journalpost rdf:type owl:ObjectProperty ;
    rdfs:label "journalpost" ;
    rdfs:comment "Journalposter knyttet til saksmappe.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 2.6\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/saksmappe ;
    rdfs:range fint:arkiv/noark/journalpost .

fint:arkiv/noark/saksmappe/saksaar rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "saksaar" ;
    rdfs:comment "Inngår i M003 mappeID. Viser året saksmappen ble opprettet.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M011\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/saksmappe ;
    rdfs:range xsd:string .

fint:arkiv/noark/saksmappe/saksansvarlig rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "saksansvarlig" ;
    rdfs:comment "Navn på person som er saksansvarlig.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M306\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/saksmappe ;
    rdfs:range fint:arkiv/noark/arkivressurs .

fint:arkiv/noark/saksmappe/saksdato rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "saksdato" ;
    rdfs:comment "Datoen saken er opprettet\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M100\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\nTimedelen er egentlig unødvendig der bare dato har verdi. Det anbefales at en da setter den til klokken 12 på dagen (zulu). Derved kan dato leses direkte uten å gjøre om til lokaltid ( i Norge).\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990` -&gt; `1990-03-29T12:00:00Z`\n\n* `29. juni 1990` -&gt; `1990-06-29T12:00:00Z`" ;
    rdfs:domain fint:arkiv/noark/saksmappe ;
    rdfs:range xsd:dateTime .

fint:arkiv/noark/saksmappe/saksmappetype rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "saksmappetype" ;
    rdfs:comment "Type saksmappe." ;
    rdfs:domain fint:arkiv/noark/saksmappe ;
    rdfs:range fint:arkiv/kodeverk/saksmappetype .

fint:arkiv/noark/saksmappe/sakssekvensnummer rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "sakssekvensnummer" ;
    rdfs:comment "Inngår i M003 mappeID. Viser rekkefølgen når saksmappen ble opprettet innenfor året.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M012\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/saksmappe ;
    rdfs:range xsd:string .

fint:arkiv/noark/saksmappe/saksstatus rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "saksstatus" ;
    rdfs:comment "Registreres automatisk gjennom forskjellig saksbehandlings- funksjonalitet, eller overstyres manuelt.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M052\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/saksmappe ;
    rdfs:range fint:arkiv/kodeverk/saksstatus .

fint:arkiv/noark/saksmappe/tilgangsgruppe rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "tilgangsgruppe" ;
    rdfs:comment "Angir hvilken tilgangsgruppe som har tilgang til saksmappen." ;
    rdfs:domain fint:arkiv/noark/saksmappe ;
    rdfs:range fint:arkiv/kodeverk/tilgangsgruppe .

fint:arkiv/noark/saksmappe/utlaantdato rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "utlaantDato" ;
    rdfs:comment "Dato når en fysisk saksmappe eller journalpost ble utlånt\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M106\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\nTimedelen er egentlig unødvendig der bare dato har verdi. Det anbefales at en da setter den til klokken 12 på dagen (zulu). Derved kan dato leses direkte uten å gjøre om til lokaltid ( i Norge).\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n29. mars 1990 -&gt; `1990-03-29T12:00:00Z`\n\n29. juni 1990 -&gt; `1990-06-29T12:00:00Z`" ;
    rdfs:domain fint:arkiv/noark/saksmappe ;
    rdfs:range xsd:dateTime .

fint:arkiv/noark/skjerming/skjermingshjemmel rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "skjermingshjemmel" ;
    rdfs:comment "Skjermingshjemmel. \n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M501\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/skjerming ;
    rdfs:range fint:arkiv/kodeverk/skjermingshjemmel .

fint:arkiv/noark/skjerming/tilgangsrestriksjon rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "tilgangsrestriksjon" ;
    rdfs:comment "Tilgangsrestriksjon.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M500\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/skjerming ;
    rdfs:range fint:arkiv/kodeverk/tilgangsrestriksjon .

