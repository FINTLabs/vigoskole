fint:arkiv/noark/avskrivning/avskrevetav rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "avskrevetAv" ;
    rdfs:comment "Avskrevet av\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog, M618\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/avskrivning ;
    rdfs:range xsd:string .

fint:arkiv/noark/avskrivning/avskrivningsdato rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "avskrivningsdato" ;
    rdfs:comment "Dato og klokkelsett for avskrivning\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog, M617\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990 klokken 13:30 (UTC +1)` -&gt; `1990-03-29T12:30:00Z`\n\n* `29. juni 1990 klokken 13:30 (UTC +2 sommertid)` -&gt; `1990-06-29T11:30:00Z`" ;
    rdfs:domain fint:arkiv/noark/avskrivning ;
    rdfs:range xsd:dateTime .

fint:arkiv/noark/avskrivning/avskrivningsmate rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "avskrivningsmate" ;
    rdfs:comment "Hvordan journalposten avskrives\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog, M619\n\n# Eksempel\n\n| Verdi (avskrivningsmåte) | Beskrivelse |\n| ------- | ---------------- |\n| BU | Besvart med brev |\n| BE | Besvart med e-post |\n| TLF | Besvart på telefon |\n| TE | Tatt til etterretning |\n| TO | Tatt til orientering |\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/avskrivning ;
    rdfs:range xsd:string .

fint:arkiv/noark/dokumentbeskrivelse/beskrivelse rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "beskrivelse" ;
    rdfs:comment "Tekstlig beskrivelse av arkivenheten.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M021\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/dokumentbeskrivelse ;
    rdfs:range xsd:string .

fint:arkiv/noark/dokumentbeskrivelse/dokumentnummer rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "dokumentnummer" ;
    rdfs:comment "Identifikasjon av dokumentene innenfor en registrering.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M007\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/dokumentbeskrivelse ;
    rdfs:range xsd:long .

fint:arkiv/noark/dokumentbeskrivelse/dokumentobjekt rdf:type owl:ObjectProperty ;
    rdfs:label "dokumentobjekt" ;
    rdfs:comment "Dokumentobjekt tilhørende dokumentbeskrivelsen.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 2.7\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/dokumentbeskrivelse ;
    rdfs:range fint:arkiv/noark/dokumentobjekt .

fint:arkiv/noark/dokumentbeskrivelse/dokumentstatus rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "dokumentstatus" ;
    rdfs:comment "Status til dokumentet.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M054\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/dokumentbeskrivelse ;
    rdfs:range fint:arkiv/kodeverk/dokumentstatus .

fint:arkiv/noark/dokumentbeskrivelse/dokumenttype rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "dokumentType" ;
    rdfs:comment "Navn på type dokument.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M083\n\nI Noark ble begrepet Dokumentkategori endret til Dokumenttype i versjon 4.\nBegrepet Dokumentkategori brukes i Elements og P360.\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden#!#block-body-2" ;
    rdfs:domain fint:arkiv/noark/dokumentbeskrivelse ;
    rdfs:range fint:arkiv/kodeverk/dokumenttype .

fint:arkiv/noark/dokumentbeskrivelse/forfatter rdf:type owl:DatatypeProperty ;
    rdfs:label "forfatter" ;
    rdfs:comment "Navn på person (eller eventuelt organisasjon) som har forfattet eller skapt dokumentet.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M024\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/dokumentbeskrivelse ;
    rdfs:range xsd:string .

fint:arkiv/noark/dokumentbeskrivelse/opprettetav rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "opprettetAv" ;
    rdfs:comment "Navn på person som opprettet/registrerte arkivenheten.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M601\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/dokumentbeskrivelse ;
    rdfs:range fint:arkiv/noark/arkivressurs .

fint:arkiv/noark/dokumentbeskrivelse/opprettetdato rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:label "opprettetDato" ;
    rdfs:comment "Dato og klokkeslett når arkivenheten ble opprettet/registrert.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 metadatakatalog - nr. M600\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden\n\n# Format\n\nISO 8601 format `YYYY-MM-DDThh:mm:ssZ`\n\n## Referanser\n\n* ISO 8601 : https://en.wikipedia.org/wiki/ISO_8601\n\n## Eksempler\n\n* `29. mars 1990 klokken 13:30 (UTC +1)` -&gt; `1990-03-29T12:30:00Z`\n\n* `29. juni 1990 klokken 13:30 (UTC +2 sommertid)` -&gt; `1990-06-29T11:30:00Z`" ;
    rdfs:domain fint:arkiv/noark/dokumentbeskrivelse ;
    rdfs:range xsd:dateTime .

fint:arkiv/noark/dokumentbeskrivelse/part rdf:type owl:ObjectProperty ;
    rdfs:label "part" ;
    rdfs:comment "Parter til dokument.\n\n# Beskrivelse\n\n* Noark 5 versjon 5.0 standard - kap. 2.8.5\n\n# Referanser\n\n* https://www.arkivverket.no/forvaltning-og-utvikling/noark-standarden/noark-5/noark5-standarden" ;
    rdfs:domain fint:arkiv/noark/dokumentbeskrivelse ;
    rdfs:range fint:arkiv/noark/part .

